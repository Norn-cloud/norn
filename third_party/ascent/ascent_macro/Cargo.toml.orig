[package]
name = "ascent_macro"
version.workspace = true
edition = "2021"
authors = ["Arash Sahebolamri"]
repository = "https://github.com/s-arash/ascent"
license = "MIT"
description = "implementation of ascent macros"

[lib]
proc-macro = true

[dependencies]
syn = { workspace = true, features = ["derive", "full", "extra-traits", "visit-mut"] } 
quote = { workspace = true }
ascent_base = { workspace = true }
proc-macro2 = "1.0"
itertools = { workspace = true }
petgraph = "0.8"
derive-syn-parse = { workspace = true }
duplicate = { version = "2.0", default-features = false }

[dev-dependencies]
ascent = { path = "../ascent" }
rayon = "1.5"
crossbeam = "0.8"
