  "clippy_toml": {
    "allow-dbg-in-tests": true,
    "allow-expect-in-tests": true,
    "allow-indexing-slicing-in-tests": true,
    "allow-panic-in-tests": true,
    "allow-print-in-tests": true,
    "allow-unwrap-in-tests": true,
    "disallowed-methods": [
      {
        "path": "std::process::exit",
        "reason": "abrupt exit skips destructors and the execution ledger; return an error up to main instead"
      },
      {
        "path": "std::mem::forget",
        "reason": "leaking values hides resource bugs; use ManuallyDrop with justification if truly needed"
      },
      {
        "path": "std::env::set_var",
        "reason": "mutating process env is racy and non-deterministic; thread config through explicit context"
      },
      {
        "path": "std::process::Command::new",
        "reason": "spawning processes is a capability; use a capability wrapper once norn-caps lands"
      },
      {
        "path": "std::time::SystemTime::now",
        "reason": "ambient wall-clock reads break replay/determinism; inject a Clock capability"
      },
      {
        "path": "jiff::Timestamp::now",
        "reason": "ambient wall-clock reads break replay/determinism; inject a Clock capability"
      },
      {
        "path": "jiff::Zoned::now",
        "reason": "ambient wall-clock and host tz reads break replay/determinism; inject a Clock capability"
      },
      {
        "path": "jiff::tz::TimeZone::system",
        "reason": "the host time zone breaks replay/determinism; resolve zones from the pinned jiff-tzdb"
      },
      {
        "path": "jiff::tz::TimeZone::try_system",
        "reason": "the host time zone breaks replay/determinism; resolve zones from the pinned jiff-tzdb"
      },
      {
        "path": "jiff::tz::db",
        "reason": "the global tz database can read host zoneinfo, breaking replay/determinism; resolve zones from the pinned jiff-tzdb"
      }
    ],
    "disallowed-types": [
      {
        "path": "std::collections::HashMap",
        "reason": "core iteration must be deterministic; use BTreeMap or IndexMap"
      },
      {
        "path": "std::collections::HashSet",
        "reason": "core iteration must be deterministic; use BTreeSet or IndexSet"
      }
    ]
  },
