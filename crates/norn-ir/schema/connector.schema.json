      "properties": {
        "components": {
          "description": "Allowed major versions for each reported application.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConnectorVersionComponent"
          }
        },
        "endpoint": {
          "description": "Relative endpoint used to read source versions.",
          "type": "string"
        },
        "requireMatchingMajors": {
          "description": "Require all components to report the same major version.",
          "type": "boolean"
        },
        "responsePath": {
          "description": "JSON Pointer to the response object containing app versions.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoint",
        "responsePath",
        "components",
        "requireMatchingMajors"
      ]
    },
    "ConnectorVersionComponent": {
      "description": "One source application and its accepted major versions.",
      "type": "object",
      "properties": {
        "app": {
          "description": "Source application's reported name (for example `frappe`).",
