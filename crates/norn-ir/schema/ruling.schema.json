{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RulingPayload",
  "description": "The payload of a `ruling` artifact ([`ruling::RulingIr`], norn#62).",
  "type": "object",
  "properties": {
    "affects": {
      "description": "The definitions it governs (non-empty), at the versions it ruled on.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemberRef"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RulingAlternative"
      }
    },
    "decidedAt": {
      "description": "`YYYY-MM-DD`.",
      "type": "string"
    },
    "decidedBy": {
      "$ref": "#/$defs/Decider"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "id": {
      "description": "Stable identity, unique in a set.",
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/RulingOutcome"
    },
    "resolves": {
      "description": "The `claim` artifacts it decides (non-empty, exact versions).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactKey"
      }
    },
    "rulingVersion": {
      "$ref": "#/$defs/IrVersion01"
    },
    "supersedes": {
      "description": "The ruling this one supersedes.",
      "$ref": "#/$defs/ArtifactKey"
    }
  },
  "additionalProperties": false,
  "required": [
    "rulingVersion",
    "id",
    "resolves",
    "outcome",
    "affects",
    "decidedBy",
    "decidedAt"
  ],
  "$defs": {
    "ArtifactKey": {
      "description": "Exact identity of an artifact: one version of one id.",
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifactId",
        "version"
      ]
    },
    "Decider": {
      "description": "Who decided a ruling.",
      "type": "object",
      "properties": {
        "authority": {
          "$ref": "#/$defs/DecisionAuthority"
        },
        "principal": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "principal",
        "authority"
      ]
    },
    "DecisionAuthority": {
      "description": "The authority level of a decider.",
      "type": "string",
      "enum": [
        "owner",
        "lead",
        "agent"
      ]
    },
    "Evidence": {
      "description": "One piece of evidence and its strength.",
      "type": "object",
      "properties": {
        "note": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "strength": {
          "$ref": "#/$defs/EvidenceStrength"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "strength"
      ]
    },
    "EvidenceSource": {
      "description": "Where a piece of evidence lives, pinned exactly.",
      "oneOf": [
        {
          "description": "A Norn artifact by its Norn1 semantic hash (a definition, a proof\nreceipt, a test fixture).",
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "artifact"
            },
            "sha256": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "artifactId",
            "version",
            "sha256"
          ]
        },
        {
          "description": "A file of an upstream system at an immutable release.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "upstream"
            },
            "locator": {
              "description": "A path (and optional `#anchor`) within that release.",
              "type": "string"
            },
            "release": {
              "description": "An immutable release, tag, or revision hash.",
              "type": "string"
            },
            "system": {
              "description": "The system (`erpnext`, `shopify`).",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "system",
            "release",
            "locator"
          ]
        }
      ]
    },
    "EvidenceStrength": {
      "description": "How strong one piece of evidence is: the AGENTS.md evidence labels.",
      "type": "string",
      "enum": [
        "structural",
        "exhaustive_finite",
        "bounded",
        "checked_proof",
        "runtime_enforced",
        "sampled",
        "refuted",
        "unknown"
      ]
    },
    "IrVersion01": {
      "description": "The only IR `0.1` version literal of the connector, widget, customization,\npolicy, derived, and setting roots and of ontology business packs.",
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "Member": {
      "description": "A member of a definition. Names are the IR's own: an object type or\ninterface name, a property, link, lifecycle-property, or transition id,\nan object-map id, a law id.",
      "oneOf": [
        {
          "description": "The artifact as a whole (an action, a decision, a mapping).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "artifact"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "An object type or interface.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "type"
            },
            "typeName": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "typeName"
          ]
        },
        {
          "description": "A property of a type.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "property"
            },
            "property": {
              "type": "string"
            },
            "typeName": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "typeName",
            "property"
          ]
        },
        {
          "description": "A link of a type.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "link"
            },
            "link": {
              "type": "string"
            },
            "typeName": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "typeName",
            "link"
          ]
        },
        {
          "description": "A state of a type's lifecycle (a value of its lifecycle property).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "state"
            },
            "lifecycle": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "typeName": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "typeName",
            "lifecycle",
            "state"
          ]
        },
        {
          "description": "A declared transition of a type's lifecycle.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "transition"
            },
            "lifecycle": {
              "type": "string"
            },
            "transition": {
              "type": "string"
            },
            "typeName": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "typeName",
            "lifecycle",
            "transition"
          ]
        },
        {
          "description": "An object map of a mapping.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object_map"
            },
            "map": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "map"
          ]
        },
        {
          "description": "A law.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "law"
            },
            "law": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "law"
          ]
        }
      ]
    },
    "MemberRef": {
      "description": "A member of one exact artifact.",
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "member": {
          "$ref": "#/$defs/Member"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifactId",
        "version",
        "member"
      ]
    },
    "ParameterAuthority": {
      "description": "Who may set a parameter a ruling introduces.",
      "type": "string",
      "enum": [
        "tenant",
        "jurisdiction",
        "normative_profile"
      ]
    },
    "RevisitTrigger": {
      "description": "When a deferred ruling is revisited.",
      "oneOf": [
        {
          "description": "On a date (`YYYY-MM-DD`).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "date"
            },
            "on": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        },
        {
          "description": "When this evidence changes.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "evidence"
            },
            "source": {
              "$ref": "#/$defs/EvidenceSource"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source"
          ]
        }
      ]
    },
    "RulingAlternative": {
      "description": "An option considered and not chosen.",
      "type": "object",
      "properties": {
        "note": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/RulingOutcome"
        }
      },
      "additionalProperties": false,
      "required": [
        "outcome"
      ]
    },
    "RulingOutcome": {
      "description": "The structured outcome of a ruling.",
      "oneOf": [
        {
          "description": "One definition is chosen.",
          "type": "object",
          "properties": {
            "definition": {
              "$ref": "#/$defs/MemberRef"
            },
            "kind": {
              "type": "string",
              "const": "choose"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "definition"
          ]
        },
        {
          "description": "A parameter decides; its default and who may set it.",
          "type": "object",
          "properties": {
            "default": {
              "$ref": "#/$defs/JsonValue"
            },
            "kind": {
              "type": "string",
              "const": "parameterise"
            },
            "parameter": {
              "description": "The `setting` artifact holding the parameter.",
              "$ref": "#/$defs/MemberRef"
            },
            "setBy": {
              "description": "Non-empty.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ParameterAuthority"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "parameter",
            "default",
            "setBy"
          ]
        },
        {
          "description": "Different definitions in disjoint scopes (two or more cases).",
          "type": "object",
          "properties": {
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScopedCase"
              }
            },
            "kind": {
              "type": "string",
              "const": "scoped"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "cases"
          ]
        },
        {
          "description": "Not decided yet.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "defer"
            },
            "revisit": {
              "$ref": "#/$defs/RevisitTrigger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "revisit"
          ]
        },
        {
          "description": "The claim is rejected.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "reject"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ScopeRef": {
      "type": "object",
      "properties": {
        "businessUnitId": {
          "type": [
            "string",
            "null"
          ]
        },
        "environmentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "orgId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tenantId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ScopedCase": {
      "description": "One case of a scoped outcome.",
      "type": "object",
      "properties": {
        "definition": {
          "$ref": "#/$defs/MemberRef"
        },
        "scope": {
          "$ref": "#/$defs/ScopeRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "definition"
      ]
    }
  }
}
