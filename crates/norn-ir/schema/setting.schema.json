{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SettingPayload",
  "description": "The payload of a `setting` artifact: one reviewed, effective-dated\nvalue paired with `valueType`. Version 0.2 number settings require exact\ndecimal-string literals; verified retained 0.1 keeps its binary64 JSON\nnumber profile.",
  "type": "object",
  "properties": {
    "effectiveFrom": {
      "type": "string"
    },
    "effectiveTo": {
      "description": "Must sort after `effectiveFrom` (checker rule).",
      "type": "string"
    },
    "extensions": {
      "description": "Reserved extension slots keyed by `<name>/<semver>`; `null` is rejected.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "review": {
      "$ref": "#/$defs/SettingReview"
    },
    "scopeRequired": {
      "description": "Scope dimensions the caller must supply (fail closed).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settingKey": {
      "type": "string"
    },
    "settingVersion": {
      "$ref": "#/$defs/IrVersion02"
    },
    "supersedes": {
      "description": "The setting version this one replaces.",
      "$ref": "#/$defs/SettingSupersedes"
    },
    "value": {
      "description": "Version 0.2 numbers require exact decimal-string literals; retained 0.1 numbers\nkeep binary64 JSON numbers. A `json` setting may be `null`.",
      "$ref": "#/$defs/JsonValue"
    },
    "valueType": {
      "$ref": "#/$defs/SettingValueType"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "value": {
          "type": "string"
        },
        "valueType": {
          "const": "text"
        }
      }
    },
    {
      "properties": {
        "settingVersion": {
          "const": "0.2"
        },
        "value": {
          "$ref": "#/$defs/DecimalLiteral"
        },
        "valueType": {
          "const": "number"
        }
      }
    },
    {
      "properties": {
        "settingVersion": {
          "const": "0.1"
        },
        "value": {
          "type": "number"
        },
        "valueType": {
          "const": "number"
        }
      }
    },
    {
      "properties": {
        "value": {
          "type": "boolean"
        },
        "valueType": {
          "const": "boolean"
        }
      }
    },
    {
      "properties": {
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "valueType": {
          "const": "json"
        }
      }
    }
  ],
  "required": [
    "settingVersion",
    "settingKey",
    "valueType",
    "value",
    "effectiveFrom",
    "review",
    "scopeRequired"
  ],
  "$defs": {
    "DecimalLiteral": {
      "description": "An exact decimal number written as a JSON string: an optional `-`, an\ninteger part without leading zeros, and an optional fraction\n(`\"0\"`, `\"-12\"`, `\"19.990\"`). No exponent, no `+`.\n\nTrailing fraction zeros are kept: they carry the literal's scale.",
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "IrVersion02": {
      "description": "Setting value profiles: historical binary64 and current exact decimal literals.",
      "type": "string",
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "SettingReview": {
      "description": "Review state of a setting.",
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string"
        },
        "reviewedBy": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SettingReviewState"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "required": [
        "state"
      ]
    },
    "SettingReviewState": {
      "description": "Review states of a setting.",
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "approved",
        "active",
        "rejected",
        "superseded"
      ]
    },
    "SettingSupersedes": {
      "description": "The exact setting artifact version a setting supersedes.",
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "required": [
        "artifactId",
        "version"
      ]
    },
    "SettingValueType": {
      "description": "The setting value kind; numbers use exact decimal-string literals.",
      "type": "string",
      "enum": [
        "text",
        "number",
        "boolean",
        "json"
      ]
    }
  }
}
