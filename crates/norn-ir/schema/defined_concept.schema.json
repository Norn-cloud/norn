{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DefinedConceptPayload",
  "description": "Pack-owned classification; never a writable object store.",
  "type": "object",
  "properties": {
    "base": {
      "description": "Exact type member in an entity artifact required by this artifact.",
      "$ref": "#/$defs/MemberRef"
    },
    "bounds": {
      "description": "Existing resource vocabulary and units, capped by the admitted profile.",
      "$ref": "#/$defs/ResourceLimitProfile"
    },
    "dependencies": {
      "description": "Exact member dependencies, including other classifications.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemberRef"
      }
    },
    "extensions": {
      "description": "Reserved versioned extension slots, as on other artifact roots.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "id": {
      "description": "Qualified classification identity, distinct from the base object kind.",
      "type": "string"
    },
    "predicate": {
      "description": "A pure Boolean expression over the authorized base snapshot.",
      "$ref": "#/$defs/ZenExpression"
    },
    "version": {
      "description": "Definition version; must match its artifact envelope.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "base",
    "predicate",
    "dependencies",
    "bounds"
  ],
  "$defs": {
    "DecideBudget": {
      "description": "Budget for one warm `decide` (§1 row 1).",
      "type": "object",
      "properties": {
        "cpu_p99_micros": {
          "description": "Target p99 CPU per decision, in microseconds (qualification target;\nnot enforceable by a clock inside the kernel).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "fuel_envelope_micros": {
          "description": "The CPU envelope the fuel budget is calibrated against, in\nmicroseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "fuel_units": {
          "description": "Deterministic fuel per decision, in Norn ZEN metering units.\nProvisional and uncalibrated until `T3-BUDGET-1`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "cpu_p99_micros",
        "fuel_envelope_micros",
        "fuel_units"
      ]
    },
    "EnvelopeLimits": {
      "description": "Per-decision envelope caps (§1 row 5).\n\nCounts are `u32` and sizes `u64` so the serialized profile is identical on\nnative and `wasm32` hosts. `norn-kernel`'s `step` enforces the counts; the\nhost checks `max_output_bytes` against the bytes it serializes.",
      "type": "object",
      "properties": {
        "max_commands": {
          "description": "Maximum `perform` effects per decision.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_events": {
          "description": "Maximum events (facts) per decision.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_output_bytes": {
          "description": "Maximum serialized metadata/output bytes per decision.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_timers": {
          "description": "Maximum timer effects (schedule + cancel) per decision.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "max_output_bytes",
        "max_events",
        "max_commands",
        "max_timers"
      ]
    },
    "HelperLimits": {
      "description": "Limits for an inline custom helper (§1 row 6). D33 admits none in v1, so\nthese only bind a future admission; the helper's fuel is charged to the\nenclosing decision and turn budget.",
      "type": "object",
      "properties": {
        "aggregate_micros_per_decision": {
          "description": "Aggregate helper CPU per decision, in microseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cpu_p99_micros": {
          "description": "Target p99 CPU per helper call, in microseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_guest_memory_bytes": {
          "description": "Maximum guest memory, in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "cpu_p99_micros",
        "aggregate_micros_per_decision",
        "max_guest_memory_bytes"
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "Member": {
      "description": "A member of a definition. Names are the IR's own: an object type or\ninterface name, a property, link, lifecycle-property, or transition id,\nan object-map id, a law id.",
      "oneOf": [
        {
          "description": "The artifact as a whole (an action, a decision, a mapping).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "artifact"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "An object type or interface.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "type"
            },
            "typeName": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "typeName"
          ]
        },
        {
          "description": "A property of a type.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "property"
            },
            "property": {
              "type": "string"
            },
            "typeName": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "typeName",
            "property"
          ]
        },
        {
          "description": "A link of a type.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "link"
            },
            "link": {
              "type": "string"
            },
            "typeName": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "typeName",
            "link"
          ]
        },
        {
          "description": "A state of a type's lifecycle (a value of its lifecycle property).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "state"
            },
            "lifecycle": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "typeName": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "typeName",
            "lifecycle",
            "state"
          ]
        },
        {
          "description": "A declared transition of a type's lifecycle.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "transition"
            },
            "lifecycle": {
              "type": "string"
            },
            "transition": {
              "type": "string"
            },
            "typeName": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "typeName",
            "lifecycle",
            "transition"
          ]
        },
        {
          "description": "An object map of a mapping.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object_map"
            },
            "map": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "map"
          ]
        },
        {
          "description": "A law.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "law"
            },
            "law": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "law"
          ]
        }
      ]
    },
    "MemberRef": {
      "description": "A member of one exact artifact.",
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "member": {
          "$ref": "#/$defs/Member"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifactId",
        "version",
        "member"
      ]
    },
    "MemoryLimits": {
      "description": "Working-memory targets (§1 row 4). Allocation metering is `T3-BUDGET-1`.",
      "type": "object",
      "properties": {
        "live_footprint_target_bytes": {
          "description": "Integrated live-footprint target under the concurrency fixture, in\nbytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_turn_working_bytes": {
          "description": "Maximum incremental working allocation per admitted turn, in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "max_turn_working_bytes",
        "live_footprint_target_bytes"
      ]
    },
    "ResourceLimitProfile": {
      "description": "A versioned resource-limit profile (ruling 2026-09-27 §1).\n\nAll values are v1 qualification targets pending measurement.",
      "type": "object",
      "properties": {
        "decide": {
          "description": "One warm `decide`.",
          "$ref": "#/$defs/DecideBudget"
        },
        "envelope": {
          "description": "The per-decision output envelope.",
          "$ref": "#/$defs/EnvelopeLimits"
        },
        "helper": {
          "description": "An inline custom helper, only if D33 ever admits one.",
          "$ref": "#/$defs/HelperLimits"
        },
        "id": {
          "description": "Profile family identifier, e.g. `norn.limits`.",
          "type": "string"
        },
        "memory": {
          "description": "Working memory.",
          "$ref": "#/$defs/MemoryLimits"
        },
        "slice": {
          "description": "The declared input slice.",
          "$ref": "#/$defs/SliceLimits"
        },
        "turn": {
          "description": "The whole synchronous cell turn: one aggregate budget.",
          "$ref": "#/$defs/TurnBudget"
        },
        "version": {
          "description": "Profile version within the family. Any changed value is a new version.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "decide",
        "turn",
        "slice",
        "memory",
        "envelope",
        "helper"
      ]
    },
    "SliceLimits": {
      "description": "Bounds on the declared input slice (§1 row 3), enforced while reading.",
      "type": "object",
      "properties": {
        "max_canonical_bytes": {
          "description": "Maximum canonical input bytes of the slice.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_records": {
          "description": "Maximum selected records.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_relation_depth": {
          "description": "Maximum relation depth.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "qualification_ceiling_bytes": {
          "description": "The byte ceiling a later, measured profile may raise\n`max_canonical_bytes` to. Informational: never enforced in place of\n`max_canonical_bytes`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "max_canonical_bytes",
        "max_records",
        "max_relation_depth",
        "qualification_ceiling_bytes"
      ]
    },
    "TurnBudget": {
      "description": "Budget for one synchronous cell turn (§1 row 2): one aggregate budget that\nevery triggered decision, validation, and helper debits.",
      "type": "object",
      "properties": {
        "cpu_p99_micros": {
          "description": "Target p99 active CPU per turn, in microseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "fuel_units": {
          "description": "Deterministic fuel per turn, in Norn ZEN metering units, shared by every\ndecision in the turn. Provisional and uncalibrated until `T3-BUDGET-1`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "cpu_p99_micros",
        "fuel_units"
      ]
    },
    "ZenExpression": {
      "description": "Source text of one ZEN Expression (the IR's single expression language,\nruling 2026-09-25 §3): a decision-table cell, switch condition, expression\nassignment, or action precondition.\n\nStored verbatim; parsing and type checking belong to `norn-expr` and\n`norn-checker`.",
      "type": "string"
    }
  }
}
