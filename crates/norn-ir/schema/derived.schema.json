{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DerivedPayload",
  "type": "object",
  "properties": {
    "calc": {
      "$ref": "#/$defs/CalcExpr"
    },
    "extensions": {
      "description": "Reserved extension slots keyed by `<name>/<semver>`.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ViewInputRef"
      }
    },
    "maintenance": {
      "$ref": "#/$defs/ViewMaintenance"
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "refresh": {
      "$ref": "#/$defs/ViewRefresh"
    },
    "scopeRequired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "temporalScope": {
      "$ref": "#/$defs/TemporalScope"
    },
    "viewId": {
      "type": "string"
    },
    "viewVersion": {
      "$ref": "#/$defs/IrVersion01"
    }
  },
  "additionalProperties": false,
  "required": [
    "viewVersion",
    "viewId",
    "inputs",
    "calc",
    "outputSchema",
    "maintenance"
  ],
  "$defs": {
    "AggregateFn": {
      "description": "An aggregate function.",
      "oneOf": [
        {
          "description": "Exact sum of an additive column.",
          "type": "string",
          "const": "sum"
        },
        {
          "description": "Rows, or non-null values of `column`.",
          "type": "string",
          "const": "count"
        },
        {
          "description": "Distinct non-null values of `column`.",
          "type": "string",
          "const": "count_distinct"
        },
        {
          "description": "Least non-null value.",
          "type": "string",
          "const": "min"
        },
        {
          "description": "Greatest non-null value.",
          "type": "string",
          "const": "max"
        }
      ]
    },
    "CalcExpr": {
      "description": "Serializable calc expression leaf for a Derived view.\n\nViewIR v0 admits the `field_projection` form; ViewIR v1 adds `relational`\n(a closed, typed operator plan). `effectful_ts` is decodable so the checker\ncan reject it (IO belongs in an Effect artifact); `raw_promise` is never\nadmitted.",
      "oneOf": [
        {
          "description": "Simple field projection: select a non-empty subset of named fields from the primary input.",
          "type": "object",
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "field_projection"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "required": [
            "kind",
            "fields"
          ]
        },
        {
          "description": "Effectful TS leaf reference. Rejected inside a Derived view.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "effectful_ts"
            },
            "sourceRef": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sourceRef"
          ]
        },
        {
          "description": "ViewIR v1 (VIEW-TYPE-1): a closed relational plan over the declared\ninputs. Every node is typed by the checker against the effective\ncatalog; nothing in it is executed raw.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "relational"
            },
            "nodes": {
              "description": "Operators by node id.",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/ViewNode"
              }
            },
            "output": {
              "description": "The node whose rows are the view's rows.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "nodes",
            "output"
          ]
        }
      ]
    },
    "DedupeKeep": {
      "description": "Which row of a key a dedupe keeps.",
      "oneOf": [
        {
          "description": "The first row in order.",
          "type": "string",
          "const": "first"
        },
        {
          "description": "The last row in order.",
          "type": "string",
          "const": "last"
        }
      ]
    },
    "GroupKey": {
      "description": "One grouping key.",
      "type": "object",
      "properties": {
        "column": {
          "description": "The grouped column.",
          "type": "string"
        },
        "grain": {
          "description": "A calendar bucket for a date or timestamp column (ISO/UTC).",
          "$ref": "#/$defs/TimeGrain"
        }
      },
      "additionalProperties": false,
      "required": [
        "column"
      ]
    },
    "IrVersion01": {
      "description": "The only IR `0.1` version literal of the connector, widget, customization,\npolicy, derived, and setting roots and of ontology business packs.",
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "JoinKind": {
      "description": "Inner or left outer.",
      "oneOf": [
        {
          "description": "Only matched pairs.",
          "type": "string",
          "const": "inner"
        },
        {
          "description": "Every left row; unmatched right columns are null.",
          "type": "string",
          "const": "left"
        }
      ]
    },
    "JoinOn": {
      "description": "How a join pairs rows. Ad-hoc joins on arbitrary columns do not exist.",
      "oneOf": [
        {
          "description": "Along a declared link of the type whose ids a left column holds.",
          "type": "object",
          "properties": {
            "link": {
              "$ref": "#/$defs/LinkJoin"
            }
          },
          "additionalProperties": false,
          "required": [
            "link"
          ]
        },
        {
          "description": "A declared key equivalence: left columns equal, under the key's own\nnormalization, a declared unique key (or the id) of the right type.",
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/KeyJoin"
            }
          },
          "additionalProperties": false,
          "required": [
            "key"
          ]
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "KeyJoin": {
      "description": "A join on a declared key of the right type.",
      "type": "object",
      "properties": {
        "left": {
          "description": "Left columns, in the key's component order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "right": {
          "description": "A key declared by the right type, or `id` for its identity.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "left",
        "right"
      ]
    },
    "LinkJoin": {
      "description": "A join along a declared forward link role.",
      "type": "object",
      "properties": {
        "column": {
          "description": "The left column holding the link's source object ids.",
          "type": "string"
        },
        "link": {
          "description": "The declared forward link role.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "column",
        "link"
      ]
    },
    "Measure": {
      "description": "One measure of an aggregate.",
      "type": "object",
      "properties": {
        "column": {
          "description": "The measured column; omitted only for a row `count`.",
          "type": "string"
        },
        "fn": {
          "description": "The function.",
          "$ref": "#/$defs/AggregateFn"
        },
        "name": {
          "description": "The output column name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "fn"
      ]
    },
    "OrderKey": {
      "description": "One order key.",
      "type": "object",
      "properties": {
        "column": {
          "description": "The ordered column.",
          "type": "string"
        },
        "direction": {
          "description": "Its direction.",
          "$ref": "#/$defs/SortDirection"
        }
      },
      "additionalProperties": false,
      "required": [
        "column",
        "direction"
      ]
    },
    "ProjectColumn": {
      "description": "One output column of a projection.",
      "type": "object",
      "properties": {
        "expression": {
          "description": "A ZEN expression over `input.<column>`; `input.c` alone passes the\ncolumn through with its full contract.",
          "type": "string"
        },
        "name": {
          "description": "The output column name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "expression"
      ]
    },
    "RefreshPolicy": {
      "description": "VIEW-MAT-1: when a materialized transform's stored result is refreshed.",
      "oneOf": [
        {
          "description": "A read that finds the inputs changed refreshes, unless the stored\nresult is younger than `maxAgeMs`.",
          "type": "string",
          "const": "on_read"
        },
        {
          "description": "Only `POST /v1/transforms/{transform}:refresh` refreshes.",
          "type": "string",
          "const": "manual"
        }
      ]
    },
    "SortDirection": {
      "description": "Sort direction. Nulls sort last in both directions.",
      "oneOf": [
        {
          "description": "Ascending.",
          "type": "string",
          "const": "asc"
        },
        {
          "description": "Descending.",
          "type": "string",
          "const": "desc"
        }
      ]
    },
    "TemporalScope": {
      "description": "Optional time-dimension declaration for a Derived view.",
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/TemporalScopeMode"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "required": [
        "mode"
      ]
    },
    "TemporalScopeMode": {
      "description": "`mode: \"current\"` — resolve against latest committed facts (default).\n`mode: \"as_of_param\"` — resolve against the fact log up to a caller-supplied timestamp.\n  Views with this mode MUST list an input named \"`as_of`\" in their read-set.",
      "type": "string",
      "enum": [
        "current",
        "as_of_param"
      ]
    },
    "TimeGrain": {
      "description": "Calendar bucket grain.",
      "oneOf": [
        {
          "description": "Day.",
          "type": "string",
          "const": "day"
        },
        {
          "description": "Week.",
          "type": "string",
          "const": "week"
        },
        {
          "description": "Month.",
          "type": "string",
          "const": "month"
        },
        {
          "description": "Quarter.",
          "type": "string",
          "const": "quarter"
        },
        {
          "description": "Year.",
          "type": "string",
          "const": "year"
        }
      ]
    },
    "ViewInputKind": {
      "description": "Artifact kinds a derived view may read.",
      "type": "string",
      "enum": [
        "entity",
        "relation",
        "derived"
      ]
    },
    "ViewInputRef": {
      "description": "Identifies a Source-bearing entity or relation, or another Derived view, that a\nDerived view reads. References are exact-versioned to make the read-set computable.",
      "type": "object",
      "properties": {
        "alias": {
          "description": "Alias used in the calc expression (e.g. \"invoice\", \"`tax_rate`\"); unique per view.",
          "type": "string"
        },
        "artifactId": {
          "description": "Artifact id of the source entity, relation, or derived view being read.",
          "type": "string"
        },
        "kind": {
          "description": "Kind of the referenced artifact.",
          "$ref": "#/$defs/ViewInputKind"
        },
        "version": {
          "description": "Exact version of the referenced artifact.",
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "required": [
        "artifactId",
        "kind",
        "version",
        "alias"
      ]
    },
    "ViewMaintenance": {
      "description": "Maintenance strategy. `recompute_on_read` evaluates on every read;\n`materialized` (VIEW-MAT-1, relational calcs only) keeps one stored result\nrefreshed by the payload's `refresh`. `incremental` is reserved for a\nfuture IVM phase and MUST be rejected at extraction.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "recompute_on_read"
          ]
        },
        {
          "description": "Reserved — not implemented. The checker rejects artifacts carrying this value.",
          "type": "string",
          "const": "incremental"
        },
        {
          "description": "VIEW-MAT-1: the cell stores the result with its frontier.",
          "type": "string",
          "const": "materialized"
        }
      ]
    },
    "ViewNode": {
      "description": "One closed relational operator (VIEW-TYPE-1). No arbitrary function node.",
      "oneOf": [
        {
          "description": "Every readable row of one declared input; its grain is the object id.",
          "type": "object",
          "properties": {
            "input": {
              "description": "The `inputs[].alias` read.",
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "scan"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "input"
          ]
        },
        {
          "description": "Rows whose ZEN predicate is `true`.",
          "type": "object",
          "properties": {
            "input": {
              "description": "The node filtered.",
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "filter"
            },
            "predicate": {
              "description": "A Boolean ZEN expression over `input.<column>`.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "input",
            "predicate"
          ]
        },
        {
          "description": "Exactly the listed columns, each a typed ZEN expression over the row.",
          "type": "object",
          "properties": {
            "columns": {
              "description": "The output columns, in order.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProjectColumn"
              }
            },
            "input": {
              "description": "The node projected.",
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "input",
            "columns"
          ]
        },
        {
          "description": "A join along a declared link or a declared key equivalence (VIEW-JOIN-1).",
          "type": "object",
          "properties": {
            "kind": {
              "description": "Inner or left.",
              "$ref": "#/$defs/JoinKind"
            },
            "left": {
              "description": "The left node.",
              "type": "string"
            },
            "on": {
              "description": "The declared relationship.",
              "$ref": "#/$defs/JoinOn"
            },
            "op": {
              "type": "string",
              "const": "join"
            },
            "prefix": {
              "description": "Prefix for every right column; output names must stay unique.",
              "type": "string"
            },
            "right": {
              "description": "The right node: rows of one object type, at its identity grain.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right",
            "on",
            "kind",
            "prefix"
          ]
        },
        {
          "description": "Grouped measures under the metric layer's additivity laws (VIEW-AGG-1).",
          "type": "object",
          "properties": {
            "groupBy": {
              "description": "Group keys; empty means one row over the whole input.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/GroupKey"
              }
            },
            "input": {
              "description": "The node aggregated.",
              "type": "string"
            },
            "measures": {
              "description": "Non-empty measures.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Measure"
              }
            },
            "op": {
              "type": "string",
              "const": "aggregate"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "input",
            "groupBy",
            "measures"
          ]
        },
        {
          "description": "Ranking, offsets and running totals over a total order (VIEW-ORDER-1).",
          "type": "object",
          "properties": {
            "columns": {
              "description": "Non-empty window columns.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/WindowColumn"
              }
            },
            "input": {
              "description": "The node windowed.",
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "window"
            },
            "orderBy": {
              "description": "Order keys; with the partition they must cover the input grain.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/OrderKey"
              }
            },
            "partitionBy": {
              "description": "Partition columns.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "input",
            "partitionBy",
            "orderBy",
            "columns"
          ]
        },
        {
          "description": "Same-shaped inputs, tagged by branch (VIEW-UNION-1).",
          "type": "object",
          "properties": {
            "branch": {
              "description": "The output column holding each row's input node id.",
              "type": "string"
            },
            "inputs": {
              "description": "Two or more node ids.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "op": {
              "type": "string",
              "const": "union"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "inputs",
            "branch"
          ]
        },
        {
          "description": "One row per key, chosen by a total order (VIEW-ORDER-1).",
          "type": "object",
          "properties": {
            "input": {
              "description": "The node deduplicated.",
              "type": "string"
            },
            "keep": {
              "description": "Which row is kept.",
              "$ref": "#/$defs/DedupeKeep"
            },
            "key": {
              "description": "The key columns; the output grain.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "op": {
              "type": "string",
              "const": "dedupe"
            },
            "orderBy": {
              "description": "Order keys; with the key they must cover the input grain.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/OrderKey"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "input",
            "key",
            "orderBy",
            "keep"
          ]
        }
      ]
    },
    "ViewRefresh": {
      "description": "VIEW-MAT-1: a materialized transform's refresh policy.",
      "type": "object",
      "properties": {
        "maxAgeMs": {
          "description": "`on_read` only: a stored result younger than this is served (labelled\nstale) instead of refreshed.",
          "$ref": "#/$defs/WholeNumber"
        },
        "policy": {
          "description": "When the stored result is refreshed.",
          "$ref": "#/$defs/RefreshPolicy"
        }
      },
      "additionalProperties": false,
      "required": [
        "policy"
      ]
    },
    "WholeNumber": {
      "description": "A non-negative integral JSON number.\n\nIR JSON numbers are binary64 ([`JsonValue::Number`]), so a count written\nas `3` and one decoded as `3.0` are the same value. This accepts any\nintegral, non-negative number up to 2^53 (the exact-integer range of\nbinary64), matching the validators' `fract() == 0.0` checks; each member's\nlower bound stays a checker rule.",
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740992,
      "minimum": 0
    },
    "WindowColumn": {
      "description": "One window column.",
      "type": "object",
      "properties": {
        "column": {
          "description": "The column read by `lag`, `lead` and `running_sum`.",
          "type": "string"
        },
        "fn": {
          "description": "The function.",
          "$ref": "#/$defs/WindowFn"
        },
        "name": {
          "description": "The output column name.",
          "type": "string"
        },
        "offset": {
          "description": "Rows back or ahead for `lag`/`lead` (default 1).",
          "$ref": "#/$defs/WholeNumber"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "fn"
      ]
    },
    "WindowFn": {
      "description": "A window function.",
      "oneOf": [
        {
          "description": "1, 2, 3, … in order.",
          "type": "string",
          "const": "row_number"
        },
        {
          "description": "Rank with gaps over equal order values.",
          "type": "string",
          "const": "rank"
        },
        {
          "description": "Rank without gaps.",
          "type": "string",
          "const": "dense_rank"
        },
        {
          "description": "`column` of the row `offset` rows earlier; null before the first.",
          "type": "string",
          "const": "lag"
        },
        {
          "description": "`column` of the row `offset` rows later; null after the last.",
          "type": "string",
          "const": "lead"
        },
        {
          "description": "Exact sum of an additive column from the partition start to this row.",
          "type": "string",
          "const": "running_sum"
        }
      ]
    }
  }
}
