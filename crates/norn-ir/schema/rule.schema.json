            "objectType",
            "transition"
          ]
        },
        {
          "description": "An object of `objectType` was created.",
          "type": "object",
          "properties": {
            "maxCausalDepth": {
              "description": "Maximum causal depth accepted when this rule already appears in the\nevent's rule lineage. Omitted suppresses repeats of this rule.",
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "objectType": {
