    "RuleSourceCommand": {
      "description": "A guarded update capability for one declared mapped, observed object.\n\nThe command always updates the exact object identified by `slice`, and\ntakes its optimistic-concurrency version from `modifiedProperty` in that\nobject. The checker binds the connector, mapping, map, source doctype and\nraw source `modified` field before admitting the declaration.",
      "type": "object",
      "properties": {
        "childMerges": {
          "description": "Owner-scoped child-table desired sets derived from the decide input.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionCommandChildMerge"
          }
        },
        "connector": {
          "description": "Connector artifact id that grants a generic update capability.",
          "type": "string"
        },
        "doctype": {
          "description": "Exact source document type allowed by this declaration.",
          "type": "string"
        },
        "fields": {
          "description": "Source fields whose values are derived from the decide input.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ZenExpression"
          }
        },
        "id": {
          "description": "Stable local id used by the graph's `sourceCommandId` activation.",
          "type": "string"
        },
        "map": {
          "description": "Object map id in the mapping artifact.",
          "type": "string"
        },
        "mapping": {
          "description": "Mapping artifact id that produces the observed target.",
          "type": "string"
        },
        "modifiedProperty": {
          "description": "Mapped target property carrying the source's raw `modified` value.",
          "type": "string"
        },
        "slice": {
          "description": "Name of the single-object slice member containing the observed target.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "connector",
        "mapping",
        "map",
        "doctype",
        "slice",
        "modifiedProperty"
      ]
    },
    "RuleTrigger": {
