{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RulePayload",
  "type": "object",
  "properties": {
    "appliesTo": {
      "type": "string"
    },
    "contract": {
      "$ref": "#/$defs/RuleContractV2"
    },
    "decision": {
      "$ref": "#/$defs/RuleDecisionV1"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "expression": {
      "type": "string"
    },
    "extensions": {
      "description": "Reserved extension slots keyed by `<name>/<semver>`.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "graph": {
      "$ref": "#/$defs/JdmGraph"
    },
    "inputSchema": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "requiredServices": {
      "type": "array",
      "maxItems": 0
    },
    "ruleId": {
      "type": "string"
    },
    "ruleVersion": {
      "type": "string"
    },
    "scopeRequired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "type": "string"
    },
    "sideEffects": {
      "$ref": "#/$defs/JsonFalse"
    },
    "slice": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SliceDeclaration"
      }
    },
    "sourceCommands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuleSourceCommand"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuleTrigger"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "ruleId"
  ],
  "$defs": {
    "ActionCommandChildMerge": {
      "description": "A declarative owner-scoped complete desired set for one source child table.",
      "type": "object",
      "properties": {
        "field": {
          "description": "Parent field holding the source child rows.",
          "type": "string"
        },
        "ownershipField": {
          "description": "Child row field that records Norn ownership.",
          "type": "string"
        },
        "ownershipValue": {
          "description": "ZEN Expression yielding the owner marker written to each desired row.",
          "$ref": "#/$defs/ZenExpression"
        },
        "rowKeyField": {
          "description": "Child row field used to match an existing owned row.",
          "type": "string"
        },
        "rows": {
          "description": "ZEN Expression yielding the complete desired row array.",
          "$ref": "#/$defs/ZenExpression"
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "ownershipField",
        "ownershipValue",
        "rowKeyField",
        "rows"
      ]
    },
    "JdmCustomNodeContent": {
      "description": "Custom-node content (`CustomNodeContent`). Decodable only for rejection.",
      "type": "object",
      "properties": {
        "config": {
          "$ref": "#/$defs/JsonValue"
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "config"
      ]
    },
    "JdmDecisionTableContent": {
      "description": "Decision-table content (`DecisionTableContent`).",
      "type": "object",
      "properties": {
        "executionMode": {
          "$ref": "#/$defs/JdmExecutionMode"
        },
        "hitPolicy": {
          "$ref": "#/$defs/JdmHitPolicy"
        },
        "inputField": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JdmTableInput"
          }
        },
        "outputPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JdmTableOutput"
          }
        },
        "passThrough": {
          "type": "boolean"
        },
        "rules": {
          "description": "Ordered rows; each carries a stable `_id`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/JdmTableRow"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "hitPolicy",
        "inputs",
        "outputs",
        "rules"
      ]
    },
    "JdmEdge": {
      "description": "A directed edge between two nodes (`DecisionEdge`).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sourceHandle": {
          "description": "Source handle; a switch statement id when the source is a switch node.",
          "type": [
            "string",
            "null"
          ]
        },
        "sourceId": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "type": {
          "description": "Editor edge type (`\"edge\"`); ignored by evaluation.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "targetId"
      ]
    },
    "JdmExecutionMode": {
      "description": "`executionMode` of a transforming node.",
      "type": "string",
      "enum": [
        "single",
        "loop"
      ]
    },
    "JdmExpression": {
      "description": "One `key = value` assignment of an expression node.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ZenExpression"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "value"
      ]
    },
    "JdmExpressionContent": {
      "description": "Expression-node content (`ExpressionNodeContent`).",
      "type": "object",
      "properties": {
        "executionMode": {
          "$ref": "#/$defs/JdmExecutionMode"
        },
        "expressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JdmExpression"
          }
        },
        "inputField": {
          "type": [
            "string",
            "null"
          ]
        },
        "outputPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "passThrough": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "expressions"
      ]
    },
    "JdmGraph": {
      "description": "A JDM decision graph (`GraphContent` in `zen-engine`).",
      "type": "object",
      "properties": {
        "contentType": {
          "description": "Optional `jdm-editor` content type ([`JDM_CONTENT_TYPE`]).",
          "type": [
            "string",
            "null"
          ]
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JdmEdge"
          }
        },
        "imports": {
          "description": "Graph imports. In `zen-engine` an import names a policy document (a\ndictionary of output-column types). Norn has no such artifact: value\ntypes come from `EntityIR` v2, so no import resolves and the Norn\nprofile rejects every one (T3-DEC-1); the evaluator never loads one.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JdmNode"
          }
        },
        "settings": {
          "description": "`jdm-editor` graph settings; editor metadata, ignored by evaluation.",
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ]
    },
    "JdmHitPolicy": {
      "description": "JDM hit policy shared by decision tables and switch nodes.\n\nDMN policies other than `first` and `collect` translate or are rejected at\nDMN ingress (T3-DEC-4); they have no JDM representation.",
      "type": "string",
      "enum": [
        "first",
        "collect"
      ]
    },
    "JdmNode": {
      "description": "One JDM node, internally tagged by its JDM `type`.\n\nEvery variant carries the common `id`, `name`, and optional editor\n`position`; use [`JdmNode::id`], [`JdmNode::name`], and\n[`JdmNode::node_type`] instead of matching when only those are needed.",
      "oneOf": [
        {
          "description": "Graph input. `content.schema` is the JDM JSON-Schema string, if any.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/JdmSchemaContent"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "position": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JdmPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "inputNode"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name"
          ]
        },
        {
          "description": "Graph output. `content.schema` is the JDM JSON-Schema string, if any.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/JdmSchemaContent"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "position": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JdmPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "outputNode"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name"
          ]
        },
        {
          "description": "Named ZEN Expression assignments.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/JdmExpressionContent"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "position": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JdmPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "expressionNode"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name",
            "content"
          ]
        },
        {
          "description": "Decision table with ZEN unary-test / expression cells.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/JdmDecisionTableContent"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "position": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JdmPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "decisionTableNode"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name",
            "content"
          ]
        },
        {
          "description": "Conditional branching on ZEN Expression statements.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/JdmSwitchContent"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "position": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JdmPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "switchNode"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name",
            "content"
          ]
        },
        {
          "description": "Sub-decision: evaluates another decision graph by key.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/JdmSubDecisionContent"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "position": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JdmPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "decisionNode"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name",
            "content"
          ]
        },
        {
          "description": "JavaScript function node. Outside the Norn profile: decodable only so\nthe checker can reject it with a diagnostic; never executed.",
          "type": "object",
          "properties": {
            "content": {
              "description": "Opaque: `zen-engine` accepts a source string (v1) or `{ \"source\" }` (v2).",
              "$ref": "#/$defs/JsonValue"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "position": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JdmPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "functionNode"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name",
            "content"
          ]
        },
        {
          "description": "Custom (adapter-evaluated) node. Outside the Norn profile (D33 v1):\ndecodable only so the checker can reject it with a diagnostic.",
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/JdmCustomNodeContent"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "position": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JdmPosition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "customNode"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name",
            "content"
          ]
        }
      ]
    },
    "JdmPosition": {
      "description": "Editor canvas position. Layout only; ignored by evaluation.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "JdmSchemaContent": {
      "description": "Input/output node content (`InputNodeContent` / `OutputNodeContent`).",
      "type": "object",
      "properties": {
        "schema": {
          "description": "JSON Schema serialized as a string, as JDM stores it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "JdmSubDecisionContent": {
      "description": "Sub-decision content (`DecisionNodeContent`).",
      "type": "object",
      "properties": {
        "executionMode": {
          "$ref": "#/$defs/JdmExecutionMode"
        },
        "inputField": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "Key of the referenced decision graph: the `artifactId` of a `RuleIR` v2\nrule that the envelope declares as a required `rule` dependency. The\nchecker resolves it and bounds the sub-decision closure (T3-DEC-1).",
          "type": "string"
        },
        "outputPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "passThrough": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "key"
      ]
    },
    "JdmSwitchContent": {
      "description": "Switch-node content (`SwitchNodeContent`).",
      "type": "object",
      "properties": {
        "hitPolicy": {
          "description": "Absent means `first` (the `zen-engine` default).",
          "$ref": "#/$defs/JdmHitPolicy"
        },
        "statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JdmSwitchStatement"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "statements"
      ]
    },
    "JdmSwitchStatement": {
      "description": "One switch branch; edges leave the switch with `sourceHandle` = `id`.",
      "type": "object",
      "properties": {
        "condition": {
          "description": "Boolean ZEN Expression; empty means the default branch.",
          "$ref": "#/$defs/ZenExpression"
        },
        "id": {
          "type": "string"
        },
        "isDefault": {
          "description": "Editor default-branch marker. Evaluation treats an empty `condition`\nas the default branch; this flag is editor metadata.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "condition"
      ]
    },
    "JdmTableInput": {
      "description": "A decision-table input column (`DecisionTableInputField`).",
      "type": "object",
      "properties": {
        "field": {
          "description": "Input path; absent means the column's cells are full expressions.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "description": "Editor column type (for example `\"expression\"`); ignored by evaluation.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "JdmTableOutput": {
      "description": "A decision-table output column (`DecisionTableOutputField`).",
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "field"
      ]
    },
    "JdmTableRow": {
      "description": "One decision-table row: a stable `_id`, an optional `_description`, and one\nZEN Expression cell per column id (unary tests for inputs, expressions for\noutputs). An empty cell matches anything.",
      "type": "object",
      "properties": {
        "_description": {
          "type": "string"
        },
        "_id": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/ZenExpression"
      },
      "required": [
        "_id"
      ]
    },
    "JsonFalse": {
      "const": false
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "ObjectTypeName": {
      "description": "Qualified name of an object type: dotted lower-case namespace segments and\na PascalCase type name (`retail.Sku`, `hr.Employee`), the form v1\n`objectKind` already uses. The namespace segments are the type's domain\nnamespace ([`Self::domain`]).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*\\.[A-Z][A-Za-z0-9]*$"
    },
    "PropertyId": {
      "description": "Id of a property within its object type (`sku_code`), unique there.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "RuleConditionV1": {
      "description": "RuleIR v1 closed-operator condition, mirroring the conditions the\n`norn-engine` closed evaluator runs (`RuleCondition`).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "exists"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "field"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "eq"
            },
            "value": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "neq"
            },
            "value": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "lt"
            },
            "value": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "lte"
            },
            "value": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "gt"
            },
            "value": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "gte"
            },
            "value": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "in"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/JsonValue"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "field",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "max": {
              "$ref": "#/$defs/JsonValue"
            },
            "min": {
              "$ref": "#/$defs/JsonValue"
            },
            "op": {
              "type": "string",
              "const": "between"
            }
