{
  "description": "DMN TCK 0118-multi-priority-hitpolicy: PRIORITY -> JDM first (row).",
  "rule": {
    "ruleId": "dmn_tck.0118-multi-priority-hitpolicy",
    "ruleVersion": "2.0",
    "contract": "decide",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slice": {
          "type": "object",
          "properties": {
            "Age": {
              "type": "number"
            },
            "RiskCategory": {
              "type": "string"
            },
            "isAffordable": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "event": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "slice",
        "event"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "set"
                ]
              }
            },
            "required": [
              "op"
            ],
            "additionalProperties": false
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string"
              },
              "result": {
                "type": "object",
                "properties": {
                  "Approved/Declined": {
                    "type": "string"
                  },
                  "Rate": {
                    "type": "string"
                  }
                },
                "required": [
                  "Approved/Declined",
                  "Rate"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "decision",
              "result"
            ],
            "additionalProperties": false
          }
        },
        "timers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timerId": {
                "type": "string"
              }
            },
            "required": [
              "timerId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "facts",
        "commands",
        "timers"
      ],
      "additionalProperties": false
    },
    "scopeRequired": [],
    "graph": {
      "nodes": [
        {
          "id": "in",
          "name": "in",
          "type": "inputNode"
        },
        {
          "id": "table",
          "name": "Approval Status",
          "type": "decisionTableNode",
          "content": {
            "hitPolicy": "first",
            "inputs": [
              {
                "id": "i0",
                "name": "Age",
                "field": "slice.Age"
              },
              {
                "id": "i1",
                "name": "RiskCategory",
                "field": "slice.RiskCategory"
              },
              {
                "id": "i2",
                "name": "isAffordable",
                "field": "slice.isAffordable"
              }
            ],
            "outputs": [
              {
                "id": "o0",
                "name": "Approved/Declined",
                "field": "Approved/Declined"
              },
              {
                "id": "o1",
                "name": "Rate",
                "field": "Rate"
              }
            ],
            "rules": [
              {
                "_id": "r1",
                "i0": ">=18",
                "i1": "\"Medium\", \"Low\"",
                "i2": "true",
                "o0": "\"Approved\"",
                "o1": "\"Basic\""
              },
              {
                "_id": "r3",
                "i0": "",
                "i1": "\"High\"",
                "i2": "",
                "o0": "\"Approved\"",
                "o1": "\"Standard\""
              },
              {
                "_id": "r2",
                "i0": "<18",
                "i1": "",
                "i2": "",
                "o0": "\"Declined\"",
                "o1": "\"Standard\""
              }
            ],
            "outputPath": "hit",
            "passThrough": true
          }
        },
        {
          "id": "shape",
          "name": "shape",
          "type": "expressionNode",
          "content": {
            "expressions": [
              {
                "id": "x_result",
                "key": "result",
                "value": "hit == null or len(keys(hit)) == 0 ? null : hit"
              }
            ]
          }
        },
        {
          "id": "emit",
          "name": "emit",
          "type": "expressionNode",
          "content": {
            "expressions": [
              {
                "id": "x_facts",
                "key": "facts",
                "value": "[]"
              },
              {
                "id": "x_commands",
                "key": "commands",
                "value": "result == null ? [] : [{decision: \"Approval Status\", result: result}]"
              },
              {
                "id": "x_timers",
                "key": "timers",
                "value": "[]"
              }
            ]
          }
        },
        {
          "id": "out",
          "name": "out",
          "type": "outputNode"
        }
      ],
      "edges": [
        {
          "id": "e1",
          "sourceId": "in",
          "targetId": "table"
        },
        {
          "id": "e2",
          "sourceId": "table",
          "targetId": "shape"
        },
        {
          "id": "e3",
          "sourceId": "shape",
          "targetId": "emit"
        },
        {
          "id": "e4",
          "sourceId": "emit",
          "targetId": "out"
        }
      ]
    }
  },
  "cases": [
