      "contract": "decide",
      "graph": {
        "contentType": "application/vnd.gorules.decision",
        "edges": [
          {
            "id": "e_in",
            "sourceId": "in",
            "targetId": "route",
            "type": "edge"
          },
          {
            "id": "e_out",
            "sourceId": "route",
            "targetId": "out",
            "type": "edge"
          }
