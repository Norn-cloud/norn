                },
                {
                  "field": "timers",
                  "id": "o_timers",
                  "name": "timers"
                }
              ],
              "rules": [
                {
                  "_description": "started on start: perform norn.decision → awaiting_perform_ask_review",
                  "_id": "started/start/1",
                  "c_when": "slice.run == null and event.kind == 'start'",
                  "o_commands": "[{kind: 'perform', runId: event.runId, step: 'ask_review', function: 'norn.decision', functionVersion: '1', idempotencyKey: event.runId + ':ask_review', attempt: 1, input: {ask_review: {question: 'Refund order 1042 in full?', risk: 'high', options: [{id: 'approve', label: 'Approve the refund', scope: 'This refund only', effect: {action: 'ops.refund.approve'}}, {id: 'reject', label: 'Reject the refund', scope: 'This refund only', effect: {action: 'ops.refund.reject'}}], agentPick: 'approve', decider: {roles: ['admin', 'owner']}, expiresInMs: 86400000}}}]",
                  "o_facts": "[{op: 'create', objectType: 'ops.ApproveRefundRun', key: event.runId, values: {run_id: event.runId, status: 'started'}}, {op: 'transition', objectType: 'ops.ApproveRefundRun', key: event.runId, lifecycle: 'status', transition: 'to_awaiting_perform_ask_review'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_ask_review on result: complete → completed",
                  "_id": "awaiting_perform_ask_review/result/1",
                  "c_when": "slice.run.status == 'awaiting_perform_ask_review' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'ask_review' and event.attempt == 1 and (event.results.ask_review.choice == 'approve')",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'ops.ApproveRefundRun', key: slice.run.run_id, property: 'slots', value: {result: {outcome: 'approved'}}}, {op: 'transition', objectType: 'ops.ApproveRefundRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_ask_review on result: complete → completed",
                  "_id": "awaiting_perform_ask_review/result/2",
                  "c_when": "slice.run.status == 'awaiting_perform_ask_review' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'ask_review' and event.attempt == 1 and not (event.results.ask_review.choice == 'approve')",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'ops.ApproveRefundRun', key: slice.run.run_id, property: 'slots', value: {result: {outcome: 'rejected'}}}, {op: 'transition', objectType: 'ops.ApproveRefundRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_ask_review on failure: fail Expired → failed_expired",
                  "_id": "awaiting_perform_ask_review/failure/1",
                  "c_when": "slice.run.status == 'awaiting_perform_ask_review' and event.kind == 'failure' and event.runId == slice.run.run_id and event.step == 'ask_review' and event.attempt == 1 and event.failure._tag == 'Expired'",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'ops.ApproveRefundRun', key: slice.run.run_id, property: 'slots', value: {failure: event.failure}}, {op: 'transition', objectType: 'ops.ApproveRefundRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_failed_expired'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_ask_review on failure: fail Withdrawn → failed_withdrawn",
                  "_id": "awaiting_perform_ask_review/failure/2",
                  "c_when": "slice.run.status == 'awaiting_perform_ask_review' and event.kind == 'failure' and event.runId == slice.run.run_id and event.step == 'ask_review' and event.attempt == 1 and event.failure._tag == 'Withdrawn'",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'ops.ApproveRefundRun', key: slice.run.run_id, property: 'slots', value: {failure: event.failure}}, {op: 'transition', objectType: 'ops.ApproveRefundRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_failed_withdrawn'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "any other event (duplicate, stale, or late): no change",
                  "_id": "otherwise",
                  "c_when": "",
                  "o_commands": "[]",
                  "o_facts": "[]",
                  "o_timers": "[]"
                }
              ]
            },
            "id": "route",
            "name": "durable steps",
