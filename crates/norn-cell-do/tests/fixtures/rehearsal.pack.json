    "rehearsal.ApplicationRecord.interface"
   ],
   "maps": [
    {
     "id": "application",
     "lifecycles": [
      {
       "property": "status",
       "state": "input.steps_completed_10m < 4 ? 'Stalled' : 'Started'"
      }
     ],
     "properties": [
      {
       "property": "application_id",
       "value": "input.application_id"
      },
      {
       "property": "application_start_time",
       "value": "input.application_start_time"
      },
      {
       "property": "application_channel",
       "value": "input.application_channel"
      },
      {
       "property": "device_type",
       "value": "input.device_type"
