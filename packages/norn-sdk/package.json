{
  "name": "@norn/sdk",
  "private": true,
  "description": "Generated IR and checker types, and the domain-agnostic action and live-read client (TypeScript source, no dependencies)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../sdks/openapi/norn-api.openapi.json -o src/generated/norn-api.ts",
    "typecheck": "tsrs --fast -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "openapi-typescript": "7.13.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "6.0.3"
  }
}
