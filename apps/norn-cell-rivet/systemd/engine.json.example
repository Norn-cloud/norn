{
  "auth": { "admin_token": "REPLACE: openssl rand -hex 32, the same on every instance" },
  "storage": {
    "log_directory": "/var/lib/rivet/log",
    "zone": "REPLACE: this machine's failure domain, e.g. fsn1-dc14"
  },
  "api_peer": {
    "host": "REPLACE: this machine's private IP, e.g. 10.0.0.11",
    "advertise_address": "REPLACE: the same IP with port 6421, e.g. 10.0.0.11:6421"
  },
  "object_storage": {
    "primary": {
      "s3": {
        "bucket": "REPLACE: the cluster's bucket",
        "endpoint": "https://fsn1.your-objectstorage.com",
        "region": "fsn1",
        "access_key_id": "REPLACE",
        "secret_access_key": "REPLACE"
      }
    }
  },
  "telemetry": { "enabled": false }
}
