# Copy to apps/norn-cell-rivet/.env (never commit it) and fill in.
# openssl rand -hex 32; the same value on every engine and runner.
RIVET_ADMIN_TOKEN=
# The bucket every engine shares. The bundled test bucket (profile s3):
S3_BUCKET=norn-rivet
S3_ENDPOINT=http://s3:9000
# The bundled bucket speaks plain http on the compose network; never set this for a remote bucket.
S3_ALLOW_HTTP=true
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Hetzner Object Storage instead (versioning OFF; see README.md):
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
# S3_ALLOW_HTTP=false
# The identity service that signs host tokens (Studio's Better Auth jwt plugin).
NORN_HOST_ISSUER=
NORN_HOST_JWKS_URL=
# The stage secret for lineage handles, at least 32 bytes.
NORN_LINEAGE_KEY=
