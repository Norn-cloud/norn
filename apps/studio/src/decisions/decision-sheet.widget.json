                "source": {
                  "kind": "user",
                  "nodeId": "retry-button"
                }
              },
              {
                "eventId": "close",
                "source": {
                  "kind": "user",
                  "nodeId": "close-button"
                }
              },
              {
                "eventId": "stay",
                "source": {
                  "kind": "user",
                  "nodeId": "stay-button"
                }
              },
              {
                "eventId": "leave",
                "source": {
                  "kind": "user",
