                "assign": {
                  "note": "input.event.value"
                }
              },
              {
                "transitionId": "confirming--choose",
                "from": "confirming",
                "on": "choose",
                "target": "choosing",
                "assign": {
                  "choice": "input.event.value",
                  "needsConfirm": "input.event.confirm"
                }
              },
              {
                "transitionId": "confirming--edit-note",
                "from": "confirming",
                "on": "edit-note",
                "target": "choosing",
                "assign": {
                  "note": "input.event.value"
                }
              },
              {
                "transitionId": "refused--choose",
                "from": "refused",
                "on": "choose",
                "target": "choosing",
                "assign": {
                  "choice": "input.event.value",
                  "needsConfirm": "input.event.confirm"
                }
              },
              {
                "transitionId": "refused--edit-note",
                "from": "refused",
                "on": "edit-note",
                "target": "choosing",
                "assign": {
                  "note": "input.event.value"
