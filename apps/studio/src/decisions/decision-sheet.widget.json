            "states": [
              {
                "stateId": "choosing",
                "role": "idle"
              },
              {
                "stateId": "confirming",
                "role": "idle"
              },
              {
                "stateId": "sending",
                "role": "pending",
                "deadlineMs": 20000,
                "awaits": {
                  "kind": "operation",
                  "operationId": "decideDecision"
                }
              },
              {
                "stateId": "refused",
                "role": "error"
              },
              {
                "stateId": "failed",
                "role": "error"
              },
              {
                "stateId": "awaiting-approval",
                "role": "idle"
              },
              {
                "stateId": "leaving",
                "role": "idle"
              },
              {
                "stateId": "decided",
                "role": "terminal"
              },
              {
                "stateId": "resolved",
                "role": "terminal"
              },
              {
                "stateId": "expired",
                "role": "terminal"
              },
              {
                "stateId": "gone",
                "role": "terminal"
              },
              {
                "stateId": "closed",
                "role": "terminal"
              }
            ],
