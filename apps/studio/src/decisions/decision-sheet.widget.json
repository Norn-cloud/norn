                }
              },
              {
                "eventId": "approval",
                "source": {
                  "kind": "outcome",
                  "outcome": "pending_approval"
                }
              },
              {
                "eventId": "network",
                "source": {
                  "kind": "outcome",
                  "outcome": "network_failure"
                }
