                "required": true,
                "initial": ""
              },
              {
                "fieldId": "needsConfirm",
                "type": "boolean",
                "required": true,
                "initial": false
              },
              {
                "fieldId": "lastCode",
                "type": "text",
                "required": false
              },
              {
                "fieldId": "refusedChoice",
                "type": "text",
                "required": false
              }
            ],
            "events": [
              {
                "eventId": "choose",
                "source": {
                  "kind": "user",
                  "nodeId": "option-choice"
                },
                "payload": [
                  {
                    "fieldId": "value",
                    "type": "text",
                    "required": true
                  },
                  {
                    "fieldId": "confirm",
                    "type": "boolean",
