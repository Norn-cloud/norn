              },
              {
                "transitionId": "failed--edit-note",
                "from": "failed",
                "on": "edit-note",
                "target": "choosing",
                "assign": {
                  "note": "input.event.value"
                }
              },
              {
                "transitionId": "choosing--decide",
                "from": "choosing",
                "on": "decide",
                "target": "sending",
                "guard": "input.fields.choice != null and input.fields.choice != input.fields.refusedChoice and not input.fields.needsConfirm",
                "effects": [
                  {
                    "kind": "start",
                    "call": {
                      "kind": "operation",
                      "operationId": "decideDecision"
                    },
                    "input": {
                      "choice": "input.fields.choice",
                      "note": "input.fields.note"
                    }
                  }
                ]
              },
              {
                "transitionId": "choosing--decide--confirming",
                "from": "choosing",
                "on": "decide",
                "target": "confirming",
                "guard": "input.fields.choice != null and input.fields.choice != input.fields.refusedChoice and input.fields.needsConfirm"
              },
              {
                "transitionId": "refused--decide",
                "from": "refused",
                "on": "decide",
                "target": "sending",
                "guard": "input.fields.choice != null and input.fields.choice != input.fields.refusedChoice and not input.fields.needsConfirm",
                "effects": [
                  {
                    "kind": "start",
                    "call": {
                      "kind": "operation",
                      "operationId": "decideDecision"
                    },
                    "input": {
                      "choice": "input.fields.choice",
                      "note": "input.fields.note"
                    }
                  }
                ]
              },
              {
                "transitionId": "refused--decide--confirming",
                "from": "refused",
                "on": "decide",
                "target": "confirming",
                "guard": "input.fields.choice != null and input.fields.choice != input.fields.refusedChoice and input.fields.needsConfirm"
              },
              {
                "transitionId": "choosing--close",
                "from": "choosing",
                "on": "close",
                "target": "closed",
                "guard": "input.fields.choice == null and input.fields.note == \"\""
              },
              {
                "transitionId": "choosing--close--leaving",
                "from": "choosing",
                "on": "close",
                "target": "leaving",
                "guard": "input.fields.choice != null or input.fields.note != \"\""
              },
              {
                "transitionId": "confirming--close",
                "from": "confirming",
                "on": "close",
                "target": "leaving"
              },
              {
                "transitionId": "refused--close",
                "from": "refused",
                "on": "close",
                "target": "leaving"
              },
              {
                "transitionId": "failed--close",
                "from": "failed",
                "on": "close",
                "target": "leaving"
              },
              {
                "transitionId": "confirming--confirm",
                "from": "confirming",
                "on": "confirm",
                "target": "sending",
                "effects": [
                  {
                    "kind": "start",
                    "call": {
                      "kind": "operation",
                      "operationId": "decideDecision"
                    },
                    "input": {
                      "choice": "input.fields.choice",
                      "note": "input.fields.note"
                    }
                  }
                ]
              },
              {
                "transitionId": "confirming--back",
                "from": "confirming",
                "on": "back",
                "target": "choosing"
              },
              {
                "transitionId": "sending--accepted",
                "from": "sending",
                "on": "accepted",
                "target": "decided"
              },
              {
                "transitionId": "sending--approval",
                "from": "sending",
                "on": "approval",
                "target": "awaiting-approval"
              },
              {
                "transitionId": "sending--network",
                "from": "sending",
                "on": "network",
                "target": "failed"
              },
              {
                "transitionId": "sending--timeout",
                "from": "sending",
                "on": "timeout",
                "target": "failed"
              },
              {
                "transitionId": "sending--refused-visibility",
                "from": "sending",
                "on": "refused-visibility",
                "target": "gone"
              },
              {
                "transitionId": "sending--refused-conflict",
                "from": "sending",
                "on": "refused-conflict",
                "target": "resolved",
                "guard": "input.event.code == \"decision.resolved\""
              },
              {
                "transitionId": "sending--refused-invalid",
                "from": "sending",
                "on": "refused-invalid",
                "target": "expired",
                "guard": "input.event.code == \"decision.expired\""
              },
              {
                "transitionId": "sending--refused",
                "from": "sending",
                "on": "refused",
                "target": "refused",
                "assign": {
                  "lastCode": "input.event.code"
                }
              },
              {
                "transitionId": "sending--refused-permission",
                "from": "sending",
                "on": "refused-permission",
                "target": "refused",
                "assign": {
                  "lastCode": "input.event.code",
                  "refusedChoice": "input.fields.choice"
                }
              },
              {
                "transitionId": "sending--refused-precondition",
                "from": "sending",
                "on": "refused-precondition",
                "target": "refused",
                "assign": {
                  "lastCode": "input.event.code",
                  "refusedChoice": "input.fields.choice"
                }
              },
              {
                "transitionId": "failed--retry",
                "from": "failed",
                "on": "retry",
                "target": "sending",
                "effects": [
                  {
                    "kind": "start",
                    "call": {
                      "kind": "operation",
                      "operationId": "decideDecision"
                    },
                    "input": {
                      "choice": "input.fields.choice",
                      "note": "input.fields.note"
                    }
                  }
                ]
              },
              {
                "transitionId": "awaiting-approval--close",
                "from": "awaiting-approval",
                "on": "close",
                "target": "closed"
              },
              {
                "transitionId": "leaving--stay",
                "from": "leaving",
                "on": "stay",
                "target": "choosing"
              },
              {
                "transitionId": "leaving--leave",
                "from": "leaving",
                "on": "leave",
                "target": "closed"
              }
            ]
          }
        }
      ],
      "dataBindings": [],
      "actionBindings": [],
      "fields": [],
      "forms": [],
      "actionPlacements": [],
      "navigationItems": [],
