        "artifactId": "shop.revenue_by_region",
        "kind": "derived",
        "namespace": "shop",
        "name": "Weekly revenue by region",
        "version": "0.1.0",
        "lifecycle": "draft",
        "scope": {
          "orgId": "org_demo",
          "environmentId": "dev"
        },
        "dependencies": [
          {
            "artifactId": "shop.Order.entity",
            "kind": "entity",
            "version": "0.1.0",
            "required": true
          },
          {
            "artifactId": "shop.Customer.entity",
            "kind": "entity",
            "version": "0.1.0",
            "required": true
          }
        ],
        "provenance": {
          "source": "authoring_sdk"
        },
        "payload": {
          "viewVersion": "0.1",
          "viewId": "shop.revenue_by_region",
          "inputs": [
            {
              "artifactId": "shop.Order.entity",
              "kind": "entity",
              "version": "0.1.0",
              "alias": "order"
            },
            {
              "artifactId": "shop.Customer.entity",
              "kind": "entity",
              "version": "0.1.0",
              "alias": "customer"
            }
          ],
          "calc": {
            "kind": "relational",
            "output": "ranked",
            "nodes": {
              "order": {
                "op": "scan",
                "input": "order"
              },
              "customer": {
                "op": "scan",
                "input": "customer"
              },
              "paid": {
                "op": "filter",
                "input": "order",
                "predicate": "input.amount > 0"
              },
              "joined": {
                "op": "join",
                "left": "paid",
                "right": "customer",
                "on": {
                  "link": {
                    "column": "id",
                    "link": "customer"
                  }
                },
                "kind": "left",
                "prefix": "customer_"
              },
              "regional": {
                "op": "project",
                "input": "joined",
                "columns": [
                  {
                    "name": "id",
                    "expression": "input.id"
                  },
                  {
                    "name": "region",
                    "expression": "input.customer_region ?? \"unassigned\""
                  },
                  {
                    "name": "amount",
                    "expression": "input.amount"
                  },
                  {
                    "name": "placed_at",
                    "expression": "input.placed_at"
                  }
                ]
              },
              "weekly": {
                "op": "aggregate",
                "input": "regional",
                "groupBy": [
                  {
                    "column": "region"
                  },
                  {
                    "column": "placed_at",
                    "grain": "week"
                  }
                ],
                "measures": [
                  {
                    "name": "revenue",
                    "fn": "sum",
                    "column": "amount"
                  },
                  {
                    "name": "orders",
                    "fn": "count"
                  },
                  {
                    "name": "largest",
                    "fn": "max",
                    "column": "amount"
                  }
                ]
              },
              "ranked": {
                "op": "window",
                "input": "weekly",
                "partitionBy": [
                  "region"
                ],
                "orderBy": [
                  {
                    "column": "placed_at",
                    "direction": "asc"
                  }
                ],
                "columns": [
                  {
                    "name": "week_number",
                    "fn": "row_number"
                  },
                  {
                    "name": "to_date",
                    "fn": "running_sum",
                    "column": "revenue"
                  },
                  {
                    "name": "previous_week",
                    "fn": "lag",
                    "column": "revenue"
                  }
                ]
              }
            }
          },
          "outputSchema": {},
          "maintenance": "recompute_on_read"
        }
      }
    ]
  },
