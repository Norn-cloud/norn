        "type": {
          "kind": "text"
        }
      },
      {
        "id": "kind",
        "type": {
          "kind": "enum",
          "values": [
            {
              "value": "erp"
            },
            {
              "value": "saas"
            },
            {
              "value": "database"
            },
            {
              "value": "file"
            },
            {
              "value": "api"
            }
          ]
        }
      }
    ],
