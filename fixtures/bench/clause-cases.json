{
  "format": "norn-bench/clause-cases@1",
  "cases": [
    {"id": "credit_sign", "seam": "law",
     "entities": [{"name": "bench.CreditNote", "props": {"id": "text", "currency": "text", "total": "money"}}],
     "actions": [{"id": "bench.credit.create", "on": "bench.CreditNote", "inputs": ["id", "currency", "total"]}],
     "laws": [{"id": "credit_sign", "on": "bench.CreditNote", "expression": "self.total <= 0", "text": "A credit note total is nonpositive"}],
     "valid": ["bench.credit.create", {"id": "ok", "currency": "USD", "total": -5}],
     "invalid": ["bench.credit.create", {"id": "bad", "currency": "USD", "total": 5}],
     "remove": "laws"},
    {"id": "paid_nonnegative", "seam": "law",
     "entities": [{"name": "bench.Payment", "props": {"id": "text", "currency": "text", "total": "money"}}],
     "actions": [{"id": "bench.payment.create", "on": "bench.Payment", "inputs": ["id", "currency", "total"]}],
     "laws": [{"id": "paid_nonnegative", "on": "bench.Payment", "expression": "self.total >= 0", "text": "A normal payment amount is nonnegative"}],
     "valid": ["bench.payment.create", {"id": "ok", "currency": "USD", "total": 0}],
     "invalid": ["bench.payment.create", {"id": "bad", "currency": "USD", "total": -1}],
     "remove": "laws"},
    {"id": "approval_stale", "seam": "law",
     "entities": [{"name": "bench.Doc", "props": {"id": "text", "status": "text", "amount": "qty", "approved_amount": "qty"}}],
     "actions": [{"id": "bench.doc.save", "on": "bench.Doc", "mode": "upsert", "inputs": ["id", "status", "amount", "approved_amount"]}],
     "laws": [{"id": "approval_stale", "on": "bench.Doc", "expression": "self.status != 'approved' or self.amount == self.approved_amount", "text": "Editing an approved amount invalidates its approval"}],
     "seed": [["bench.doc.save", {"id": "d", "status": "approved", "amount": 5, "approved_amount": 5}]],
     "valid": ["bench.doc.save", {"id": "d", "status": "draft", "amount": 6, "approved_amount": 5}],
     "invalid": ["bench.doc.save", {"id": "d", "status": "approved", "amount": 6, "approved_amount": 5}],
     "remove": "laws"},
    {"id": "approval", "seam": "action_precondition",
     "entities": [{"name": "bench.ApprovedDoc", "props": {"id": "text", "revision": "qty"}},
                  {"name": "bench.Approval", "props": {"id": "text", "doc": "text", "revision": "qty"}}],
     "actions": [{"id": "bench.approved_doc.create", "on": "bench.ApprovedDoc", "inputs": ["id", "revision"]},
                 {"id": "bench.approval.create", "on": "bench.Approval", "inputs": ["id", "doc", "revision"],
                  "slice": {"doc": ["bench.ApprovedDoc", "doc"]}, "pre": ["slice.doc.revision == input.revision"]}],
     "seed": [["bench.approved_doc.create", {"id": "d", "revision": 2}]],
     "valid": ["bench.approval.create", {"id": "ok", "doc": "d", "revision": 2}],
     "invalid": ["bench.approval.create", {"id": "bad", "doc": "d", "revision": 1}],
     "remove": "pre"},
    {"id": "cancel_dependencies", "seam": "action_precondition",
     "entities": [{"name": "bench.Bill", "props": {"id": "text", "status": "text", "payment": "text"},
                   "links": [{"id": "payments", "target": "bench.BillPayment", "cardinality": {"to": "many", "from": "one"}}]},
                  {"name": "bench.BillPayment", "props": {"id": "text", "status": "text"}}],
     "actions": [{"id": "bench.bill.create", "on": "bench.Bill", "inputs": ["id", "status", "payment"]},
                 {"id": "bench.bill_payment.create", "on": "bench.BillPayment", "inputs": ["id", "status"]},
                 {"id": "bench.bill.link", "on": "bench.Bill", "inputs": ["id", "status", "payment"],
                  "slice": {"payment": ["bench.BillPayment", "payment"]},
                  "createLinks": [{"link": "payments", "targetType": "bench.BillPayment", "targetIdField": "payment"}]},
                 {"id": "bench.bill.cancel", "on": "bench.Bill", "mode": "upsert", "inputs": ["id", "status", "payment"],
                  "sliceRaw": [{"name": "bill", "objectType": "bench.Bill", "key": {"property": {"from": "input", "property": "id"}}},
                               {"name": "payments", "objectType": "bench.BillPayment", "key": {"link": {"from": "bill", "link": "payments"}}}],
                  "pre": ["none(slice.payments, #.status == 'open')"]}],
     "seed": [["bench.bill.create", {"id": "free", "status": "open", "payment": ""}], ["bench.bill_payment.create", {"id": "p", "status": "open"}],
              ["bench.bill.link", {"id": "held", "status": "open", "payment": "p"}]],
     "valid": ["bench.bill.cancel", {"id": "free", "status": "cancelled", "payment": ""}],
     "invalid": ["bench.bill.cancel", {"id": "held", "status": "cancelled", "payment": "p"}],
     "remove": "pre"},
    {"id": "serial_unique", "seam": "identity",
     "entities": [{"name": "bench.SerialHolding", "props": {"id": "text", "serial": "text", "warehouse": "text"}, "keys": [["id"], ["serial"]]}],
     "actions": [{"id": "bench.serial.create", "on": "bench.SerialHolding", "inputs": ["id", "serial", "warehouse"]}],
     "seed": [["bench.serial.create", {"id": "h1", "serial": "S1", "warehouse": "A"}]],
     "valid": ["bench.serial.create", {"id": "h2", "serial": "S2", "warehouse": "B"}],
     "invalid": ["bench.serial.create", {"id": "h3", "serial": "S1", "warehouse": "B"}],
     "remove": "keys"},
    {"id": "batch_expiry", "seam": "action_precondition",
     "entities": [{"name": "bench.Batch", "props": {"id": "text", "expiry": "date"}},
                  {"name": "bench.Delivery", "props": {"id": "text", "batch": "text", "posted": "date"}}],
     "actions": [{"id": "bench.batch.create", "on": "bench.Batch", "inputs": ["id", "expiry"]},
                 {"id": "bench.delivery.create", "on": "bench.Delivery", "inputs": ["id", "batch", "posted"],
                  "slice": {"batch": ["bench.Batch", "batch"]}, "pre": ["date(slice.batch.expiry) >= date(input.posted)"]}],
     "seed": [["bench.batch.create", {"id": "b", "expiry": "2026-06-30"}]],
     "valid": ["bench.delivery.create", {"id": "ok", "batch": "b", "posted": "2026-06-30"}],
     "invalid": ["bench.delivery.create", {"id": "bad", "batch": "b", "posted": "2026-07-01"}],
     "remove": "pre"},
    {"id": "period_lock", "seam": "action_precondition",
     "entities": [{"name": "bench.Period", "props": {"id": "text", "status": "text"}},
                  {"name": "bench.Posting", "props": {"id": "text", "period": "text", "amount": "qty"}}],
     "actions": [{"id": "bench.period.create", "on": "bench.Period", "inputs": ["id", "status"]},
                 {"id": "bench.posting.create", "on": "bench.Posting", "inputs": ["id", "period", "amount"],
                  "slice": {"period": ["bench.Period", "period"]}, "pre": ["slice.period.status == 'open'"]}],
     "seed": [["bench.period.create", {"id": "open", "status": "open"}], ["bench.period.create", {"id": "closed", "status": "closed"}]],
     "valid": ["bench.posting.create", {"id": "ok", "period": "open", "amount": 1}],
     "invalid": ["bench.posting.create", {"id": "bad", "period": "closed", "amount": 1}],
     "remove": "pre"},
    {"id": "fiscal_year", "seam": "action_precondition",
     "entities": [{"name": "bench.FiscalYear", "props": {"id": "text", "active": "bool", "start": "date", "end": "date"}},
                  {"name": "bench.Voucher", "props": {"id": "text", "fy": "text", "posted": "date"}}],
     "actions": [{"id": "bench.fy.create", "on": "bench.FiscalYear", "inputs": ["id", "active", "start", "end"]},
                 {"id": "bench.voucher.create", "on": "bench.Voucher", "inputs": ["id", "fy", "posted"],
                  "slice": {"fy": ["bench.FiscalYear", "fy"]},
                  "pre": ["slice.fy.active and date(input.posted) >= date(slice.fy.start) and date(input.posted) <= date(slice.fy.end)"]}],
     "seed": [["bench.fy.create", {"id": "fy", "active": true, "start": "2026-01-01", "end": "2026-12-31"}]],
     "valid": ["bench.voucher.create", {"id": "ok", "fy": "fy", "posted": "2026-12-31"}],
     "invalid": ["bench.voucher.create", {"id": "bad", "fy": "fy", "posted": "2027-01-01"}],
     "remove": "pre"},
    {"id": "account_currency", "seam": "action_precondition",
     "entities": [{"name": "bench.Account", "props": {"id": "text", "company": "text", "currency": "text"}},
                  {"name": "bench.Entry", "props": {"id": "text", "account": "text", "company": "text", "currency": "text"}}],
     "actions": [{"id": "bench.account.create", "on": "bench.Account", "inputs": ["id", "company", "currency"]},
                 {"id": "bench.entry.create", "on": "bench.Entry", "inputs": ["id", "account", "company", "currency"],
                  "slice": {"account": ["bench.Account", "account"]},
                  "pre": ["slice.account.company == input.company and slice.account.currency == input.currency"]}],
     "seed": [["bench.account.create", {"id": "a", "company": "C", "currency": "EGP"}]],
     "valid": ["bench.entry.create", {"id": "ok", "account": "a", "company": "C", "currency": "EGP"}],
     "invalid": ["bench.entry.create", {"id": "bad", "account": "a", "company": "C", "currency": "USD"}],
     "remove": "pre"},
    {"id": "return_cost", "seam": "action_precondition",
     "entities": [{"name": "bench.Allocation", "props": {"id": "text", "value": "qty"}},
                  {"name": "bench.ReturnLine", "props": {"id": "text", "allocation": "text", "value": "qty"}}],
     "actions": [{"id": "bench.allocation.create", "on": "bench.Allocation", "inputs": ["id", "value"]},
                 {"id": "bench.return.create", "on": "bench.ReturnLine", "inputs": ["id", "allocation", "value"],
                  "slice": {"allocation": ["bench.Allocation", "allocation"]}, "pre": ["input.value == slice.allocation.value"]}],
     "seed": [["bench.allocation.create", {"id": "a", "value": 60}]],
     "valid": ["bench.return.create", {"id": "ok", "allocation": "a", "value": 60}],
     "invalid": ["bench.return.create", {"id": "bad", "allocation": "a", "value": 70}],
     "remove": "pre"},
    {"id": "reconcile", "seam": "law_and_precondition",
     "entities": [{"name": "bench.Stock", "props": {"id": "text", "quantity": "qty"}},
                  {"name": "bench.Reconciliation", "props": {"id": "text", "stock": "text", "book": "qty", "counted": "qty", "variance": "qty"}}],
     "actions": [{"id": "bench.stock.create", "on": "bench.Stock", "inputs": ["id", "quantity"]},
                 {"id": "bench.reconciliation.create", "on": "bench.Reconciliation", "inputs": ["id", "stock", "book", "counted", "variance"],
                  "slice": {"stock": ["bench.Stock", "stock"]}, "pre": ["input.book == slice.stock.quantity"]}],
     "laws": [{"id": "reconcile", "on": "bench.Reconciliation", "expression": "self.counted == self.book + self.variance", "text": "Reconciliation adjustments account for variance"}],
     "seed": [["bench.stock.create", {"id": "s", "quantity": 10}]],
     "valid": ["bench.reconciliation.create", {"id": "ok", "stock": "s", "book": 10, "counted": 8, "variance": -2}],
     "invalid": ["bench.reconciliation.create", {"id": "bad", "stock": "s", "book": 10, "counted": 8, "variance": 0}],
     "remove": "laws"},
    {"id": "rounding", "seam": "action_precondition",
     "entities": [{"name": "bench.Config", "props": {"id": "text", "method": "text"}},
                  {"name": "bench.Invoice", "props": {"id": "text", "config": "text", "net": "dec3", "total": "dec2"}}],
     "actions": [{"id": "bench.config.create", "on": "bench.Config", "inputs": ["id", "method"]},
                 {"id": "bench.invoice.create", "on": "bench.Invoice", "inputs": ["id", "config", "net", "total"],
                  "slice": {"config": ["bench.Config", "config"]},
                  "pre": ["(slice.config.method == 'half_even' and input.total == round(input.net, 2, 'half_even')) or (slice.config.method == 'half_away' and input.total == round(input.net, 2, 'half_away_from_zero'))"]}],
     "seed": [["bench.config.create", {"id": "c", "method": "half_even"}]],
     "valid": ["bench.invoice.create", {"id": "ok", "config": "c", "net": 1.125, "total": 1.12}],
     "invalid": ["bench.invoice.create", {"id": "bad", "config": "c", "net": 1.125, "total": 1.13}],
     "remove": "pre"}
  ],
  "unsupported_probes": [
    {"id": "stock_gl", "on": "bench.StockMove", "expression": "self.value == slice.gl.amount", "text": "Stock value changes agree with inventory GL postings"},
    {"id": "before_after_law", "on": "bench.StockMove", "expression": "self.value == before.value", "text": "Prior-revision law"}
  ]
}
