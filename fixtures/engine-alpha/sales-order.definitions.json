    "dependencies": [],
    "irVersion": "0.1",
    "kind": "entity",
    "lifecycle": "draft",
    "name": "Alpha sales order",
    "namespace": "alpha",
    "payload": {
      "entityVersion": "2.0",
      "objectType": {
        "controls": {
          "format": "norn.controls/1",
          "sensitivePaths": [
            {
              "actions": [
                "alpha.order.approve",
                "alpha.order.record_invoice",
                "alpha.order.record_payment"
              ],
              "objectType": "alpha.SalesOrder"
            }
          ]
        },
        "identity": [
          {
            "name": "primary",
            "properties": [
              "id"
            ]
          }
        ],
        "lifecycles": [
          {
            "initial": [
              "draft"
            ],
            "property": "status",
            "terminal": [
              "cancelled"
            ],
            "transitions": [
              {
                "from": [
                  "draft"
                ],
                "id": "submit",
                "to": "submitted"
              },
              {
                "from": [
                  "submitted"
                ],
                "id": "approve",
                "to": "approved"
              },
              {
                "from": [
                  "draft",
                  "submitted",
                  "approved"
                ],
                "guards": [
                  "self.invoice_count == 0 and self.allocated_total == 0"
                ],
                "id": "cancel",
                "to": "cancelled"
              }
            ]
          }
        ],
        "links": [
          {
            "cardinality": {
              "from": "many",
              "required": true,
              "to": "one"
            },
            "id": "counterparty",
            "target": "alpha.Customer"
          }
        ],
        "name": "alpha.SalesOrder",
        "properties": [
          {
            "id": "id",
            "type": {
              "kind": "text"
            }
          },
          {
            "id": "order_number",
            "type": {
              "kind": "text"
            }
          },
          {
            "id": "order_date",
            "type": {
              "kind": "date"
            }
          },
          {
            "id": "currency",
            "type": {
              "kind": "enum",
              "values": [
                {
                  "value": "EGP"
                },
                {
                  "value": "USD"
                },
                {
                  "value": "EUR"
                }
              ]
            }
          },
          {
            "id": "total_amount",
            "type": {
              "kind": "decimal",
              "scale": 2
            }
          },
          {
            "default": "draft",
            "id": "status",
            "type": {
              "kind": "enum",
              "values": [
                {
                  "value": "draft"
                },
                {
                  "value": "submitted"
                },
                {
                  "value": "approved"
                },
                {
                  "value": "cancelled"
                }
              ]
            }
          },
          {
            "default": "0",
            "id": "invoice_count",
            "protected": true,
            "type": {
              "kind": "integer"
            }
          },
          {
            "default": "0",
            "id": "invoiced_total",
            "protected": true,
            "type": {
              "kind": "decimal",
              "scale": 2
            }
          },
          {
            "default": "0",
            "id": "allocated_total",
            "protected": true,
            "type": {
              "kind": "decimal",
              "scale": 2
            }
          },
          {
            "computed": "self.invoice_count > 0",
            "id": "invoiced",
            "type": {
              "kind": "boolean"
            }
          },
          {
            "computed": "self.invoice_count > 0 and self.allocated_total >= self.invoiced_total",
            "id": "completed",
            "type": {
              "kind": "boolean"
            }
          },
          {
            "computed": "self.invoiced_total - self.allocated_total",
            "id": "outstanding",
            "type": {
              "kind": "decimal",
              "scale": 2
            }
          }
        ]
      }
    },
    "provenance": {
      "source": "authoring_sdk",
