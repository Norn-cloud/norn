  {
    "artifactId": "alpha.SalesOrder.entity",
    "dependencies": [],
    "irVersion": "0.1",
    "kind": "entity",
    "lifecycle": "draft",
    "name": "Alpha sales order",
    "namespace": "alpha",
    "payload": {
      "entityVersion": "2.0",
      "objectType": {
        "extends": "commerce.SalesOrder",
        "lifecycles": [
          {
            "initial": [
              "draft"
            ],
            "property": "status",
            "terminal": [
              "cancelled"
            ],
            "transitions": [
              {
                "from": [
                  "draft"
                ],
                "id": "submit",
                "to": "submitted"
              },
              {
                "from": [
                  "submitted"
                ],
                "id": "approve",
                "to": "approved"
              },
              {
                "from": [
                  "draft",
                  "submitted",
                  "approved"
                ],
                "guards": [
                  "self.invoice_count == 0"
                ],
                "id": "cancel",
                "to": "cancelled"
              }
            ]
          }
        ],
        "name": "alpha.SalesOrder",
        "properties": [
          {
            "default": "draft",
            "id": "status",
            "type": {
              "kind": "enum",
              "values": [
                {
                  "value": "draft"
                },
                {
                  "value": "submitted"
                },
                {
                  "value": "approved"
                },
                {
                  "value": "cancelled"
                }
              ]
            }
          },
          {
            "default": "0",
            "id": "invoice_count",
            "type": {
              "kind": "integer"
            }
          },
          {
            "default": "0",
            "id": "invoiced_total",
            "type": {
              "kind": "decimal",
              "scale": 2
            }
          },
          {
            "default": "0",
            "id": "allocated_total",
            "type": {
              "kind": "decimal",
              "scale": 2
            }
          },
          {
            "computed": "self.invoice_count > 0",
            "id": "invoiced",
            "type": {
              "kind": "boolean"
            }
          },
          {
            "computed": "self.invoice_count > 0 and self.allocated_total >= self.invoiced_total",
            "id": "completed",
            "type": {
              "kind": "boolean"
            }
          },
          {
            "computed": "self.invoiced_total - self.allocated_total",
            "id": "outstanding",
            "type": {
              "kind": "decimal",
              "scale": 2
            }
          }
        ]
      }
    },
    "provenance": {
      "source": "authoring_sdk",
      "sourcePath": "tools/norn-ts/fixtures/engine-alpha/sales-order.source.ts"
    },
    "scope": {
      "environmentId": "dev",
      "orgId": "org_alpha"
    },
    "version": "0.1.0"
  },
