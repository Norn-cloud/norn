          "left": {
            "map": "order",
            "mapping": {
              "artifactId": "shop.erp.mapping",
              "version": "0.1.0"
            },
            "record": {
              "grand_total": 114,
              "name": "SO-1"
            }
          },
          "right": {
            "map": "order",
            "mapping": {
              "artifactId": "shop.storefront.mapping",
              "version": "0.1.0"
            },
            "record": {
              "id": "1001",
              "subtotal_price": 100,
              "total_price": 114
            }
          },
          "target": {
            "artifactId": "shop.Order.entity",
            "member": {
              "kind": "property",
              "property": "total",
              "typeName": "shop.Order"
            },
            "version": "0.1.0"
          }
        }
