  "tlc": "1.8.0",
  "toolingNotes": [
    "quint 0.32.0 `compile --target tlaplus` prints `x = LET .. IN ApaFoldSet(..) /\\ Q`, so the LET swallows Q; a lambda fold must end its conjunction. Apalache 0.56.1 rejects a named fold function from an imported module (`Expected F to be a binary operator passed by name`)."
  ],
  "round": "review round 2 (Fable CHANGES on 4f5621c2)",
  "fairnessHonoured": {
    "cell-lifecycle": {
      "reconcileF": "not honoured on main: perform() returns PerformOutcomeUnknown and claim_reconciled_perform needs a caller-ledgered authorization, so reconciliation is a manual policy step; the provider lookup-and-fence (A2) does not exist",
      "reopenF": "needs something to wake an evicted cell while a claim is pending",
      "timeoutF": "needs a per-call timeout",
      "execF": "environment assumption"
    },
    "offline-leases": {
      "healF": "environmental: a partitioned device is assumed to return; factApplied rests on it",
      "tickF/escalateF": "shortfallResolves needs only these, so it states that the deadline fires, not that a shortfall is resolved"
    },
    "cross-cell-commitment": {
      "all": "honourable if the source re-sends its query until answered; the model gets that because delivery never removes a message; no cell crash is modelled"
    }
  }
