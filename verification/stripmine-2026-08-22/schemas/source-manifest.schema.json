{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norn.cloud/schemas/verification/source-manifest-v1.json",
  "title": "Norn verification source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "retrieved_at", "sources"],
  "properties": {
    "manifest_version": { "const": "norn.verification.sources.v1" },
    "retrieved_at": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "purpose"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "kind", "locator", "version", "license",
        "intake", "trust", "refs"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "repository", "paper", "standard", "law", "official-guidance",
            "ontology", "taxonomy", "internal-corpus", "tool"
          ]
        },
        "locator": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "license": { "type": "string", "minLength": 1 },
        "intake": {
          "enum": [
            "adopt-code", "adopt-tests", "mine-semantics", "map-vocabulary",
            "reference-only", "tool-evaluation"
          ]
        },
        "trust": {
          "enum": [
            "authoritative-normative", "authoritative-technical",
            "executable-reference", "comparative-evidence", "untrusted-input"
          ]
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "caveats": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
