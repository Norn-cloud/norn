{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norn.cloud/schemas/verification/obligation-registry-v1.json",
  "title": "Norn verification obligation registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "obligations"],
  "properties": {
    "registry_version": { "const": "norn.verification.obligations.v1" },
    "obligations": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": { "$ref": "#/$defs/obligation" }
    }
  },
  "$defs": {
    "sourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "claim"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
        "ref": { "type": "string" },
        "claim": { "type": "string", "minLength": 1 }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "artifact", "acceptance"],
      "properties": {
        "lane": {
          "enum": [
            "rust-types", "runtime", "db-constraint", "property-test",
            "differential-test", "kani", "quint", "lean", "verus",
            "aeneas-probe", "hax-probe", "owl-reasoner", "shacl",
            "external-conformance", "human-ratification"
          ]
        },
        "artifact": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "string", "minLength": 1 }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "domain", "priority", "kind", "statement", "owner",
        "assumptions", "sources", "checkers", "counterexamples", "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^INV-[A-Z0-9-]+$" },
        "domain": {
          "enum": [
            "authority", "quantity-ledger", "accounting", "inventory",
            "authorization", "artifact-governance", "ontology", "localization", "verification-meta",
            "rules-policy", "welldb"
          ]
        },
        "priority": { "enum": ["P0", "P1", "P2"] },
        "kind": { "enum": ["safety", "liveness", "refinement", "conformance", "governance"] },
        "statement": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/sourceLink" } },
        "checkers": { "type": "array", "items": { "$ref": "#/$defs/checker" } },
        "counterexamples": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "implementation_bindings": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["candidate", "specified", "modeled", "proved", "implemented", "blocked", "planned"] }
      },
      "allOf": [{
        "if": { "properties": { "id": { "const": "INV-WELLDB-ORACLE-PARITY" } } },
        "then": { "properties": {
          "domain": { "const": "welldb" },
          "status": { "const": "planned" },
          "sources": { "maxItems": 0 },
          "checkers": { "maxItems": 0 }
        } },
        "else": { "properties": {
          "domain": { "not": { "const": "welldb" } },
          "status": { "not": { "const": "planned" } },
          "sources": { "minItems": 1 },
          "checkers": { "minItems": 1 }
        } }
      }]
    }
  }
}
