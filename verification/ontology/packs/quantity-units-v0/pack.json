    "terms": [
      {
        "termId": "norn.measure.quantity-kind",
        "label": "Quantity Kind",
        "definition": "A Norn-owned classification of the comparable property represented by a quantity.",
        "termKind": "concept_scheme_root",
        "status": "active",
        "semanticAuthority": "semantic_only"
      },
      {
        "termId": "norn.measure.quantity-kind.count",
        "label": "Count",
        "definition": "A Norn quantity kind for a discrete number of items.",
        "termKind": "value_object",
        "status": "active",
        "semanticAuthority": "semantic_only",
        "parentTermId": "norn.measure.quantity-kind"
      },
      {
        "termId": "norn.measure.quantity-kind.mass",
        "label": "Mass",
        "definition": "A Norn quantity kind for mass-valued observations and commitments.",
        "termKind": "value_object",
        "status": "active",
        "semanticAuthority": "semantic_only",
        "parentTermId": "norn.measure.quantity-kind"
      },
      {
        "termId": "norn.measure.quantity-kind.duration",
        "label": "Duration",
        "definition": "A Norn quantity kind for elapsed time intervals, excluding time-point identity.",
        "termKind": "value_object",
        "status": "active",
        "semanticAuthority": "semantic_only",
        "parentTermId": "norn.measure.quantity-kind"
      },
      {
        "termId": "norn.measure.quantity-kind.ratio",
        "label": "Ratio",
        "definition": "A Norn quantity kind for a dimensionless ratio of like quantities.",
        "termKind": "value_object",
        "status": "active",
        "semanticAuthority": "semantic_only",
        "parentTermId": "norn.measure.quantity-kind"
      },
      {
        "termId": "norn.measure.unit",
        "label": "Unit",
        "definition": "A Norn-owned unit identity associated with a quantity kind; conversion is outside this ontology pack.",
        "termKind": "concept_scheme_root",
        "status": "active",
        "semanticAuthority": "semantic_only"
      },
      {
        "termId": "norn.measure.unit.count",
        "label": "Count Unit",
        "definition": "A Norn unit identity for discrete counts.",
        "termKind": "value_object",
        "status": "active",
        "semanticAuthority": "semantic_only",
        "parentTermId": "norn.measure.unit"
      },
      {
        "termId": "norn.measure.unit.kilogram",
        "label": "Kilogram",
        "definition": "A Norn unit identity for mass values represented as kilograms; no conversion rule is declared here.",
        "termKind": "value_object",
        "status": "active",
        "semanticAuthority": "semantic_only",
        "parentTermId": "norn.measure.unit"
      },
      {
        "termId": "norn.measure.unit.gram",
        "label": "Gram",
        "definition": "A Norn unit identity for mass values represented as grams; no conversion rule is declared here.",
        "termKind": "value_object",
        "status": "active",
        "semanticAuthority": "semantic_only",
        "parentTermId": "norn.measure.unit"
      },
      {
        "termId": "norn.measure.unit.hour",
        "label": "Hour",
        "definition": "A Norn unit identity for durations represented as hours; no conversion rule is declared here.",
        "termKind": "value_object",
        "status": "active",
        "semanticAuthority": "semantic_only",
        "parentTermId": "norn.measure.unit"
      },
      {
        "termId": "norn.measure.unit.fraction",
        "label": "Fraction",
        "definition": "A Norn unit identity for a dimensionless ratio expressed as a whole-scaled fraction.",
        "termKind": "value_object",
        "status": "active",
        "semanticAuthority": "semantic_only",
        "parentTermId": "norn.measure.unit"
      },
      {
        "termId": "norn.measure.unit.percent",
        "label": "Percent",
        "definition": "A Norn unit identity for a dimensionless ratio expressed in percent form; no scale factor is declared here.",
        "termKind": "value_object",
        "status": "active",
        "semanticAuthority": "semantic_only",
        "parentTermId": "norn.measure.unit"
      }
    ],
