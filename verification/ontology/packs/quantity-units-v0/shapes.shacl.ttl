@prefix norn: <https://norn.dev/ontology/quantity-units/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL 1.0 differential-oracle projection. The Rust Norn IR checker is the
# promotion authority; conformance here never grants a capability, commits a
# transition, or authorizes a quantity conversion.

norn:QuantityKindShape a sh:NodeShape ; sh:targetClass norn:QuantityKind ; sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path norn:code ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path norn:label ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

norn:CountQuantityKindShape a sh:NodeShape ; sh:targetClass norn:CountQuantityKind ; sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path norn:code ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path norn:label ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

norn:MassQuantityKindShape a sh:NodeShape ; sh:targetClass norn:MassQuantityKind ; sh:closed true ;
