norn:UnitShape a sh:NodeShape ; sh:targetClass norn:Unit ; sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path norn:symbol ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path norn:quantityKind ; sh:class norn:QuantityKind ; sh:minCount 1 ; sh:maxCount 1 ] .
norn:CountUnitShape a sh:NodeShape ; sh:targetClass norn:CountUnit ; sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path norn:symbol ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path norn:quantityKind ; sh:class norn:QuantityKind ; sh:minCount 1 ; sh:maxCount 1 ] .

