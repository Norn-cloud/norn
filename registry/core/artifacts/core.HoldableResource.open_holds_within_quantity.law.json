  "lifecycle": "active",
  "name": "Open holds against a resource never exceed its available quantity",
  "namespace": "core",
  "payload": {
    "condition": "len(self.holds) > 0",
    "id": "core.HoldableResource.open_holds_within_quantity",
    "lawVersion": "0.1",
    "modality": {
      "kind": "always"
    },
    "owner": "core",
