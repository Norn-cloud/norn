{
  "artifactId": "core.EconomicEvent.interface",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "entity",
  "lifecycle": "active",
  "name": "Economic event",
  "namespace": "core",
  "payload": {
    "entityVersion": "2.0",
    "interface": {
      "description": "A posted change of resources. A transfer moves ownership or custody from provider to receiver; a transformation consumes inputs and produces outputs. Posted events are immutable; a correction is a new event that reverses its original.",
      "links": [
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "The agent giving up the resource, or performing the transformation.",
          "id": "provider",
          "target": "core.Agent"
        },
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "The agent receiving the resource; for a transformation, the agent the output belongs to.",
          "id": "receiver",
          "target": "core.Agent"
        },
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "The resource moved, consumed or produced.",
          "id": "resource",
          "target": "core.Resource"
        },
        {
          "cardinality": {
            "from": "many",
            "to": "one"
          },
          "description": "The commitment this event fulfils, in whole or in part.",
          "id": "fulfils",
          "target": "core.Commitment"
        },
        {
          "cardinality": {
            "from": "one",
            "to": "one"
          },
          "description": "The posted event this event exactly reverses.",
          "id": "reverses",
          "target": "core.EconomicEvent"
        }
      ],
      "name": "core.EconomicEvent",
      "properties": [
        {
          "id": "action",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "transfer_ownership"
              },
              {
                "value": "transfer_custody"
              },
              {
                "value": "consume"
              },
              {
                "value": "produce"
              }
            ]
          }
        },
        {
          "id": "occurred_at",
          "type": {
            "kind": "ref",
            "name": "iso8601.timestamp"
          }
        },
        {
          "id": "quantity",
          "type": {
            "kind": "ref",
            "name": "core.quantity"
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "unit",
          "type": {
            "kind": "ref",
            "name": "ucum.unit_code"
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "currency",
          "type": {
            "kind": "ref",
            "name": "core.code"
          }
        }
      ]
    }
  },
  "provenance": {
    "source": "system",
