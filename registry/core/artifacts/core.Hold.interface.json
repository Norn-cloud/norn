{
  "artifactId": "core.Hold.interface",
  "dependencies": [
    {
      "artifactId": "core.value_types.entity",
      "kind": "entity",
      "required": true,
      "version": "0.2.0"
    },
    {
      "artifactId": "std.value_types.entity",
      "kind": "entity",
      "required": true,
      "version": "0.2.0"
    }
  ],
  "irVersion": "0.1",
  "kind": "entity",
  "lifecycle": "active",
  "name": "Hold",
  "namespace": "core",
  "payload": {
    "entityVersion": "2.0",
    "interface": {
      "description": "A quantity set aside against a balance: an escrow, a stock reservation or a use of a quota. A hold is released, consumed or expires, and never exceeds what is available (core.law.escrow_non_negative).",
      "invariants": [
        {
          "expression": "self.quantity > 0",
          "id": "positive_quantity",
          "message": "A hold quantity must be strictly positive."
        },
        {
          "expression": "((self.unit != null) and (self.currency == null)) or ((self.unit == null) and (self.currency != null))",
          "id": "single_measure",
          "message": "A hold must carry either a unit or a currency, never both or neither."
        }
      ],
      "lifecycles": [
        {
          "endings": [
            {
              "outcome": "completed",
              "state": "consumed"
            },
            {
              "outcome": "compensated",
              "state": "released"
            },
            {
              "outcome": "cancelled",
              "state": "expired"
            }
          ],
          "immutable": [
            "released",
            "consumed",
            "expired"
          ],
          "initial": [
            "open"
          ],
          "property": "status",
          "terminal": [
            "released",
            "consumed",
            "expired"
          ],
          "transitions": [
            {
              "from": [
                "open"
              ],
              "id": "consume",
              "to": "consumed"
            },
            {
              "from": [
                "open"
              ],
              "id": "release",
              "to": "released"
            },
            {
              "from": [
                "open"
              ],
              "id": "expire",
              "to": "expired"
            }
          ]
        }
      ],
      "links": [
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "The resource held.",
          "id": "resource",
          "target": "core.Resource"
        },
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "The agent the quantity is held for.",
          "id": "holder",
          "target": "core.Agent"
        },
        {
          "cardinality": {
            "from": "many",
            "to": "one"
          },
          "description": "The commitment the hold secures, if any.",
          "id": "secures",
          "target": "core.Commitment"
        }
      ],
      "name": "core.Hold",
      "properties": [
        {
          "id": "status",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "open"
              },
              {
                "value": "released"
              },
              {
                "value": "consumed"
              },
              {
                "value": "expired"
              }
            ]
          }
        },
        {
          "id": "quantity",
          "type": {
            "kind": "ref",
            "name": "core.quantity"
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "unit",
          "type": {
            "kind": "ref",
            "name": "ucum.unit_code"
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "currency",
          "type": {
            "kind": "ref",
            "name": "core.code"
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "expires_at",
          "type": {
            "kind": "ref",
            "name": "iso8601.timestamp"
          }
        }
      ],
      "role": "happening"
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/core/artifacts/core.Hold.interface.json"
  },
  "scope": {},
  "version": "0.2.0"
}
