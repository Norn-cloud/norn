  "kind": "entity",
  "lifecycle": "active",
  "name": "Claim",
  "namespace": "core",
  "payload": {
    "entityVersion": "2.0",
    "interface": {
      "description": "An economic claim: a right to receive resources, such as an invoice or a receivable, settled by economic events. Not a catalog claim about definitions. Disjoint from core.Commitment (Commitment ⊓ Claim = ∅): a promise is not yet a right, and no type is both. A fulfilled or accepted commitment gives rise to claims (givesRiseTo); the relation is recorded on the claim as `arises_from`, because a commitment is not edited when a claim arises.",
      "links": [
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "The agent entitled to receive.",
          "id": "creditor",
          "target": "core.Agent"
        },
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "The agent obliged to give.",
          "id": "debtor",
          "target": "core.Agent"
        },
        {
          "cardinality": {
            "from": "many",
            "to": "one"
          },
          "description": "The commitment that gave rise to the claim (givesRiseTo, seen from the claim).",
          "id": "arises_from",
          "target": "core.Commitment"
        }
      ],
      "name": "core.Claim",
      "properties": [
        {
          "id": "amount",
          "type": {
            "kind": "ref",
            "name": "core.money_amount"
          }
        },
        {
          "id": "currency",
          "type": {
            "kind": "ref",
            "name": "core.code"
          }
        },
        {
          "id": "due_date",
          "type": {
            "kind": "ref",
            "name": "iso8601.date"
          }
        }
      ]
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/core/artifacts/core.Claim.interface.json"
  },
