    "entityVersion": "2.0",
    "interface": {
      "invariants": [
        {
          "expression": "(self.status != 'published') or (((((((((((((((((((((((((((((((((((self.receipt_digest != '') and (self.table_version != '')) and (self.table_digest != '')) and (self.source_digest != '')) and (self.result_table_version == self.table_version)) and (self.result_table_digest == self.table_digest)) and (self.result_source_digest == self.source_digest)) and (self.result_split_at_ms == self.split_at_ms)) and (self.model_digest != '')) and (self.parameters_digest != '')) and (self.result_model_digest == self.model_digest)) and (self.result_parameters_digest == self.parameters_digest)) and self.complete) and (self.quarantined_count == 0)) and self.fresh) and (self.frontier_age_ms >= 0)) and (self.max_frontier_age_ms >= 0)) and (self.frontier_age_ms <= self.max_frontier_age_ms)) and (not self.temporal_leakage)) and (self.late_feature_count == 0)) and (self.latest_training_label_ms < self.split_at_ms)) and (self.training_count > 0)) and (self.holdout_count > 0)) and (self.non_forward_outcome_count == 0)) and (self.holdout_error_nanos != null)) and ((self.holdout_error_nanos ?? -1) >= 0)) and (self.holdout_error_limit_nanos >= 0)) and ((self.holdout_error_nanos ?? -1) <= self.holdout_error_limit_nanos)) and (self.error_unit != '')) and (self.error_unit == self.result_error_unit)) and (self.assumptions_digest != '')) and (self.assumptions_digest == self.result_assumptions_digest)) and (self.remedy_digest != '')) and (self.remedy_digest == self.result_remedy_digest)) and (self.diagnostics_passed or (self.mode == 'descriptive')))",
          "id": "publication_policy",
          "message": "Analytical publication requires matching qualified evidence."
        }
      ],
