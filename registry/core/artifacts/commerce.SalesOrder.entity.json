{
  "artifactId": "commerce.SalesOrder.entity",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "entity",
  "lifecycle": "active",
  "name": "SalesOrder",
  "namespace": "commerce",
  "payload": {
    "entityVersion": "2.0",
    "objectType": {
      "description": "An order a customer places with the business.",
      "identity": [
        {
          "name": "primary",
          "properties": [
            "order_number"
          ]
        }
      ],
      "implements": [
        "core.Order"
      ],
      "lifecycles": [
        {
          "description": "ERPNext-style sales order: submit, approve or hold, invoice, complete. `amend` returns a submitted or held order to draft; ERPNext's cancel-then-amend copy is a new order linked through amended_from.",
          "initial": [
            "draft"
          ],
          "property": "status",
          "terminal": [
            "completed",
            "cancelled"
          ],
          "transitions": [
            {
              "from": [
                "draft"
              ],
              "id": "submit",
              "to": "submitted"
            },
            {
              "from": [
                "submitted",
                "on_hold"
              ],
              "id": "approve",
              "to": "approved"
            },
            {
              "from": [
                "submitted",
                "approved"
              ],
              "id": "hold",
              "to": "on_hold"
            },
            {
              "description": "Revise the order before approval.",
              "from": [
                "submitted",
                "on_hold"
              ],
              "id": "amend",
              "to": "draft"
            },
            {
              "from": [
                "approved"
              ],
              "id": "invoice",
              "to": "invoiced"
            },
            {
              "from": [
                "invoiced"
              ],
              "id": "complete",
              "to": "completed"
            },
            {
              "from": [
                "draft",
                "submitted",
                "on_hold",
                "approved"
              ],
              "id": "cancel",
              "to": "cancelled"
            }
          ]
        }
      ],
      "links": [
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "id": "counterparty",
          "target": "party.Customer"
        },
        {
          "cardinality": {
            "from": "one",
            "to": "many"
          },
          "id": "lines",
          "target": "commerce.SalesOrderLine"
        },
        {
          "cardinality": {
            "from": "one",
            "to": "one"
          },
          "description": "The order this one amends, if any.",
          "id": "amended_from",
          "target": "commerce.SalesOrder"
        }
      ],
      "name": "commerce.SalesOrder",
      "properties": [
        {
          "id": "order_number",
          "type": {
            "kind": "ref",
            "name": "core.document_number"
          }
        },
        {
          "id": "order_date",
          "type": {
            "kind": "ref",
            "name": "iso8601.date"
          }
        },
        {
          "id": "currency",
          "type": {
            "kind": "ref",
            "name": "iso4217.currency_code"
          }
        },
        {
          "id": "total_amount",
          "type": {
            "kind": "ref",
            "name": "core.money_amount"
          }
        },
        {
          "default": "draft",
          "id": "status",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "draft"
              },
              {
                "value": "submitted"
              },
              {
                "value": "on_hold"
              },
              {
                "value": "approved"
              },
              {
                "value": "invoiced"
              },
              {
                "value": "completed"
              },
              {
                "value": "cancelled"
              }
            ]
          }
        }
      ]
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/core/artifacts/commerce.SalesOrder.entity.json"
  },
  "scope": {},
  "version": "0.1.0"
}
