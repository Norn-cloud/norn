{
  "artifactId": "core.analytics.Publication.entity",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "entity",
  "lifecycle": "active",
  "name": "Analytical publication",
  "namespace": "core.analytics",
  "payload": {
    "entityVersion": "2.0",
    "objectType": {
      "identity": [
        {
          "name": "primary",
          "properties": [
            "id"
          ]
        }
      ],
      "implements": [
        "core.analytics.PublicationEvidence"
      ],
      "lifecycles": [
        {
          "initial": [
            "proposed"
          ],
          "property": "status",
          "terminal": [
            "published",
            "refused"
          ],
          "transitions": [
            {
              "from": [
                "proposed"
              ],
              "guardRefusalCode": "core.projection.publication_guard",
              "guards": [
                "self.receipt_digest != ''",
                "((((((self.table_version != '') and (self.table_digest != '')) and (self.source_digest != '')) and (self.result_table_version == self.table_version)) and (self.result_table_digest == self.table_digest)) and (self.result_source_digest == self.source_digest)) and (self.result_split_at_ms == self.split_at_ms)",
                "(((self.model_digest != '') and (self.parameters_digest != '')) and (self.result_model_digest == self.model_digest)) and (self.result_parameters_digest == self.parameters_digest)",
                "self.complete and (self.quarantined_count == 0)",
                "((self.fresh and (self.frontier_age_ms >= 0)) and (self.max_frontier_age_ms >= 0)) and (self.frontier_age_ms <= self.max_frontier_age_ms)",
                "not self.temporal_leakage",
                "self.late_feature_count == 0",
                "self.latest_training_label_ms < self.split_at_ms",
                "((self.training_count > 0) and (self.holdout_count > 0)) and (self.non_forward_outcome_count == 0)",
                "(((((self.holdout_error_nanos != null) and ((self.holdout_error_nanos ?? -1) >= 0)) and (self.holdout_error_limit_nanos >= 0)) and ((self.holdout_error_nanos ?? -1) <= self.holdout_error_limit_nanos)) and (self.error_unit != '')) and (self.error_unit == self.result_error_unit)",
                "((((self.assumptions_digest != '') and (self.assumptions_digest == self.result_assumptions_digest)) and (self.remedy_digest != '')) and (self.remedy_digest == self.result_remedy_digest)) and (self.diagnostics_passed or (self.mode == 'descriptive'))"
              ],
              "id": "publish",
              "to": "published"
            },
            {
              "from": [
                "proposed"
              ],
              "id": "refuse",
              "to": "refused"
            }
          ]
        }
      ],
      "name": "core.analytics.Publication",
      "properties": [
        {
          "id": "id",
          "type": {
            "kind": "text"
          }
        },
        {
          "default": "proposed",
          "id": "status",
