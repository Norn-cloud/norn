{
  "artifactId": "core.Conversion.interface",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "entity",
  "lifecycle": "active",
  "name": "Conversion",
  "namespace": "core",
  "payload": {
    "entityVersion": "2.0",
    "interface": {
      "description": "A measured conversion whose quantities share the implementor's explicit unit and scale. These are accepted measurements, not a certificate of associated stock or value effects.",
      "extends": [
        "core.Process"
      ],
      "invariants": [
        {
          "expression": "(((self.input_quantity >= 0) and (self.output_quantity >= 0)) and (self.loss_quantity >= 0)) and (self.input_quantity == (self.output_quantity + self.loss_quantity))",
          "id": "conversion_conservation",
          "message": "Input quantity must equal output plus explicitly recorded loss in the same unit."
        }
      ],
      "name": "core.Conversion",
      "properties": [
        {
          "id": "input_quantity",
          "type": {
            "group": "conversion",
            "kind": "decimal-binding"
          }
        },
        {
          "id": "output_quantity",
          "type": {
            "group": "conversion",
            "kind": "decimal-binding"
          }
        },
        {
          "id": "loss_quantity",
          "type": {
            "group": "conversion",
            "kind": "decimal-binding"
          }
        }
      ],
      "role": "happening"
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/core/artifacts/core.Conversion.interface.json"
  },
  "scope": {},
  "version": "0.1.0"
}
