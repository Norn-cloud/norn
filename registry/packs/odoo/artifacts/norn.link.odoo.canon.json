    "residuals": [
      {
        "note": "Internal transfers move money between one company's own accounts; the canon has no account-to-account movement. Inbound and outbound payments are payments: see the member correspondences.",
        "reason": "canon_gap",
        "termId": "norn.odoo.account.payment"
      },
      {
        "note": "In payment and reversed states come from reconciliation and reversal, not from the residual amount alone.",
        "reason": "canon_gap",
        "termId": "norn.odoo.account.move.payment.state"
      },
      {
        "note": "The document date can differ from the accounting date; the canon invoice has no separate document date.",
        "reason": "canon_gap",
        "termId": "norn.odoo.account.move.invoice.date"
      },
      {
        "note": "Cancelled drafts have no canon state; draft and posted do, and posted moves change only by reversal.",
        "reason": "canon_gap",
        "termId": "norn.odoo.account.move.state"
      },
      {
        "note": "Quotation and sent states are authored workflow before any commitment; the canon order state is derived.",
        "reason": "canon_gap",
        "termId": "norn.odoo.sale.order.state"
      },
      {
        "note": "Projected as class membership: entry, invoice, credit note or receipt.",
        "reason": "system_specific",
        "termId": "norn.odoo.account.move.move.type"
      },
      {
        "note": "The canon ledger entry has no debit/credit side yet.",
        "reason": "canon_gap",
        "termId": "norn.odoo.account.move.line.debit"
      },
      {
        "note": "The canon ledger entry has no debit/credit side yet.",
        "reason": "canon_gap",
        "termId": "norn.odoo.account.move.line.credit"
      },
      {
        "note": "Editing a posted move in place breaks the canon law that posted entries change only by reversal. Where Odoo keeps a trace of the posted version, the projection is a reversal followed by a new posting; in-place edits are flagged, and the law holds (lead ruling 2026-10-31).",
        "reason": "non_conforming",
        "termId": "norn.odoo.account.move.button.draft"
      },
      {
        "note": "The canon agent does not yet distinguish persons from organisations.",
        "reason": "canon_gap",
        "termId": "norn.odoo.res.partner.is.company"
      },
      {
        "note": "Contact, invoice and delivery address kinds.",
        "reason": "system_specific",
        "termId": "norn.odoo.res.partner.type"
      },
      {
        "note": "The canon resource type has no code property.",
        "reason": "canon_gap",
        "termId": "norn.odoo.product.product.default.code"
      },
      {
        "note": "The canon transfer event has no provider and receiver agents yet.",
        "reason": "canon_gap",
        "termId": "norn.odoo.stock.picking.partner.id"
      },
      {
        "note": "Warehouse operation types.",
        "reason": "system_specific",
        "termId": "norn.odoo.stock.picking.picking.type.id"
      },
      {
        "note": "The canon has no link from an invoice to the order it bills.",
        "reason": "canon_gap",
        "termId": "norn.odoo.sale.order.invoice.status"
      }
