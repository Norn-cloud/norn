{
  "artifactId": "demo.shopify.identity.mapping",
  "dependencies": [
    {
      "artifactId": "demo.shopify.identity.source",
      "kind": "source_schema",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "demo.commerce.SourceIdentity.interface",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "demo.commerce.CatalogEntry.entity",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "demo.commerce.Shipment.entity",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    }
  ],
  "irVersion": "0.1",
  "kind": "mapping",
  "lifecycle": "active",
  "name": "Shopify explicit demo identities",
  "namespace": "demo",
  "payload": {
    "extensions": {
      "norn.mapping.generic/1.0.0": {
        "parity": "unqualified"
      }
    },
    "format": "norn.mapping/1",
    "interfaces": [
      "demo.commerce.SourceIdentity.interface"
    ],
    "maps": [
      {
        "id": "catalog",
        "ignoredFields": [
          {
            "field": "sku",
            "reason": "SKU is evidence, never a cross-system identity or a Holding."
          }
        ],
        "properties": [
          {
            "property": "id",
            "value": "input.custom_catalog_ref"
          }
        ],
        "source": {
          "dataset": "ProductVariant"
        },
        "sourceRecord": "'ProductVariant/' + input.id",
        "subject": "input.custom_catalog_ref",
        "target": {
          "entity": "demo.commerce.CatalogEntry.entity",
          "interface": "demo.commerce.SourceIdentity.interface"
        }
      },
      {
        "gaps": [
          {
            "member": "canonical_event",
            "note": "Same explicit shipment key as ERPNext; evidence adds no independent economic event or stock effect.",
            "reason": "deferred"
          }
        ],
        "id": "shipment",
        "properties": [
          {
            "property": "id",
            "value": "input.custom_shipment_ref"
          }
        ],
        "source": {
          "dataset": "Fulfillment"
        },
        "sourceRecord": "'Fulfillment/' + input.id",
        "subject": "input.custom_shipment_ref",
        "target": {
          "entity": "demo.commerce.Shipment.entity",
          "interface": "demo.commerce.SourceIdentity.interface"
        }
      }
    ],
    "source": {
      "schemaId": "demo.shopify.identity.source",
      "sha256": "2d5f8307387f9ef7094bdc02498536c593586ae3151b8ad614ceba9f317afda1",
      "version": "0.1.0"
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/demo-commerce/artifacts/demo.shopify.identity.mapping.json"
  },
  "scope": {},
  "version": "0.1.0"
}
