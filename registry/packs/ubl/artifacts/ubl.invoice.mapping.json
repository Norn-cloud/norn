{
  "artifactId": "ubl.invoice.mapping",
  "dependencies": [
    {
      "artifactId": "ubl.invoice.source",
      "kind": "source_schema",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "core.Agent.interface",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "core.Claim.interface",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "canon.Invoice.entity",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "canon.Party.entity",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    }
  ],
  "irVersion": "0.1",
  "kind": "mapping",
  "lifecycle": "active",
  "name": "UBL 2.3 Invoice to the REA canon",
  "namespace": "ubl",
  "payload": {
    "extensions": {
      "norn.mapping.generic/1.0.0": {
        "parity": "unqualified"
      }
    },
    "format": "norn.mapping/1",
    "interfaces": [
      "core.Agent.interface",
      "core.Claim.interface"
    ],
    "maps": [
      {
        "gaps": [
          {
            "member": "amount",
            "note": "PayableAmount is an unbounded XSD decimal; mapping it to a money amount needs the declared scale and rounding policy of the EN 16931 pack.",
            "reason": "deferred"
          },
          {
            "member": "currency",
            "note": "DocumentCurrencyCode is optional in UBL; EN 16931 (BR-05) makes it mandatory, so the EN 16931 pack maps it.",
            "reason": "deferred"
          },
          {
            "member": "due_date",
            "note": "DueDate is optional in UBL; EN 16931 (BR-CO-25) requires a due date or payment terms, so the EN 16931 pack maps it.",
            "reason": "deferred"
          },
          {
            "member": "arises_from",
            "note": "OrderReference names an order by id only; the commitment it arises from needs the order system's identity.",
            "reason": "not_in_source"
          }
        ],
        "id": "invoice",
        "ignoredFields": [
          {
            "field": "payable_amount",
            "reason": "Held for the amount mapping the EN 16931 pack declares."
          },
          {
            "field": "DocumentCurrencyCode",
            "reason": "Held for the currency mapping the EN 16931 pack declares."
          },
          {
            "field": "DueDate",
            "reason": "Held for the due-date mapping the EN 16931 pack declares."
          }
        ],
        "links": [
          {
            "key": "input.supplier_endpoint ?? ''",
            "link": "creditor",
            "targetMap": "supplier"
          },
          {
            "key": "input.customer_endpoint ?? ''",
            "link": "debtor",
            "targetMap": "customer"
          }
        ],
        "properties": [
          {
            "property": "document_id",
            "value": "input.ID"
          },
          {
            "property": "issue_date",
            "value": "input.IssueDate"
          }
        ],
        "source": {
          "dataset": "InvoiceType"
        },
        "sourceRecord": "'ubl/Invoice/' + input.ID",
        "subject": "input.ID",
        "target": {
          "entity": "canon.Invoice.entity",
          "interface": "core.Claim.interface"
        }
      },
      {
        "id": "supplier",
        "properties": [
          {
            "property": "display_name",
            "value": "input.supplier_name ?? (input.supplier_endpoint ?? '')"
          },
          {
            "property": "kind",
            "value": "'organization'"
          }
        ],
        "source": {
          "dataset": "InvoiceType"
        },
        "sourceRecord": "'ubl/Invoice/' + input.ID + '/supplier'",
        "subject": "input.supplier_endpoint ?? ''",
        "target": {
          "entity": "canon.Party.entity",
          "interface": "core.Agent.interface"
        }
      },
      {
        "id": "customer",
        "properties": [
          {
            "property": "display_name",
            "value": "input.customer_name ?? (input.customer_endpoint ?? '')"
          },
          {
            "property": "kind",
            "value": "'organization'"
          }
        ],
        "source": {
          "dataset": "InvoiceType"
        },
        "sourceRecord": "'ubl/Invoice/' + input.ID + '/customer'",
        "subject": "input.customer_endpoint ?? ''",
        "target": {
          "entity": "canon.Party.entity",
          "interface": "core.Agent.interface"
        }
      }
    ],
    "source": {
      "schemaId": "ubl.invoice.source",
      "sha256": "db10d6cea0ccd8b1c41f6c5810a3e71b4fb8d6d3c40de57d41edf1185c1760d0",
      "version": "0.1.0"
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/ubl/artifacts/ubl.invoice.mapping.json"
  },
  "scope": {},
  "version": "0.1.0"
}
