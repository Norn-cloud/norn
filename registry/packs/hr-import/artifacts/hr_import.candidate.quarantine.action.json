{
  "artifactId": "hr_import.candidate.quarantine.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Quarantine extracted candidate",
  "namespace": "hr_import",
  "payload": {
    "access": {
      "artifactId": "hr_import.access.policy",
      "version": "0.1.0"
    },
    "actionId": "hr_import.candidate.quarantine",
    "description": "Move a staged extracted candidate bound to its source batch into quarantine when data quality or FEED-CONFLICT findings require human resolution.",
    "effectProgram": {
      "entityArtifactId": "hr_import.ExtractedCandidate.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "fire_transition",
      "lifecycle": "status",
      "objectIdField": "candidateId",
      "objectKind": "hr_import.ExtractedCandidate",
      "transition": "quarantine"
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "batchId": {
          "type": "string"
        },
        "candidateId": {
          "type": "string"
        }
      },
      "required": [
        "candidateId",
        "batchId"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "candidateId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "candidateId",
        "status"
      ],
      "type": "object"
    },
    "preconditions": [
      "slice.batch.id in map(slice.candidate_batch as b, b.id)",
      "slice.candidate.status == 'staged'"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "candidateId"
          }
        },
        "name": "candidate",
        "objectType": "hr_import.ExtractedCandidate"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "batchId"
          }
        },
        "name": "batch",
        "objectType": "hr_import.SourceBatch"
      },
      {
        "key": {
          "link": {
            "from": "candidate",
            "link": "batch"
          }
        },
        "name": "candidate_batch",
        "objectType": "hr_import.SourceBatch"
      }
    ],
    "title": "Quarantine extracted candidate",
    "writes": [
      {
        "change": "modified",
        "entityKind": "hr_import.ExtractedCandidate"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/hr-import/artifacts/hr_import.candidate.quarantine.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
