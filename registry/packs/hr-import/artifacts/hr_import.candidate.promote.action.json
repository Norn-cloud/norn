{
  "artifactId": "hr_import.candidate.promote.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Promote extracted candidate",
  "namespace": "hr_import",
  "payload": {
    "access": {
      "artifactId": "hr_import.access.policy",
      "version": "0.1.0"
    },
    "actionId": "hr_import.candidate.promote",
    "description": "Promote a clean reviewed candidate anchored to verified norn.SourceEvidence matching its SourceBatch document digest.",
    "effectProgram": {
      "entityArtifactId": "hr_import.ExtractedCandidate.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "fire_transition",
      "lifecycle": "status",
      "objectIdField": "candidateId",
      "objectKind": "hr_import.ExtractedCandidate",
      "transition": "promote"
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "batchId": {
          "type": "string"
        },
        "candidateId": {
          "type": "string"
        },
        "evidenceId": {
          "type": "string"
        }
      },
      "required": [
        "candidateId",
        "batchId",
        "evidenceId"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "candidateId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "candidateId",
        "status"
      ],
      "type": "object"
    },
    "preconditions": [
      "((slice.batch.id in map(slice.candidate_batch as b, b.id)) and (slice.candidate.id in map(slice.evidence_candidate as c, c.id))) and (slice.batch.id in map(slice.evidence_batch as b, b.id))",
      "(((slice.candidate.dispute_state == 'clean') and (slice.candidate.review_receipt_digest != null)) and (slice.candidate.reviewed_by_user_id != null)) and (slice.evidence.document_digest == slice.batch.document_digest)"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "candidateId"
          }
        },
        "name": "candidate",
        "objectType": "hr_import.ExtractedCandidate"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "batchId"
          }
        },
        "name": "batch",
        "objectType": "hr_import.SourceBatch"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "evidenceId"
          }
        },
        "name": "evidence",
        "objectType": "hr_import.FieldEvidence"
      },
      {
        "key": {
          "link": {
            "from": "candidate",
            "link": "batch"
          }
        },
        "name": "candidate_batch",
        "objectType": "hr_import.SourceBatch"
      },
      {
        "key": {
          "link": {
            "from": "evidence",
            "link": "candidate"
          }
        },
        "name": "evidence_candidate",
        "objectType": "hr_import.ExtractedCandidate"
      },
      {
        "key": {
          "link": {
            "from": "evidence",
            "link": "batch"
          }
        },
        "name": "evidence_batch",
        "objectType": "hr_import.SourceBatch"
      }
    ],
    "title": "Promote extracted candidate",
    "writes": [
      {
        "change": "modified",
        "entityKind": "hr_import.ExtractedCandidate"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/hr-import/artifacts/hr_import.candidate.promote.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
