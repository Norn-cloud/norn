{
  "artifactId": "hr_import.ExtractedCandidate.entity",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "entity",
  "lifecycle": "active",
  "name": "Extracted import candidate",
  "namespace": "hr_import",
  "payload": {
    "entityVersion": "2.0",
    "objectType": {
      "description": "Untrusted extracted HR proposal carrying 3-timestamp bitemporal provenance, content digest, explicit dispute state, and immutable terminal promotion/rejection/supersession.",
      "identity": [
        {
          "name": "primary",
          "properties": [
            "id"
          ]
        }
      ],
      "lifecycles": [
        {
          "immutable": [
            "promoted",
            "rejected",
            "superseded"
          ],
          "initial": [
            "staged"
          ],
          "property": "status",
          "terminal": [
            "promoted",
            "rejected",
            "superseded"
          ],
          "transitions": [
            {
              "from": [
                "staged"
              ],
              "id": "quarantine",
              "to": "quarantined"
            },
            {
              "from": [
                "staged",
                "quarantined"
              ],
              "guards": [
                "((self.dispute_state == 'clean') and (self.review_receipt_digest != null)) and (self.reviewed_by_user_id != null)"
              ],
              "id": "promote",
              "to": "promoted"
            },
            {
              "from": [
                "staged",
                "quarantined"
              ],
              "id": "reject",
              "to": "rejected"
            },
            {
              "from": [
                "staged",
                "quarantined"
              ],
              "id": "supersede",
              "to": "superseded"
            }
          ]
        }
      ],
      "links": [
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "Source upload batch from which this candidate was extracted.",
          "id": "batch",
          "target": "hr_import.SourceBatch"
        },
        {
          "cardinality": {
            "from": "one",
            "to": "one"
          },
          "description": "Prior quarantined or disputed candidate superseded by this corrected candidate (append-only Core 07 lineage).",
          "id": "supersedes",
          "target": "hr_import.ExtractedCandidate"
        }
      ],
      "name": "hr_import.ExtractedCandidate",
      "properties": [
        {
          "id": "id",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "target_kind",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "person"
              },
              {
                "value": "leave_request"
              },
              {
                "value": "shift_commitment"
              },
              {
                "value": "attendance_event"
              }
            ]
          }
        },
        {
          "id": "source_record_key",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "payload_digest",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "confidence_bp",
          "type": {
            "kind": "integer"
          }
        },
        {
          "id": "source_span",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "extracted_at",
          "type": {
            "kind": "timestamp",
            "timezone": "utc"
          }
        },
        {
          "id": "observed_at",
          "type": {
            "kind": "timestamp",
            "timezone": "utc"
          }
        },
        {
          "id": "effective_on",
          "type": {
            "kind": "date"
          }
        },
        {
          "default": "clean",
          "id": "dispute_state",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "clean"
              },
              {
                "value": "quarantined"
              },
              {
                "value": "disputed"
              }
            ]
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "review_receipt_digest",
          "type": {
            "kind": "text"
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "reviewed_by_user_id",
          "type": {
            "kind": "text"
          }
        },
        {
          "default": "staged",
          "id": "status",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "staged"
              },
              {
                "value": "quarantined"
              },
              {
                "value": "promoted"
              },
              {
                "value": "rejected"
              },
              {
                "value": "superseded"
              }
            ]
          }
        }
      ],
      "role": "happening"
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/hr-import/artifacts/hr_import.ExtractedCandidate.entity.json"
  },
  "scope": {},
  "version": "0.1.0"
}
