{
  "artifactId": "hr_import.DataQualityFinding.entity",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "entity",
  "lifecycle": "active",
  "name": "Import data quality finding",
  "namespace": "hr_import",
  "payload": {
    "entityVersion": "2.0",
    "objectType": {
      "description": "Replay-stable quarantine or Core 07 FEED-CONFLICT finding attached to an ExtractedCandidate; terminal resolution states are strictly immutable and require audited receipt evidence (never silently waived).",
      "identity": [
        {
          "name": "primary",
          "properties": [
            "id"
          ]
        }
      ],
      "lifecycles": [
        {
          "immutable": [
            "resolved",
            "superseded",
            "rejected"
          ],
          "initial": [
            "open"
          ],
          "property": "status",
          "terminal": [
            "resolved",
            "superseded",
            "rejected"
          ],
          "transitions": [
            {
              "from": [
                "open"
              ],
              "guards": [
                "(((((self.resolution_action ?? '') == 'accept_first') or ((self.resolution_action ?? '') == 'revalidated_correction')) and (self.resolution_receipt_digest != null)) and (self.resolved_by_user_id != null)) and (self.resolution_reason != null)"
              ],
              "id": "resolve",
              "to": "resolved"
            },
            {
              "from": [
                "open"
              ],
              "guards": [
                "((((self.resolution_action ?? '') == 'accept_second_as_correction') and (self.resolution_receipt_digest != null)) and (self.resolved_by_user_id != null)) and (self.resolution_reason != null)"
              ],
              "id": "supersede",
              "to": "superseded"
            },
            {
              "from": [
                "open"
              ],
              "guards": [
                "((((self.resolution_action ?? '') == 'reject_candidate') and (self.resolution_receipt_digest != null)) and (self.resolved_by_user_id != null)) and (self.resolution_reason != null)"
              ],
              "id": "reject",
              "to": "rejected"
            }
          ]
        }
      ],
      "links": [
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "Extracted candidate quarantined or disputed by this finding.",
          "id": "candidate",
          "inverse": "findings",
          "target": "hr_import.ExtractedCandidate"
        },
        {
          "cardinality": {
            "from": "many",
            "to": "one"
          },
          "description": "Optional field evidence anchor pinpointing where the violation or conflict was observed.",
          "id": "evidence",
          "target": "hr_import.FieldEvidence"
        },
        {
          "cardinality": {
            "from": "many",
            "to": "one"
          },
          "description": "Optional superseding candidate that resolved this finding via append-only correction.",
          "id": "superseded_by",
          "target": "hr_import.ExtractedCandidate"
        }
      ],
      "name": "hr_import.DataQualityFinding",
      "properties": [
        {
          "id": "id",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "code",
          "type": {
            "kind": "ref",
            "name": "core.code"
          }
        },
        {
          "id": "finding_kind",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "schema_violation"
              },
              {
                "value": "missing_anchor"
              },
              {
                "value": "low_confidence"
              },
              {
                "value": "duplicate_key"
              },
              {
                "value": "feed_conflict"
              },
              {
                "value": "domain_law_violation"
              }
            ]
          }
        },
        {
          "id": "severity",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "warning"
              },
              {
                "value": "error"
              }
            ]
          }
        },
        {
          "id": "quarantine_disposition",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "quarantined"
              },
              {
                "value": "disputed"
              },
              {
                "value": "advisory"
              }
            ]
          }
        },
        {
          "id": "field_path",
          "type": {
            "kind": "text"
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "law_pin",
          "type": {
            "kind": "text"
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "conflicting_payload_digest",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "message",
          "type": {
            "kind": "text"
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "resolution_action",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "accept_first"
              },
              {
                "value": "accept_second_as_correction"
              },
              {
                "value": "reject_candidate"
              },
              {
                "value": "revalidated_correction"
              }
            ]
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "resolution_receipt_digest",
          "type": {
            "kind": "text"
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "resolved_by_user_id",
          "type": {
            "kind": "text"
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "resolution_reason",
          "type": {
            "kind": "text"
          }
        },
        {
          "default": "open",
          "id": "status",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "open"
              },
              {
                "value": "resolved"
              },
              {
                "value": "superseded"
              },
              {
                "value": "rejected"
              }
            ]
          }
        }
      ],
      "role": "happening"
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/hr-import/artifacts/hr_import.DataQualityFinding.entity.json"
  },
  "scope": {},
  "version": "0.1.0"
}
