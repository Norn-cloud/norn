{
  "artifactId": "erpnext.sandbox.connector",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "connector",
  "lifecycle": "active",
  "name": "ERPNext sandbox REST reads",
  "namespace": "erpnext",
  "payload": {
    "auth": {
      "authId": "erpnext_sandbox",
      "format": {
        "kind": "pair",
        "separator": ":"
      },
      "kind": "api_key",
      "name": "Authorization",
      "placement": "header",
      "prefix": "token ",
      "secretRef": "erpnext_sandbox_token"
    },
    "connectorVersion": "0.1",
    "extensions": {
      "norn.pull/1": {
        "feeds": [
          {
            "dataset": "Party",
            "fields": {
              "custom_norn_ref": "/custom_norn_ref",
              "label": "/customer_name",
              "name": "/name",
              "role": "/custom_norn_role"
            },
            "idPath": "/name",
            "initial": {
              "id": "",
              "version": "1970-01-01 00:00:00.000000"
            },
            "itemsPath": "/data",
            "paging": {
              "kind": "keyset",
              "size": 100
            },
            "request": {
              "method": "GET",
              "path": "/api/resource/Customer",
              "query": {
                "fields": "[\"name\",\"modified\",\"customer_name\",\"custom_norn_ref\",\"custom_norn_role\"]",
                "filters": "[[\"custom_norn_ref\",\"is\",\"set\"],[\"modified\",\">=\",{{json:version}}]]",
                "limit_page_length": "{{size}}",
                "limit_start": "0",
                "or_filters": "[[\"modified\",\">\",{{json:version}}],[\"name\",\">\",{{json:id}}]]",
                "order_by": "modified asc, name asc"
              }
            },
            "versionPath": "/modified"
          },
          {
            "dataset": "Item",
            "fields": {
              "code": "/item_code",
              "custom_norn_ref": "/custom_norn_ref",
              "label": "/item_name",
              "name": "/name",
              "price": "/standard_rate",
              "sku": "/custom_sku"
            },
            "idPath": "/name",
            "initial": {
              "id": "",
              "version": "1970-01-01 00:00:00.000000"
            },
            "itemsPath": "/data",
            "paging": {
              "kind": "keyset",
              "size": 100
            },
            "request": {
              "method": "GET",
              "path": "/api/resource/Item",
              "query": {
                "fields": "[\"name\",\"modified\",\"item_code\",\"item_name\",\"custom_sku\",\"standard_rate\",\"custom_norn_ref\"]",
                "filters": "[[\"custom_norn_ref\",\"is\",\"set\"],[\"modified\",\">=\",{{json:version}}]]",
                "limit_page_length": "{{size}}",
                "limit_start": "0",
                "or_filters": "[[\"modified\",\">\",{{json:version}}],[\"name\",\">\",{{json:id}}]]",
                "order_by": "modified asc, name asc"
              }
            },
            "versionPath": "/modified"
          },
          {
            "dataset": "Warehouse Lot Balance",
            "fields": {
              "cost_currency": "/cost_currency",
              "custodian_ref": "/custodian_ref",
              "custom_norn_ref": "/custom_norn_ref",
              "item_ref": "/item_ref",
              "location": "/location",
              "name": "/name",
              "owner_ref": "/owner_ref",
              "quantity": "/quantity",
              "resource_code": "/resource_code",
              "stock_cost": "/stock_cost",
              "unit": "/unit",
              "valuation_method": "/valuation_method"
            },
            "idPath": "/name",
            "initial": {
              "id": "",
              "version": "1970-01-01 00:00:00.000000"
            },
            "itemsPath": "/data",
            "paging": {
              "kind": "keyset",
              "size": 100
            },
            "request": {
              "method": "GET",
              "path": "/api/resource/Warehouse%20Lot%20Balance",
              "query": {
                "fields": "[\"name\",\"modified\",\"custom_norn_ref\",\"resource_code\",\"quantity\",\"unit\",\"location\",\"item_ref\",\"owner_ref\",\"custodian_ref\",\"stock_cost\",\"cost_currency\",\"valuation_method\"]",
                "filters": "[[\"custom_norn_ref\",\"is\",\"set\"],[\"modified\",\">=\",{{json:version}}]]",
                "limit_page_length": "{{size}}",
                "limit_start": "0",
                "or_filters": "[[\"modified\",\">\",{{json:version}}],[\"name\",\">\",{{json:id}}]]",
                "order_by": "modified asc, name asc"
              }
            },
            "versionPath": "/modified"
          },
          {
            "dataset": "Sales Order Item",
            "fields": {
              "custom_norn_ref": "/custom_norn_ref",
              "due_at": "/custom_due_at",
              "holding_ref": "/custom_holding_ref",
              "name": "/name",
              "provider_ref": "/custom_provider_ref",
              "quantity": "/qty",
              "receiver_ref": "/custom_receiver_ref",
              "unit": "/uom"
            },
            "idPath": "/name",
            "initial": {
              "id": "",
              "version": "1970-01-01 00:00:00.000000"
            },
            "itemsPath": "/data",
            "paging": {
              "kind": "keyset",
              "size": 100
            },
            "request": {
              "method": "GET",
              "path": "/api/resource/Sales%20Order%20Item",
              "query": {
                "fields": "[\"name\",\"modified\",\"qty\",\"uom\",\"custom_norn_ref\",\"custom_due_at\",\"custom_provider_ref\",\"custom_receiver_ref\",\"custom_holding_ref\"]",
                "filters": "[[\"custom_norn_ref\",\"is\",\"set\"],[\"modified\",\">=\",{{json:version}}]]",
                "limit_page_length": "{{size}}",
                "limit_start": "0",
                "or_filters": "[[\"modified\",\">\",{{json:version}}],[\"name\",\">\",{{json:id}}]]",
                "order_by": "modified asc, name asc",
                "parent": "Sales Order"
              }
            },
            "versionPath": "/modified"
          }
        ],
        "pipeline": "norn-pull/1+erpnext.sandbox.connector@0.1.0",
        "source": "erpnext"
      }
    },
    "mappings": [],
    "resources": [
      {
        "endpoint": "/api/resource/{doctype}",
        "itemsPath": "/data",
        "kind": "delta",
        "resourceId": "documents",
        "sinceParam": "filters",
        "updatedAtPath": "/modified"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/erpnext/artifacts/erpnext.sandbox.connector.json"
  },
  "scope": {},
  "version": "0.1.0"
}
