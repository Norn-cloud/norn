{
  "artifactId": "docs.scans.mapping",
  "dependencies": [
    {
      "artifactId": "docs.scans.source",
      "kind": "source_schema",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "docs.SourceDocument.interface",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "docs.SourceDocumentLine.interface",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "norn.SourceEvidence.interface",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "docs.BookedEntry.interface",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "docs.ScannedDocument.entity",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "docs.LedgerEntry.entity",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "docs.DocumentLine.entity",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    },
    {
      "artifactId": "docs.FieldEvidence.entity",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    }
  ],
  "irVersion": "0.1",
  "kind": "mapping",
  "lifecycle": "active",
  "name": "Extracted documents, lines and field evidence",
  "namespace": "docs",
  "payload": {
    "extensions": {
      "norn.mapping.generic/1.0.0": {
        "parity": "unqualified"
      }
    },
    "format": "norn.mapping/1",
    "interfaces": [
      "docs.SourceDocument.interface",
      "docs.SourceDocumentLine.interface",
      "norn.SourceEvidence.interface",
      "docs.BookedEntry.interface"
    ],
    "maps": [
      {
        "id": "document",
        "ignoredFields": [
          {
            "field": "evidence",
            "reason": "Mapped row by row by the evidence map."
          }
        ],
        "links": [
          {
            "key": "input.ledger_ref",
            "link": "ledger_entry",
            "targetMap": "ledger_entry"
          }
        ],
        "properties": [
          {
            "property": "id",
            "value": "input.name"
          },
          {
            "property": "doc_number",
            "value": "input.doc_number"
          },
          {
            "property": "kind",
            "value": "input.kind"
          },
          {
            "property": "vendor",
            "value": "input.vendor"
          },
          {
            "property": "issued_on",
            "value": "input.issued_on"
          },
          {
            "property": "currency",
            "value": "input.currency"
          },
          {
            "property": "total",
            "value": "input.total"
          },
          {
            "property": "lines_total",
            "value": "input.line_count == 0 ? null : sum(map(input.lines, #.amount))"
          },
          {
            "property": "line_count",
            "value": "input.line_count"
          },
          {
            "property": "document_uri",
            "value": "input.document_uri"
          },
          {
            "property": "document_digest",
            "value": "input.document_digest"
          },
          {
            "property": "media_type",
            "value": "input.media_type"
          },
          {
            "property": "extractor",
            "value": "input.extractor"
          },
          {
            "property": "extractor_version",
            "value": "input.extractor_version"
          },
          {
            "property": "correction_reason",
            "value": "null"
          },
          {
            "property": "corrected_by",
            "value": "null"
          },
          {
            "property": "correction_evidence",
            "value": "null"
          }
        ],
        "source": {
          "dataset": "Scanned Document"
        },
        "sourceRecord": "'synthetic-scans/demo/' + input.name",
        "subject": "input.name",
        "target": {
          "entity": "docs.ScannedDocument.entity",
          "interface": "docs.SourceDocument.interface"
        }
      },
      {
        "id": "ledger_entry",
        "properties": [
          {
            "property": "id",
            "value": "input.name"
          },
          {
            "property": "entry_number",
            "value": "input.entry_number"
          },
          {
            "property": "account_code",
            "value": "input.account_code"
          },
          {
            "property": "currency",
            "value": "input.currency"
          },
          {
            "property": "amount",
            "value": "input.amount"
          },
          {
            "property": "posted_on",
            "value": "input.posted_on"
          }
        ],
        "source": {
          "dataset": "Journal Entry"
        },
        "sourceRecord": "'synthetic-scans/ledger/' + input.entry_number",
        "subject": "input.name",
        "target": {
          "entity": "docs.LedgerEntry.entity",
          "interface": "docs.BookedEntry.interface"
        }
      },
      {
        "id": "line",
        "links": [
          {
            "key": "input.parent",
            "link": "document",
            "targetMap": "document"
          }
        ],
        "properties": [
          {
            "property": "id",
            "value": "input.name"
          },
          {
            "property": "document_id",
            "value": "input.parent"
          },
          {
            "property": "line_no",
            "value": "input.line_no"
          },
          {
            "property": "description",
            "value": "input.description"
          },
          {
            "property": "currency",
            "value": "'USD'"
          },
          {
            "property": "amount",
            "value": "input.amount"
          },
          {
            "property": "review",
            "value": "'extracted'"
          },
          {
            "property": "correction_reason",
            "value": "null"
          },
          {
            "property": "corrected_by",
            "value": "null"
          },
          {
            "property": "correction_evidence",
            "value": "null"
          }
        ],
        "source": {
          "dataset": "Document Line",
          "nestedIn": {
            "dataset": "Scanned Document",
            "field": "lines"
          }
        },
        "sourceRecord": "'synthetic-scans/demo/' + input.name",
        "subject": "input.name",
        "target": {
          "entity": "docs.DocumentLine.entity",
          "interface": "docs.SourceDocumentLine.interface"
        }
      },
      {
        "id": "evidence",
        "links": [
          {
            "key": "input.parent",
            "link": "of",
            "targetMap": "document"
          }
        ],
        "properties": [
          {
            "property": "id",
            "value": "input.name"
          },
          {
            "property": "subject_property",
            "value": "startsWith(input.field, 'lines.') ? 'amount' : input.field"
          },
          {
            "property": "subject_type",
            "value": "startsWith(input.field, 'lines.') ? 'docs.DocumentLine' : null"
          },
          {
            "property": "subject_key",
            "value": "startsWith(input.field, 'lines.') ? input.parent + '~line-' + split(input.field, '.')[1] : null"
          },
          {
            "property": "document_uri",
            "value": "input.document_uri"
          },
          {
            "property": "document_digest",
            "value": "input.document_digest"
          },
          {
            "property": "media_type",
            "value": "input.media_type"
          },
          {
            "property": "page",
            "value": "input.page"
          },
          {
            "property": "bbox_x",
            "value": "input.bbox_x"
          },
          {
            "property": "bbox_y",
            "value": "input.bbox_y"
          },
          {
            "property": "bbox_w",
            "value": "input.bbox_w"
          },
          {
            "property": "bbox_h",
            "value": "input.bbox_h"
          },
          {
            "property": "text",
            "value": "input.text"
          },
          {
            "property": "extractor",
            "value": "input.extractor"
          },
          {
            "property": "extractor_version",
            "value": "input.extractor_version"
          },
          {
            "property": "confidence_bp",
            "value": "input.confidence_bp"
          }
        ],
        "source": {
          "dataset": "Field Evidence",
          "nestedIn": {
            "dataset": "Scanned Document",
            "field": "evidence"
          }
        },
        "sourceRecord": "'synthetic-scans/demo/' + input.name",
        "subject": "input.name",
        "target": {
          "entity": "docs.FieldEvidence.entity",
          "interface": "norn.SourceEvidence.interface"
        }
      }
    ],
    "source": {
      "schemaId": "docs.scans.source",
      "sha256": "1a06e7d02947180bcec0cb7b3f2440473679db263fe5516c526b33e0b2e1abd7",
      "version": "0.1.0"
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/documents/artifacts/docs.scans.mapping.json"
  },
  "scope": {},
  "version": "0.1.0"
}
