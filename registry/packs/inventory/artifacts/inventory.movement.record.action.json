{
  "artifactId": "inventory.movement.record.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Record immutable stock movement",
  "namespace": "inventory",
  "payload": {
    "access": {
      "artifactId": "inventory.access.policy",
      "version": "0.1.0"
    },
    "actionId": "inventory.movement.record",
    "createLinks": [
      {
        "link": "provider",
        "targetIdField": "providerId",
        "targetType": "inventory.Warehouse"
      },
      {
        "link": "receiver",
        "targetIdField": "receiverId",
        "targetType": "inventory.Warehouse"
      },
      {
        "link": "resource",
        "targetIdField": "resourceId",
        "targetType": "inventory.StockBalance"
      }
    ],
    "description": "Post a create-only StockMovement verifying active warehouses (including balance owner/custodian), (action, movement_kind) consistency, unit match, unreserved stock availability on outflows/consumptions, and active bin/lot state.",
    "effectProgram": {
      "entityArtifactId": "inventory.StockMovement.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "upsert_input_object",
      "objectIdField": "id",
      "objectKind": "inventory.StockMovement",
      "writeMode": {
        "kind": "create_only"
      }
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "movement_kind": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        },
        "quantity": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "receiverId": {
          "type": "string"
        },
        "reference_code": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "unit_cost": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        }
      },
      "required": [
        "id",
        "action",
        "movement_kind",
        "occurred_at",
        "quantity",
        "unit",
        "unit_cost",
        "currency",
        "reference_code",
        "providerId",
        "receiverId",
        "resourceId"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "preconditions": [
      "(slice.provider.status == 'active') and (slice.receiver.status == 'active')",
      "((len(slice.balance_owners) > 0) and all(slice.balance_owners as warehouse, warehouse.status == 'active')) and all(slice.balance_custodians as warehouse, warehouse.status == 'active')",
      "(((((input.movement_kind == 'receipt') and (input.action == 'produce')) or ((input.movement_kind == 'issue') and (input.action == 'consume'))) or ((input.movement_kind == 'transfer') and (input.action == 'transfer_custody'))) or ((input.movement_kind == 'scrap') and (input.action == 'consume'))) or ((input.movement_kind == 'adjustment') and ((input.action == 'produce') or (input.action == 'consume')))",
      "(input.quantity > 0) and (input.unit_cost >= 0)",
      "(slice.resource.unit != null) and (input.unit == (slice.resource.unit ?? ''))",
      "((((input.action != 'consume') and (input.movement_kind != 'issue')) and (input.movement_kind != 'transfer')) and (input.movement_kind != 'scrap')) or ((slice.resource.quantity - slice.resource.reserved_quantity) >= input.quantity)",
      "all(slice.bins as bin, bin.status == 'active')",
      "all(slice.lots as lot, lot.status == 'active')"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "providerId"
          }
        },
        "name": "provider",
        "objectType": "inventory.Warehouse"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "receiverId"
          }
        },
        "name": "receiver",
        "objectType": "inventory.Warehouse"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "resourceId"
          }
        },
        "name": "resource",
        "objectType": "inventory.StockBalance"
      },
      {
        "key": {
          "link": {
            "from": "resource",
            "link": "owner"
          }
        },
        "name": "balance_owners",
        "objectType": "inventory.Warehouse"
      },
      {
        "key": {
          "link": {
            "from": "resource",
            "link": "custodian"
          }
        },
        "name": "balance_custodians",
        "objectType": "inventory.Warehouse"
      },
      {
        "key": {
          "link": {
            "from": "resource",
            "link": "bin"
          }
        },
        "name": "bins",
        "objectType": "inventory.BinLocation"
      },
      {
        "key": {
          "link": {
            "from": "resource",
            "link": "lot"
          }
        },
        "name": "lots",
        "objectType": "inventory.LotBatch"
      }
    ],
    "title": "Record immutable stock movement",
    "writes": [
      {
        "change": "created",
        "entityKind": "inventory.StockMovement"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/inventory/artifacts/inventory.movement.record.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
