  "irVersion": "0.1",
  "kind": "law",
  "lifecycle": "active",
  "name": "Lot manufacture date does not exceed expiry date",
  "namespace": "inventory",
  "payload": {
    "condition": "self.expires_on != null",
    "id": "inventory.LotBatch.valid_dates",
    "lawVersion": "0.1",
    "modality": {
      "kind": "always"
    },
    "owner": "inventory",
    "provenance": {
      "source": "authoring_sdk",
      "sourcePath": "registry/packs/inventory/warehouse.ts"
    },
    "rationale": "When an expiry date is recorded on a lot, manufactured_on must be on or before expires_on.",
    "response": {
      "expression": "date(self.manufactured_on) <= date(self.expires_on ?? self.manufactured_on)",
      "kind": "predicate"
    },
    "scope": {
      "objectTypes": [
        "inventory.LotBatch"
      ],
      "root": {
        "id": "inventory.LotBatch",
        "kind": "entity"
      }
    },
    "severity": "error",
    "subject": "inventory.LotBatch"
  },
