  "name": "Stock balance is non-negative and reserved quantity never exceeds on-hand quantity",
  "namespace": "inventory",
  "payload": {
    "id": "inventory.StockBalance.non_negative_and_reserved_bounded",
    "lawVersion": "0.1",
    "modality": {
      "kind": "always"
    },
