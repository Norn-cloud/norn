{
  "artifactId": "supply.stock_lot.update_balance.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Update a stock lot balance",
  "namespace": "supply",
  "payload": {
    "access": {
      "artifactId": "supply.retail.access.policy",
      "version": "0.1.0"
    },
    "actionId": "supply.stock_lot.update_balance",
    "derive": [
      {
        "expression": "input.remaining_qty * input.unit_cost",
        "field": "stock_value",
        "inputRequired": false
      }
    ],
    "effectProgram": {
      "entityArtifactId": "supply.StockLot.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "upsert_input_object",
      "objectIdField": "lot_id",
      "objectKind": "supply.StockLot",
      "writeMode": {
        "kind": "update_only"
      }
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "type": "string"
        },
        "depleted_qty": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "lot_id": {
          "type": "string"
        },
        "remaining_qty": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "stock_value": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "unit_cost": {
          "nornType": {
            "kind": "decimal",
            "scale": 4
          },
          "type": "number"
        }
      },
      "required": [
        "lot_id",
        "remaining_qty",
        "depleted_qty",
        "as_of",
        "unit_cost",
        "stock_value"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "lot_id": {
          "type": "string"
        }
      },
      "required": [
        "lot_id"
      ],
      "type": "object"
    },
    "preconditions": [
      "((((slice.store.status == 'active') and (slice.lot.cost_status == 'costed')) and (timestamp(input.as_of) >= timestamp(slice.lot.as_of))) and (input.depleted_qty >= slice.lot.depleted_qty)) and ((input.depleted_qty + input.remaining_qty) == slice.lot.received_qty)"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "lot_id"
          }
        },
        "name": "lot",
        "objectType": "supply.StockLot"
      },
      {
        "key": {
          "property": {
            "from": "lot",
            "property": "store_id"
          }
        },
        "name": "store",
        "objectType": "supply.Store"
      }
    ],
    "title": "Update a stock lot balance",
    "writes": [
      {
        "change": "modified",
        "entityKind": "supply.StockLot"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/supply-lab/artifacts/supply.stock_lot.update_balance.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
