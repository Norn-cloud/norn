  "irVersion": "0.1",
  "kind": "law",
  "lifecycle": "active",
  "name": "A warehouse cannot close while live inventory positions still hold non-zero stock there.",
  "namespace": "supply",
  "payload": {
    "condition": "self.status == 'closed'",
    "id": "supply.Warehouse.closed_requires_no_stock",
    "lawVersion": "0.1",
    "modality": {
      "kind": "always"
    },
    "owner": "supply",
    "provenance": {
      "source": "authoring_sdk",
      "sourcePath": "registry/packs/supply-lab/supply.ts"
    },
    "rationale": "A warehouse cannot close while live inventory positions still hold non-zero stock there.",
    "response": {
      "expression": "sum(map(self.positions as b0, b0.on_hand_qty)) == 0",
      "kind": "predicate"
    },
    "scope": {
      "objectTypes": [
        "supply.Warehouse"
      ],
      "root": {
        "id": "supply.Warehouse",
        "kind": "entity"
      }
    },
