  "name": "The sum of inspected quantities across all inspections of a shipment receipt cannot exceed the quantity received.",
  "namespace": "supply",
  "payload": {
    "condition": "len(self.inspections) > 0",
    "id": "supply.ShipmentReceipt.inspections_within_received",
    "lawVersion": "0.1",
    "modality": {
      "kind": "always"
    },
    "owner": "supply",
