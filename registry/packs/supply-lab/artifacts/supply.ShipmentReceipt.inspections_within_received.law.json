    },
    "rationale": "The sum of inspected quantities across all inspections of a shipment receipt cannot exceed the quantity received.",
    "response": {
      "expression": "sum(map(self.inspections as b0, b0.inspected_qty)) <= self.received_qty",
      "kind": "predicate"
    },
