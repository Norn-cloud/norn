{
  "artifactId": "supply.retail.store_active_positions",
  "dependencies": [
    {
      "artifactId": "supply.StockLot.entity",
      "kind": "entity",
      "required": true,
      "version": "0.1.0"
    }
  ],
  "irVersion": "0.1",
  "kind": "derived",
  "lifecycle": "active",
  "name": "Active store-SKU stock positions",
  "namespace": "supply",
  "payload": {
    "calc": {
      "kind": "relational",
      "nodes": {
        "active": {
          "input": "derived",
          "op": "filter",
          "predicate": "input.derived_on_hand_qty > 0"
        },
        "derived": {
          "columns": [
            {
              "expression": "input.store_id",
              "name": "store_id"
            },
            {
              "expression": "input.sku_id",
              "name": "sku_id"
            },
            {
              "expression": "input.unit",
              "name": "unit"
            },
            {
              "expression": "input.currency",
              "name": "currency"
            },
            {
              "expression": "input.sum_received_qty - input.sum_depleted_qty",
              "name": "derived_on_hand_qty"
            },
            {
              "expression": "input.sum_opening_stock_value - input.sum_depleted_stock_value",
              "name": "derived_stock_value"
            },
            {
              "expression": "input.lot_count",
              "name": "lot_count"
            },
            {
              "expression": "input.costed_lots",
              "name": "costed_lots"
            },
            {
              "expression": "input.costed_lots == input.lot_count",
              "name": "cost_complete"
            }
          ],
          "input": "per_position",
          "op": "project"
        },
        "lot": {
          "input": "lot",
          "op": "scan"
        },
        "per_position": {
          "groupBy": [
            {
              "column": "store_id"
            },
            {
              "column": "sku_id"
            },
            {
              "column": "unit"
            },
            {
              "column": "currency"
            }
          ],
          "input": "lot",
          "measures": [
            {
              "column": "received_qty",
              "fn": "sum",
              "label": "Total received",
              "name": "sum_received_qty"
            },
            {
              "column": "depleted_qty",
              "fn": "sum",
              "label": "Total depleted",
              "name": "sum_depleted_qty"
            },
            {
              "column": "opening_stock_value",
              "fn": "sum",
              "label": "Total opening value",
              "name": "sum_opening_stock_value"
            },
            {
              "column": "depleted_stock_value",
              "fn": "sum",
              "label": "Total depleted value",
              "name": "sum_depleted_stock_value"
            },
            {
              "fn": "count",
              "name": "lot_count"
            },
            {
              "column": "unit_cost",
              "fn": "count",
              "name": "costed_lots"
            }
          ],
          "op": "aggregate"
        }
      },
      "output": "active"
    },
    "inputs": [
      {
        "alias": "lot",
        "artifactId": "supply.StockLot.entity",
        "kind": "entity",
        "version": "0.1.0"
      }
    ],
    "maintenance": "recompute_on_read",
    "outputSchema": {},
    "viewId": "supply.retail.store_active_positions",
    "viewVersion": "0.1"
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/supply-lab/artifacts/supply.retail.store_active_positions.json"
  },
  "scope": {},
  "version": "0.1.0"
}
