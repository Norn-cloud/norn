{
  "artifactId": "supply.store_kpi.record.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Record verified store commercial KPI rollup",
  "namespace": "supply",
  "payload": {
    "access": {
      "artifactId": "supply.retail.access.policy",
      "version": "0.1.0"
    },
    "actionId": "supply.store_kpi.record",
    "aggregates": [
      {
        "aggregate": {
          "kind": "sum",
          "property": "sold_qty"
        },
        "filter": {
          "sku_id": "sku_id",
          "store_id": "store_id",
          "unit": "unit"
        },
        "maxItems": 100,
        "name": "total_sold_qty",
        "objectType": "supply.PosSale",
        "window": {
          "end": "period_end",
          "endInclusive": true,
          "property": "sold_at",
          "start": "period_start",
          "startInclusive": true
        }
      },
      {
        "aggregate": {
          "kind": "sum",
          "property": "gross_margin"
        },
        "filter": {
          "currency": "currency",
          "sku_id": "sku_id",
          "store_id": "store_id"
        },
        "maxItems": 100,
        "name": "total_gross_margin",
        "objectType": "supply.PosSale",
        "window": {
          "end": "period_end",
          "endInclusive": true,
          "property": "sold_at",
          "start": "period_start",
          "startInclusive": true
        }
      },
      {
        "aggregate": {
          "kind": "count"
        },
        "filter": {
          "currency": "currency",
          "sku_id": "sku_id",
          "store_id": "store_id"
        },
        "maxItems": 100,
        "name": "all_sales_count",
        "objectType": "supply.PosSale",
        "window": {
          "end": "period_end",
          "endInclusive": true,
          "property": "sold_at",
          "start": "period_start",
          "startInclusive": true
        }
      },
      {
        "aggregate": {
          "kind": "count"
        },
        "filter": {
          "cost_status": "cost_status",
          "currency": "currency",
          "sku_id": "sku_id",
          "store_id": "store_id"
        },
        "maxItems": 100,
        "name": "costed_sales_count",
        "objectType": "supply.PosSale",
        "window": {
          "end": "period_end",
          "endInclusive": true,
          "property": "sold_at",
          "start": "period_start",
          "startInclusive": true
        }
      },
      {
        "aggregate": {
          "kind": "sum",
          "property": "stock_value"
        },
        "filter": {
          "currency": "currency",
          "sku_id": "sku_id",
          "store_id": "store_id"
        },
        "maxItems": 100,
        "name": "total_closing_stock_value",
        "objectType": "supply.StockLot"
      },
      {
        "aggregate": {
          "kind": "count"
        },
        "filter": {
          "currency": "currency",
          "sku_id": "sku_id",
          "store_id": "store_id"
        },
        "maxItems": 100,
        "name": "all_lots_count",
        "objectType": "supply.StockLot"
      },
      {
        "aggregate": {
          "kind": "count"
        },
        "filter": {
          "currency": "currency",
          "sku_id": "sku_id",
          "store_id": "store_id"
        },
        "maxItems": 100,
        "name": "lots_as_of_by_period_end",
        "objectType": "supply.StockLot",
        "window": {
          "end": "period_end",
          "endInclusive": true,
          "property": "as_of",
          "start": "book_epoch",
          "startInclusive": true
        }
      },
      {
        "aggregate": {
          "kind": "count"
        },
        "filter": {
          "cost_status": "cost_status",
          "currency": "currency",
          "sku_id": "sku_id",
          "store_id": "store_id"
        },
        "maxItems": 100,
        "name": "costed_lots_count",
        "objectType": "supply.StockLot"
      },
      {
        "aggregate": {
          "kind": "sum",
          "property": "remaining_qty"
        },
        "filter": {
          "sku_id": "sku_id",
          "store_id": "store_id",
          "unit": "unit"
        },
        "maxItems": 100,
        "name": "total_lot_remaining_qty",
        "objectType": "supply.StockLot"
      }
    ],
    "createLinks": [
      {
        "link": "store",
        "targetIdField": "store_id",
        "targetType": "supply.Store"
      },
      {
        "link": "sku",
        "targetIdField": "sku_id",
        "targetType": "supply.Sku"
      },
      {
        "link": "on_hand_count",
        "targetIdField": "on_hand_count_id",
        "targetType": "supply.StoreCount"
      },
      {
        "link": "opening_cut",
        "targetIdField": "opening_cut_id",
        "targetType": "supply.StockValuationCut"
      },
      {
        "link": "cost_record",
        "targetIdField": "sku_id",
        "targetType": "supply.UnitCost"
      }
    ],
    "derive": [
      {
        "expression": "0",
        "field": "weeks_of_supply",
        "inputRequired": false
      },
      {
        "expression": "(input.opening_stock_value + input.closing_stock_value) * 0.5",
        "field": "average_inventory_value",
        "inputRequired": false
      },
      {
        "expression": "0",
        "field": "gmroi",
        "inputRequired": false
      }
    ],
    "effectProgram": {
      "entityArtifactId": "supply.StoreCommercialRollup.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "upsert_input_object",
      "objectIdField": "rollup_id",
      "objectKind": "supply.StoreCommercialRollup",
      "writeMode": {
        "kind": "create_only"
      }
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "average_inventory_value": {
          "nornType": {
            "kind": "decimal",
            "rounding": "half_even",
            "scale": 6
          },
          "type": "number"
        },
        "avg_weekly_sales_qty": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "book_epoch": {
          "type": "string"
        },
        "closing_stock_value": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "cost_status": {
          "enum": [
            "costed",
            "missing_cost"
          ],
          "type": "string"
        },
        "costed_ref": {
          "type": "string"
        },
        "count_as_of": {
          "type": "string"
        },
        "count_ref": {
          "type": "string"
        },
        "count_status": {
          "enum": [
            "verified",
            "unverified"
          ],
          "type": "string"
        },
        "currency": {
          "enum": [
            "EGP",
            "USD",
            "EUR"
          ],
          "type": "string"
        },
        "gmroi": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "on_hand_count_id": {
          "type": "string"
        },
        "on_hand_qty": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "opening_cut_id": {
          "type": "string"
        },
        "opening_stock_value": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "period_end": {
          "type": "string"
        },
        "period_gross_margin": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "period_start": {
          "type": "string"
        },
        "period_week": {
          "type": "string"
        },
        "rollup_id": {
          "type": "string"
        },
        "sales_weeks": {
          "type": "integer"
        },
        "sku_id": {
          "type": "string"
        },
        "store_id": {
          "type": "string"
        },
        "unit": {
          "enum": [
            "each",
            "kg",
            "l"
          ],
          "type": "string"
        },
        "weeks_of_supply": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        }
      },
      "required": [
        "rollup_id",
        "store_id",
        "sku_id",
        "period_week",
        "unit",
        "currency",
        "cost_status",
        "count_status",
        "on_hand_count_id",
        "opening_cut_id",
        "count_ref",
        "count_as_of",
        "costed_ref",
        "book_epoch",
        "period_start",
        "period_end",
        "sales_weeks",
        "on_hand_qty",
        "avg_weekly_sales_qty",
        "weeks_of_supply",
        "period_gross_margin",
        "opening_stock_value",
        "closing_stock_value",
        "average_inventory_value",
        "gmroi"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "rollup_id": {
          "type": "string"
        }
      },
      "required": [
        "rollup_id"
      ],
      "type": "object"
    },
    "preconditions": [
      "((((((((((((((((((((((((((((slice.store.status == 'active') and (input.book_epoch == '1970-01-01T00:00:00Z')) and (input.count_status == 'verified')) and (input.cost_status == 'costed')) and (input.sales_weeks >= 1)) and (seconds_between(timestamp(input.period_start), timestamp(input.period_week + 'T00:00:00Z')) == ((input.sales_weeks - 1) * 604800))) and (input.unit == slice.sku.unit_of_measure)) and (input.currency == slice.store.currency)) and (input.store_id == slice.on_hand_count.store_id)) and (input.sku_id == slice.on_hand_count.sku_id)) and (input.unit == slice.on_hand_count.unit)) and (slice.on_hand_count.quantity_basis == 'on_hand')) and (timestamp(input.count_as_of) == timestamp(slice.on_hand_count.as_of))) and (input.count_ref == slice.on_hand_count.count_ref)) and (input.on_hand_qty == slice.on_hand_count.on_hand_qty)) and (input.on_hand_qty == aggregates.total_lot_remaining_qty)) and (input.store_id == slice.opening_cut.store_id)) and (input.sku_id == slice.opening_cut.sku_id)) and (input.currency == slice.opening_cut.currency)) and (timestamp(input.period_start) == timestamp(slice.opening_cut.cut_at))) and (input.opening_stock_value == slice.opening_cut.stock_value)) and (input.currency == slice.cost.currency)) and (input.costed_ref == slice.cost.cost_ref)) and ((input.avg_weekly_sales_qty * input.sales_weeks) == aggregates.total_sold_qty)) and (input.period_gross_margin == aggregates.total_gross_margin)) and (aggregates.costed_sales_count == aggregates.all_sales_count)) and (input.closing_stock_value == aggregates.total_closing_stock_value)) and (aggregates.lots_as_of_by_period_end == aggregates.all_lots_count)) and (aggregates.costed_lots_count == aggregates.all_lots_count)"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "store_id"
          }
        },
        "name": "store",
        "objectType": "supply.Store"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "sku_id"
          }
        },
        "name": "sku",
        "objectType": "supply.Sku"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "on_hand_count_id"
          }
        },
        "name": "on_hand_count",
        "objectType": "supply.StoreCount"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "opening_cut_id"
          }
        },
        "name": "opening_cut",
        "objectType": "supply.StockValuationCut"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "sku_id"
          }
        },
        "name": "cost",
        "objectType": "supply.UnitCost"
      }
    ],
    "title": "Record verified store commercial KPI rollup",
    "writes": [
      {
        "change": "created",
        "entityKind": "supply.StoreCommercialRollup"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/supply-lab/artifacts/supply.store_kpi.record.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
