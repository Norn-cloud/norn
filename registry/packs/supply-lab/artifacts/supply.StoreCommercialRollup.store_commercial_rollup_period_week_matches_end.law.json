    "rationale": "Store commercial KPI rollup period_week must start on or before period_end with at least one sales week.",
    "response": {
      "expression": "((self.sales_weeks >= 1) and (timestamp(self.period_start) <= timestamp(self.period_end))) and (seconds_between(timestamp(self.period_week + 'T00:00:00Z'), timestamp(self.period_end)) >= 0)",
      "kind": "predicate"
    },
