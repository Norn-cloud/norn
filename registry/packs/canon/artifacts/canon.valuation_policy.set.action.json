{
  "artifactId": "canon.valuation_policy.set.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Set stock valuation policy",
  "namespace": "canon",
  "payload": {
    "actionId": "canon.valuation_policy.set",
    "description": "Create or update a stock valuation policy.",
    "effectProgram": {
