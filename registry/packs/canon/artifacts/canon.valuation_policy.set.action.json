      "kind": "upsert_input_object",
      "objectIdField": "id",
      "objectKind": "canon.ValuationPolicy"
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Policy code",
          "type": "string"
        },
        "label": {
          "description": "How the policy appears in reports.",
          "title": "Name",
          "type": "string"
        },
        "valuation_method": {
          "description": "How stock on hand is valued: first in, first out, or a moving average.",
