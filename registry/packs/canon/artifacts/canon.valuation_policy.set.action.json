        "label",
        "valuation_method"
      ],
      "type": "object",
      "x-norn": {
        "groups": [
          {
            "fields": [
              "/id",
              "/label"
            ],
            "id": "policy",
            "title": "Policy"
          },
          {
            "fields": [
              "/valuation_method"
            ],
            "id": "valuation",
            "title": "Valuation"
          }
        ]
      }
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "title": "Set stock valuation policy",
    "writes": [
      {
        "change": "created",
        "entityKind": "canon.ValuationPolicy"
      },
      {
        "change": "modified",
        "entityKind": "canon.ValuationPolicy"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/canon/artifacts/canon.valuation_policy.set.action.json"
