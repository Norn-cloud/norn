{
  "artifactId": "ml.ModelVersionEvidence.interface",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "entity",
  "lifecycle": "active",
  "name": "Evaluated model version",
  "namespace": "ml",
  "payload": {
    "entityVersion": "2.0",
    "interface": {
      "invariants": [
        {
          "expression": "(self.status != 'production') or (self.contracts_passed and (self.evaluation_revision == self.pinned_dataset_revision))",
          "id": "evaluated_on_pinned_dataset",
          "message": "A production model version was evaluated on its pinned dataset revision, and every output contract held."
        }
      ],
      "name": "ml.ModelVersionEvidence",
      "properties": [
        {
          "id": "version_id",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "model_id",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "version",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "status",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "candidate"
              },
              {
                "value": "production"
              },
              {
                "value": "retired"
              }
            ]
          }
        },
        {
          "id": "training_run",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "evaluation_run",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "artifact_uri",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "artifact_sha256",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "artifact_size",
          "type": {
            "kind": "integer"
          }
        },
        {
          "id": "input_type",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "input_revision",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "pinned_dataset_revision",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "evaluation_revision",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "metric_name",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "metric_value",
          "type": {
            "kind": "decimal",
            "scale": 9
          }
        },
        {
