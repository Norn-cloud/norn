{
  "artifactId": "accounting.invoice.void.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Void invoice",
  "namespace": "accounting",
  "payload": {
    "access": {
      "artifactId": "accounting.access.policy",
      "version": "0.1.0"
    },
    "actionId": "accounting.invoice.void",
    "description": "Void an unpaid draft or issued invoice with zero amount_paid and zero linked Payment evidence (enforced by precondition + commit-time LAW-LINK-MANY-1 law accounting.Invoice.no_void_with_payments).",
    "effectProgram": {
      "entityArtifactId": "accounting.Invoice.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "fire_transition",
      "lifecycle": "status",
      "objectIdField": "invoiceId",
      "objectKind": "accounting.Invoice",
      "transition": "void"
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "invoiceId": {
          "type": "string"
        }
      },
      "required": [
        "invoiceId"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "invoiceId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "invoiceId",
        "status"
      ],
      "type": "object"
    },
    "preconditions": [
      "slice.invoice.amount_paid == 0"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "invoiceId"
          }
        },
        "name": "invoice",
        "objectType": "accounting.Invoice"
      }
    ],
    "title": "Void invoice",
    "writes": [
      {
        "change": "modified",
        "entityKind": "accounting.Invoice"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/accounting/artifacts/accounting.invoice.void.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
