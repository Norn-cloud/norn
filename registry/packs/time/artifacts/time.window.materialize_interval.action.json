{
  "artifactId": "time.window.materialize_interval.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Materialize working window into canonical UTC interval",
  "namespace": "time",
  "payload": {
    "actionId": "time.window.materialize_interval",
    "createLinks": [
      {
        "link": "calendar",
        "targetIdField": "calendar_id",
        "targetType": "time.Calendar"
      },
      {
        "link": "working_window",
        "targetIdField": "working_window_id",
        "targetType": "time.WorkingWindow"
      }
    ],
    "description": "Creates a time.MaterializedWindow bound to its linked Calendar and WorkingWindow, enforcing timezone, DST policy, tzdb 2025b pin, local wall bounds, and checked resolve_local_timestamp UTC resolution.",
    "effectProgram": {
      "entityArtifactId": "time.MaterializedWindow.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "upsert_input_object",
      "objectIdField": "id",
      "objectKind": "time.MaterializedWindow",
      "writeMode": {
        "kind": "create_only"
      }
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "calendar_date": {
          "type": "string"
        },
        "calendar_id": {
          "type": "string"
        },
        "dst_policy": {
          "enum": [
            "reject",
            "earlier",
            "later"
          ],
          "type": "string"
        },
        "end_local_at": {
          "type": "string"
        },
        "ends_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "start_local_at": {
          "type": "string"
        },
        "starts_at": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "tzdb_version": {
          "enum": [
            "2025b"
          ],
          "type": "string"
        },
        "working_window_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "calendar_id",
        "working_window_id",
        "calendar_date",
        "start_local_at",
        "end_local_at",
        "starts_at",
        "ends_at",
        "timezone",
        "dst_policy",
        "tzdb_version"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "preconditions": [
      "slice.calendar.id in map(slice.window_calendar as cal, cal.id)",
      "((input.timezone == slice.calendar.iana_timezone) and (input.dst_policy == slice.calendar.dst_policy)) and (input.tzdb_version == slice.calendar.tzdb_version)",
      "input.start_local_at == ((take(input.calendar_date, 10) + 'T') + ((len(slice.working_window.start_local) == 5) ? (take(slice.working_window.start_local, 5) + ':00') : take(slice.working_window.start_local, 8)))",
      "input.end_local_at == ((take(input.calendar_date, 10) + 'T') + ((len(slice.working_window.end_local) == 5) ? (take(slice.working_window.end_local, 5) + ':00') : take(slice.working_window.end_local, 8)))",
      "(days_between(date('2024-01-01'), date(input.calendar_date)) - (floor(days_between(date('2024-01-01'), date(input.calendar_date)) / 7) * 7)) == ((slice.working_window.weekday == 'monday') ? 0 : ((slice.working_window.weekday == 'tuesday') ? 1 : ((slice.working_window.weekday == 'wednesday') ? 2 : ((slice.working_window.weekday == 'thursday') ? 3 : ((slice.working_window.weekday == 'friday') ? 4 : ((slice.working_window.weekday == 'saturday') ? 5 : 6))))))",
      "((timestamp(input.starts_at) == resolve_local_timestamp(input.start_local_at, slice.calendar.iana_timezone, slice.calendar.dst_policy)) and (timestamp(input.ends_at) == resolve_local_timestamp(input.end_local_at, slice.calendar.iana_timezone, slice.calendar.dst_policy))) and (timestamp(input.starts_at) < timestamp(input.ends_at))"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "calendar_id"
          }
        },
        "name": "calendar",
        "objectType": "time.Calendar"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "working_window_id"
          }
        },
        "name": "working_window",
        "objectType": "time.WorkingWindow"
      },
      {
        "key": {
          "link": {
            "from": "working_window",
            "link": "calendar"
          }
        },
        "name": "window_calendar",
        "objectType": "time.Calendar"
      }
    ],
    "title": "Materialize working window into canonical UTC interval",
    "writes": [
      {
        "change": "created",
        "entityKind": "time.MaterializedWindow"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/time/artifacts/time.window.materialize_interval.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
