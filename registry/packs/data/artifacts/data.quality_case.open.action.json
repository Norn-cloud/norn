{
  "artifactId": "data.quality_case.open.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Open a data quality resolution case",
  "namespace": "data",
  "payload": {
    "actionId": "data.quality_case.open",
    "createLinks": [
      {
        "link": "snapshot",
        "targetIdField": "snapshot_id",
        "targetType": "data.SnapshotRecord"
      }
    ],
    "effectProgram": {
      "entityArtifactId": "data.QualityCase.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "upsert_input_object",
      "objectIdField": "finding_id",
      "objectKind": "data.QualityCase",
      "writeMode": {
        "kind": "create_only"
      }
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "accuracy",
            "completeness",
            "consistency",
            "credibility",
            "currentness"
          ],
          "type": "string"
        },
        "finding_id": {
          "type": "string"
        },
        "offending_path": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "type": "string"
        },
        "snapshot_id": {
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "snapshot_id",
        "dimension",
        "severity",
        "offending_path"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string"
        }
      },
      "required": [
        "finding_id"
      ],
      "type": "object"
    },
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "snapshot_id"
          }
        },
        "name": "snapshot",
        "objectType": "data.SnapshotRecord"
      }
    ],
    "title": "Open a data quality resolution case",
    "writes": [
      {
        "change": "created",
        "entityKind": "data.QualityCase"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/data/artifacts/data.quality_case.open.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
