{
  "artifactId": "plan.spread_target.create.action",
  "dependencies": [
    {
      "artifactId": "core.units",
      "kind": "entity",
      "required": true,
      "version": "1.0.0"
    }
  ],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Create a top-down plan spread target",
  "namespace": "plan",
  "payload": {
    "access": {
      "artifactId": "plan.access.policy",
      "version": "0.1.0"
    },
    "actionId": "plan.spread_target.create",
    "createLinks": [
      {
        "link": "plan_version",
        "targetIdField": "plan_version_id",
        "targetType": "plan.PlanVersion"
      },
      {
        "link": "owner_entity",
        "targetIdField": "entity_id",
        "targetType": "supply.LegalEntity"
      }
    ],
    "effectProgram": {
      "entityArtifactId": "plan.PlanSpreadTarget.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "upsert_input_object",
      "objectIdField": "spread_target_id",
      "objectKind": "plan.PlanSpreadTarget",
      "writeMode": {
        "kind": "create_only"
      }
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "brand": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "currency": {
          "enum": [
            "EGP",
            "USD",
            "EUR"
          ],
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "plan_month": {
          "type": "string"
        },
        "plan_version_id": {
          "type": "string"
        },
        "rounding_rule": {
          "enum": [
            "largest_remainder",
            "last_bucket_remainder",
            "exact_no_remainder"
          ],
          "type": "string"
        },
        "spread_target_id": {
          "type": "string"
        },
        "target_eom_stock_cost": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "target_fine_metal_g": {
          "nornType": {
            "kind": "decimal",
            "scale": 6,
            "unit": {
              "code": "g",
              "system": "ucum"
            }
          },
          "type": "number"
        },
        "target_markdowns_cost": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "target_markdowns_retail": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "target_receipts_cost": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "target_receipts_retail": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "target_rounding_remainder_cost": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "target_sales_cost": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "target_sales_retail": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        }
      },
      "required": [
        "spread_target_id",
        "plan_version_id",
        "entity_id",
        "category",
        "brand",
        "plan_month",
        "currency",
        "rounding_rule",
        "target_sales_retail",
        "target_sales_cost",
        "target_receipts_cost",
        "target_receipts_retail",
        "target_markdowns_cost",
        "target_markdowns_retail",
        "target_eom_stock_cost",
        "target_fine_metal_g",
        "target_rounding_remainder_cost"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "spread_target_id": {
          "type": "string"
        }
      },
      "required": [
        "spread_target_id"
      ],
      "type": "object"
    },
    "preconditions": [
      "((((slice.version.status == 'draft') and (slice.owner_entity.status == 'active')) and (input.entity_id == slice.version.entity_id)) and (input.currency == slice.version.currency)) and (input.currency == slice.owner_entity.functional_currency)"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "plan_version_id"
          }
        },
        "name": "version",
        "objectType": "plan.PlanVersion"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "entity_id"
          }
        },
        "name": "owner_entity",
        "objectType": "supply.LegalEntity"
      }
    ],
    "title": "Create a top-down plan spread target",
    "writes": [
      {
        "change": "created",
        "entityKind": "plan.PlanSpreadTarget"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/plan/artifacts/plan.spread_target.create.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
