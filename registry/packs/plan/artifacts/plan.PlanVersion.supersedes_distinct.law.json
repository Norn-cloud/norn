    },
    "rationale": "A superseding plan version must name a distinct predecessor and advance revision_number past 1 without mutating locked history.",
    "response": {
      "expression": "((self.supersedes_version_id ?? '') != self.plan_version_id) and (self.revision_number >= 2)",
      "kind": "predicate"
    },
