{
  "artifactId": "plan.otb_envelope.request_unplanned.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Request an unplanned OTB override envelope",
  "namespace": "plan",
  "payload": {
    "access": {
      "artifactId": "plan.access.policy",
      "version": "0.1.0"
    },
    "actionId": "plan.otb_envelope.request_unplanned",
    "createLinks": [
      {
        "link": "plan_version",
        "targetIdField": "plan_version_id",
        "targetType": "plan.PlanVersion"
      },
      {
        "link": "owner_entity",
        "targetIdField": "entity_id",
        "targetType": "supply.LegalEntity"
      },
      {
        "link": "store",
        "targetIdField": "store_id",
        "targetType": "supply.Store"
      }
    ],
    "derive": [
      {
        "expression": "actor.subjectId",
        "field": "requested_by",
        "inputRequired": false
      },
      {
        "expression": "'unplanned'",
        "field": "envelope_kind",
        "inputRequired": false
      }
    ],
    "effectProgram": {
      "entityArtifactId": "plan.OtbEnvelope.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "upsert_input_object",
      "objectIdField": "envelope_id",
      "objectKind": "plan.OtbEnvelope",
      "writeMode": {
        "kind": "create_only"
      }
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "approved_budget_cost": {
          "nornType": {
            "kind": "decimal",
            "scale": 6
          },
          "type": "number"
        },
        "brand": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "currency": {
          "enum": [
            "EGP",
            "USD",
            "EUR"
          ],
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "envelope_id": {
          "type": "string"
        },
        "envelope_kind": {
          "enum": [
            "planned",
            "unplanned"
          ],
          "type": "string"
        },
        "override_reason": {
          "type": "string"
        },
        "period_start": {
          "type": "string"
        },
        "plan_month": {
          "type": "string"
        },
        "plan_version_id": {
          "type": "string"
        },
        "requested_by": {
          "type": "string"
        },
        "store_id": {
          "type": "string"
        }
      },
      "required": [
        "envelope_id",
        "plan_version_id",
        "entity_id",
        "store_id",
        "category",
        "brand",
        "plan_month",
        "period_start",
        "currency",
        "envelope_kind",
        "approved_budget_cost",
        "override_reason",
        "requested_by"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "type": "string"
        }
      },
      "required": [
        "envelope_id"
      ],
      "type": "object"
    },
    "preconditions": [
      "((((((((slice.version.status == 'approved') or (slice.version.status == 'locked')) and (slice.owner_entity.status == 'active')) and (slice.store.status == 'active')) and (input.entity_id == slice.version.entity_id)) and (input.entity_id == slice.store.entity_id)) and (input.currency == slice.version.currency)) and (input.currency == slice.store.currency)) and (input.approved_budget_cost > 0)"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "plan_version_id"
          }
        },
        "name": "version",
        "objectType": "plan.PlanVersion"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "entity_id"
          }
        },
        "name": "owner_entity",
        "objectType": "supply.LegalEntity"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "store_id"
          }
        },
        "name": "store",
        "objectType": "supply.Store"
      }
    ],
    "title": "Request an unplanned OTB override envelope",
    "writes": [
      {
        "change": "created",
        "entityKind": "plan.OtbEnvelope"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/plan/artifacts/plan.otb_envelope.request_unplanned.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
