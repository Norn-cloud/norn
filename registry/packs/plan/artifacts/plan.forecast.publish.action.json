{
  "artifactId": "plan.forecast.publish.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Publish a plan-grain forecast revision",
  "namespace": "plan",
  "payload": {
    "access": {
      "artifactId": "plan.access.policy",
      "version": "0.1.0"
    },
    "actionId": "plan.forecast.publish",
    "derive": [
      {
        "expression": "clock.nowIso",
        "field": "published_at",
        "inputRequired": false
      }
    ],
    "effectProgram": {
      "entityArtifactId": "plan.PublishedForecast.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "fire_transition",
      "lifecycle": "status",
      "objectIdField": "forecast_id",
      "objectKind": "plan.PublishedForecast",
      "setFields": {
        "published_at": "published_at"
      },
      "transition": "publish"
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "forecast_id": {
          "type": "string"
        },
        "published_at": {
          "type": "string"
        }
      },
      "required": [
        "forecast_id",
        "published_at"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "forecast_id": {
          "type": "string"
        }
      },
      "required": [
        "forecast_id"
      ],
      "type": "object"
    },
    "preconditions": [
      "slice.model.status == 'production'"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "forecast_id"
          }
        },
        "name": "forecast",
        "objectType": "plan.PublishedForecast"
      },
      {
        "key": {
          "property": {
            "from": "forecast",
            "property": "model_version"
          }
        },
        "name": "model",
        "objectType": "ml.ModelVersion"
      }
    ],
    "title": "Publish a plan-grain forecast revision",
    "writes": [
      {
        "change": "modified",
        "entityKind": "plan.PublishedForecast"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/plan/artifacts/plan.forecast.publish.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
