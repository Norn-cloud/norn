{
  "artifactId": "plan.po_destination.assign.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Assign a purchase order destination grain",
  "namespace": "plan",
  "payload": {
    "access": {
      "artifactId": "plan.access.policy",
      "version": "0.1.0"
    },
    "actionId": "plan.po_destination.assign",
    "createLinks": [
      {
        "link": "order",
        "targetIdField": "po_id",
        "targetType": "supply.PurchaseOrder"
      },
      {
        "link": "store",
        "targetIdField": "store_id",
        "targetType": "supply.Store"
      },
      {
        "link": "owner_entity",
        "targetIdField": "entity_id",
        "targetType": "supply.LegalEntity"
      }
    ],
    "derive": [
      {
        "expression": "date(input.plan_month + '-01')",
        "field": "period_month_date",
        "inputRequired": false
      },
      {
        "expression": "timestamp(input.plan_month + '-01T00:00:00Z')",
        "field": "period_start",
        "inputRequired": false
      },
      {
        "expression": "slice.order.currency",
        "field": "currency",
        "inputRequired": false
      }
    ],
    "effectProgram": {
      "entityArtifactId": "plan.PoDestination.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "upsert_input_object",
      "objectIdField": "po_id",
      "objectKind": "plan.PoDestination",
      "writeMode": {
        "kind": "create_only"
      }
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "enum": [
            "EGP",
            "USD",
            "EUR"
          ],
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "period_month_date": {
          "type": "string"
        },
        "period_start": {
          "type": "string"
        },
        "plan_month": {
          "type": "string"
        },
        "po_id": {
          "type": "string"
        },
        "store_id": {
          "type": "string"
        }
      },
      "required": [
        "po_id",
        "store_id",
        "entity_id",
        "plan_month",
        "period_month_date",
        "period_start",
        "currency"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "po_id": {
          "type": "string"
        }
      },
      "required": [
        "po_id"
      ],
      "type": "object"
    },
    "preconditions": [
      "(((((slice.order.status == 'draft') and (slice.store.status == 'active')) and (slice.owner_entity.status == 'active')) and (input.entity_id == slice.store.entity_id)) and (slice.order.currency == slice.store.currency)) and (slice.order.currency == slice.owner_entity.functional_currency)"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "po_id"
          }
        },
        "name": "order",
        "objectType": "supply.PurchaseOrder"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "store_id"
          }
        },
        "name": "store",
        "objectType": "supply.Store"
      },
      {
        "key": {
          "property": {
            "from": "input",
            "property": "entity_id"
          }
        },
        "name": "owner_entity",
        "objectType": "supply.LegalEntity"
      }
    ],
    "title": "Assign a purchase order destination grain",
    "writes": [
      {
        "change": "created",
        "entityKind": "plan.PoDestination"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/plan/artifacts/plan.po_destination.assign.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
