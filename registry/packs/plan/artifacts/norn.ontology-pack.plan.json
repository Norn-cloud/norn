        "semanticAuthority": "semantic_only",
        "status": "active",
        "termId": "norn.plan.otb.po.binding",
        "termKind": "class"
      },
      {
        "definition": "A plan-grain forecast revision pinned to a production ml.ModelVersion and explicit forecast_revision for Forecast - Plan variance questions.",
