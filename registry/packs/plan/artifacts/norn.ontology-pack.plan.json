        "status": "active",
        "termId": "norn.plan.line.planned.receipts.cost",
        "termKind": "property"
      },
      {
        "definition": "The semi-additive end-of-month stock balance target; never summed across months.",
        "domainTermId": "norn.plan.line",
        "label": "Planned EOM stock at cost (PlanLine)",
        "semanticAuthority": "semantic_only",
        "status": "active",
        "termId": "norn.plan.line.planned.eom.stock.cost",
        "termKind": "property"
      },
      {
        "definition": "An approved purchase-at-cost budget ceiling (planned or unplanned with override approval); an internal planning target, never a core.Commitment.",
