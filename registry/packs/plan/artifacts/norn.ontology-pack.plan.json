        "semanticAuthority": "semantic_only",
        "status": "active",
        "termId": "norn.plan.otb.envelope",
        "termKind": "class"
      },
      {
        "definition": "A governed binding between an open supply.OrderLine commitment and an active OTB envelope conserving recognized receipts, unreceived authorized PO value, and cancelled releases.",
