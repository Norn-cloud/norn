{
  "artifactId": "hr.LeaveRequest.entity",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "entity",
  "lifecycle": "active",
  "name": "Leave request",
  "namespace": "hr",
  "payload": {
    "entityVersion": "2.0",
    "objectType": {
      "description": "Governed employee leave request with explicit approval workflow and positive-day guard.",
      "identity": [
        {
          "name": "primary",
          "properties": [
            "id"
          ]
        }
      ],
      "lifecycles": [
        {
          "immutable": [
            "approved"
          ],
          "initial": [
            "draft"
          ],
          "property": "status",
          "terminal": [
            "approved",
            "rejected",
            "cancelled"
          ],
          "transitions": [
            {
              "from": [
                "draft"
              ],
              "guards": [
                "self.days > 0"
              ],
              "id": "submit",
              "to": "pending"
            },
            {
              "from": [
                "pending"
              ],
              "id": "approve",
              "to": "approved"
            },
            {
              "from": [
                "pending"
              ],
              "id": "reject",
              "to": "rejected"
            },
            {
              "from": [
                "draft",
                "pending"
              ],
              "id": "cancel",
              "to": "cancelled"
            }
          ]
        }
      ],
      "links": [
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "Requesting employee.",
          "id": "person",
          "target": "hr.Person"
        },
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "Leave balance debited on approval.",
          "id": "balance",
          "target": "hr.LeaveBalance"
        }
      ],
      "name": "hr.LeaveRequest",
      "properties": [
        {
          "id": "id",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "leave_kind",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "annual"
              },
              {
                "value": "sick"
              },
              {
                "value": "unpaid"
              },
              {
                "value": "emergency"
              }
            ]
          }
        },
        {
          "id": "starts_on",
          "type": {
            "kind": "date"
          }
        },
        {
          "id": "ends_on",
          "type": {
            "kind": "date"
          }
        },
        {
          "id": "days",
          "type": {
            "kind": "decimal",
            "scale": 6
          }
        },
        {
          "constraints": {
            "nullable": true
          },
          "id": "medical_note",
          "markings": [
            "pii.medical"
          ],
          "type": {
            "kind": "text"
          }
        },
        {
          "default": "draft",
          "id": "status",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "draft"
              },
              {
                "value": "pending"
              },
              {
                "value": "approved"
              },
              {
                "value": "rejected"
              },
              {
                "value": "cancelled"
              }
            ]
          }
        }
      ],
      "role": "happening"
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/hr/artifacts/hr.LeaveRequest.entity.json"
  },
  "scope": {},
  "version": "0.1.0"
}
