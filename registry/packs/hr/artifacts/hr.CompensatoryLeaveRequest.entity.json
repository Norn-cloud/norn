{
  "artifactId": "hr.CompensatoryLeaveRequest.entity",
  "dependencies": [
    {
      "artifactId": "core.units",
      "kind": "entity",
      "required": true,
      "version": "1.0.0"
    }
  ],
  "irVersion": "0.1",
  "kind": "entity",
  "lifecycle": "active",
  "name": "Compensatory leave request",
  "namespace": "hr",
  "payload": {
    "entityVersion": "2.0",
    "objectType": {
      "description": "Employee request to earn compensatory leave days backed by verified holiday or rest-day attendance (HR-LV-08).",
      "identity": [
        {
          "name": "primary",
          "properties": [
            "id"
          ]
        }
      ],
      "lifecycles": [
        {
          "immutable": [
            "approved"
          ],
          "initial": [
            "draft"
          ],
          "property": "status",
          "terminal": [
            "approved",
            "rejected"
          ],
          "transitions": [
            {
              "from": [
                "draft"
              ],
              "guards": [
                "self.credited_days > 0"
              ],
              "id": "submit",
              "to": "pending"
            },
            {
              "from": [
                "pending"
              ],
              "id": "approve",
              "to": "approved"
            },
            {
              "from": [
                "pending"
              ],
              "id": "reject",
              "to": "rejected"
            }
          ]
        }
      ],
      "links": [
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "Employee claiming compensatory leave.",
          "id": "person",
          "target": "hr.Person"
        },
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "Compensatory leave balance credited upon approval.",
          "id": "balance",
          "target": "hr.LeaveBalance"
        },
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "Posted holiday/rest-day attendance event backing this claim.",
          "id": "attendance_event",
          "target": "hr.AttendanceEvent"
        }
      ],
      "name": "hr.CompensatoryLeaveRequest",
      "properties": [
        {
          "id": "id",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "requester_user_id",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "work_date",
          "type": {
            "kind": "date"
          }
        },
        {
          "id": "reason",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "credited_days",
          "type": {
            "kind": "decimal",
            "scale": 2,
            "unit": {
              "code": "d",
              "system": "ucum"
            }
          }
        },
        {
          "default": "draft",
          "id": "status",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "draft"
              },
              {
                "value": "pending"
              },
              {
                "value": "approved"
              },
              {
                "value": "rejected"
              }
            ]
          }
        }
      ],
      "role": "happening"
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/hr/artifacts/hr.CompensatoryLeaveRequest.entity.json"
  },
  "scope": {},
  "version": "0.1.0"
}
