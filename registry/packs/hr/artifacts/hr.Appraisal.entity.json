{
  "artifactId": "hr.Appraisal.entity",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "entity",
  "lifecycle": "active",
  "name": "Performance appraisal",
  "namespace": "hr",
  "payload": {
    "entityVersion": "2.0",
    "objectType": {
      "description": "Cycle-bound employee performance appraisal with exact 0..100 decimal score and immutable finalized state (HR-LC-04, HR-LC-05).",
      "identity": [
        {
          "name": "primary",
          "properties": [
            "id"
          ]
        }
      ],
      "lifecycles": [
        {
          "immutable": [
            "finalized"
          ],
          "initial": [
            "draft"
          ],
          "property": "status",
          "terminal": [
            "finalized"
          ],
          "transitions": [
            {
              "from": [
                "draft"
              ],
              "id": "submit",
              "to": "submitted"
            },
            {
              "from": [
                "submitted"
              ],
              "id": "finalize",
              "to": "finalized"
            }
          ]
        }
      ],
      "links": [
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "Employee being evaluated.",
          "id": "person",
          "target": "hr.Person"
        },
        {
          "cardinality": {
            "from": "many",
            "required": true,
            "to": "one"
          },
          "description": "Manager or reviewer conducting the evaluation.",
          "id": "reviewer",
          "target": "hr.Person"
        }
      ],
      "name": "hr.Appraisal",
      "properties": [
        {
          "id": "id",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "cycle_code",
          "type": {
            "kind": "ref",
            "name": "core.code"
          }
        },
        {
          "id": "score",
          "type": {
            "kind": "decimal",
            "scale": 2
          }
        },
        {
          "default": "draft",
          "id": "status",
          "type": {
            "kind": "enum",
            "values": [
              {
                "value": "draft"
              },
              {
                "value": "submitted"
              },
              {
                "value": "finalized"
              }
            ]
          }
        }
      ],
      "role": "happening"
    }
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/hr/artifacts/hr.Appraisal.entity.json"
  },
  "scope": {},
  "version": "0.1.0"
}
