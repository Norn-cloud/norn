  "name": "Expense claim sanctioned amount stays within [0, claimed_amount] with positive claim",
  "namespace": "hr",
  "payload": {
    "id": "hr.ExpenseClaim.conservation",
    "lawVersion": "0.1",
    "modality": {
      "kind": "always"
    },
    "owner": "hr",
    "provenance": {
      "source": "authoring_sdk",
      "sourcePath": "registry/packs/hr/payroll_expenses.ts"
    },
    "rationale": "An approver cannot sanction more than the claimed_amount or a negative amount, and claimed_amount must be positive (HR-EX-01).",
    "response": {
      "expression": "((self.claimed_amount > 0) and (self.sanctioned_amount >= 0)) and (self.sanctioned_amount <= self.claimed_amount)",
      "kind": "predicate"
    },
