{
  "artifactId": "hr.comp_leave.approve.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Approve compensatory leave request",
  "namespace": "hr",
  "payload": {
    "access": {
      "artifactId": "hr.access.policy",
      "version": "0.1.0"
    },
    "actionId": "hr.comp_leave.approve",
    "description": "Approve a pending compensatory leave request under independent manager authority.",
    "effectProgram": {
      "entityArtifactId": "hr.CompensatoryLeaveRequest.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "fire_transition",
      "lifecycle": "status",
      "objectIdField": "requestId",
      "objectKind": "hr.CompensatoryLeaveRequest",
      "transition": "approve"
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string"
        }
      },
      "required": [
        "requestId"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "status"
      ],
      "type": "object"
    },
    "preconditions": [
      "(slice.request.status == 'pending') and (slice.request.credited_days > 0)"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "requestId"
          }
        },
        "name": "request",
        "objectType": "hr.CompensatoryLeaveRequest"
      }
    ],
    "title": "Approve compensatory leave request",
    "writes": [
      {
        "change": "modified",
        "entityKind": "hr.CompensatoryLeaveRequest"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/hr/artifacts/hr.comp_leave.approve.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
