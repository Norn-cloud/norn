{
  "artifactId": "hr.job_offer.send.action",
  "dependencies": [],
  "irVersion": "0.1",
  "kind": "action",
  "lifecycle": "active",
  "name": "Send job offer",
  "namespace": "hr",
  "payload": {
    "access": {
      "artifactId": "hr.access.policy",
      "version": "0.1.0"
    },
    "actionId": "hr.job_offer.send",
    "description": "Send a draft job offer with positive CTC to the candidate.",
    "effectProgram": {
      "entityArtifactId": "hr.JobOffer.entity",
      "entityArtifactVersion": "0.1.0",
      "kind": "fire_transition",
      "lifecycle": "status",
      "objectIdField": "offerId",
      "objectKind": "hr.JobOffer",
      "transition": "send"
    },
    "idempotent": true,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "offerId": {
          "type": "string"
        }
      },
      "required": [
        "offerId"
      ],
      "type": "object"
    },
    "ledgered": true,
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "offerId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "offerId",
        "status"
      ],
      "type": "object"
    },
    "preconditions": [
      "(slice.offer.status == 'draft') and (slice.offer.offered_ctc > 0)"
    ],
    "scopeRequired": [
      "orgId",
      "environmentId"
    ],
    "slice": [
      {
        "key": {
          "property": {
            "from": "input",
            "property": "offerId"
          }
        },
        "name": "offer",
        "objectType": "hr.JobOffer"
      }
    ],
    "title": "Send job offer",
    "writes": [
      {
        "change": "modified",
        "entityKind": "hr.JobOffer"
      }
    ]
  },
  "provenance": {
    "source": "system",
    "sourcePath": "registry/packs/hr/artifacts/hr.job_offer.send.action.json"
  },
  "scope": {},
  "version": "0.1.0"
}
