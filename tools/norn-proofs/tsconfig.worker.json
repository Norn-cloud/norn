{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "worker.ts",
    "core.ts",
    "protocol.ts"
  ]
}
