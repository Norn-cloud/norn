{
  "format": "norn-template/1",
  "description": "The supply-lab pack with the tracking and ml packs it composes, over the host's trusted value types; its bundled questions and dashboard as sources; and its reference dataset (generated by crates/norn-cell/tests/supply_lab_stress.rs) for norn seed, each call sent by a named local principal holding the one role the pack's access policy names for it.",
  "core": [
    "core.time",
    "core.units",
    "core.value_types.entity",
    "std.value_types.entity"
  ],
  "packs": [
    "tracking",
    "ml",
    "supply-lab"
  ],
  "principals": [
    {
      "actor": "eng:dina",
      "roles": [
        "data_engineer"
      ]
    },
    {
      "actor": "planner:amal",
      "roles": [
        "planner"
      ]
    },
    {
      "actor": "ops:omar",
      "roles": [
        "ops_manager"
      ]
    },
    {
      "actor": "clerk:hana",
      "roles": [
        "warehouse_clerk"
      ]
    }
  ],
  "seed": "packs/supply-lab/seed/supply.calls.json",
  "definitions": [
    {
      "kind": "question",
      "from": "packs/supply-lab/questions/supply.questions.json"
    },
    {
      "kind": "dashboard",
      "from": "packs/supply-lab/questions/supply.dashboard.json",
      "id": "supply.dashboard.supply_lab"
    }
  ]
}
