[
  {
    "artifactId": "billing.Billable.interface",
    "dependencies": [],
    "irVersion": "0.1",
    "kind": "entity",
    "lifecycle": "draft",
    "name": "Billable",
    "namespace": "billing",
    "payload": {
      "entityVersion": "2.0",
      "interface": {
        "description": "Anything with an exact amount in an ISO 4217 currency.",
        "name": "billing.Billable",
        "properties": [
          {
            "id": "amount",
            "type": {
              "kind": "decimal",
              "scale": 2
            }
          },
          {
            "id": "currency",
            "type": {
              "kind": "ref",
              "name": "iso4217.currency_code"
            }
          }
        ]
      }
    },
    "provenance": {
      "source": "authoring_sdk",
      "sourcePath": "tools/norn-ts/fixtures/schema/invoice.source.ts"
