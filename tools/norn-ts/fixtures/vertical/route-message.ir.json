    "name": "crm.route_message flow",
    "namespace": "crm",
    "payload": {
      "contract": "decide",
      "graph": {
        "contentType": "application/vnd.gorules.decision",
        "edges": [
          {
            "id": "e_in",
            "sourceId": "in",
            "targetId": "route",
            "type": "edge"
          },
          {
            "id": "e_out",
            "sourceId": "route",
            "targetId": "out",
            "type": "edge"
          }
        ],
        "nodes": [
          {
            "id": "in",
            "name": "run slice and event",
            "type": "inputNode"
          },
          {
            "content": {
              "hitPolicy": "first",
              "inputs": [
                {
                  "id": "c_when",
                  "name": "when",
                  "type": "expression"
                }
              ],
              "outputs": [
                {
                  "field": "facts",
                  "id": "o_facts",
                  "name": "facts"
                },
                {
                  "field": "commands",
                  "id": "o_commands",
                  "name": "commands"
                },
                {
                  "field": "timers",
                  "id": "o_timers",
                  "name": "timers"
                }
              ],
              "rules": [
                {
                  "_description": "started on start: perform norn.classify.whatsapp-intent → awaiting_retry_classify_attempt_1",
                  "_id": "started/start/1",
                  "c_when": "slice.run == null and event.kind == 'start'",
                  "o_commands": "[{kind: 'perform', runId: event.runId, step: 'classify', function: 'norn.classify.whatsapp-intent', functionVersion: '1', idempotencyKey: event.runId + ':classify', attempt: 1, input: {classify: {channel: 'whatsapp', locale: 'en', messageText: 'Hi, can I change my order to 3 boxes instead of 2?'}}}]",
                  "o_facts": "[{op: 'create', objectType: 'crm.RouteMessageRun', key: event.runId, values: {run_id: event.runId, status: 'started'}}, {op: 'transition', objectType: 'crm.RouteMessageRun', key: event.runId, lifecycle: 'status', transition: 'to_awaiting_retry_classify_attempt_1'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_retry_classify_attempt_1 on result: complete → completed",
                  "_id": "awaiting_retry_classify_attempt_1/result/1",
                  "c_when": "slice.run.status == 'awaiting_retry_classify_attempt_1' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'classify' and event.attempt == 1 and (event.results.classify.intent == 'order.modify')",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, property: 'slots', value: {result: {route: 'orders', intent: event.results.classify.intent}}}, {op: 'transition', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_retry_classify_attempt_1 on result: complete → completed",
                  "_id": "awaiting_retry_classify_attempt_1/result/2",
                  "c_when": "slice.run.status == 'awaiting_retry_classify_attempt_1' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'classify' and event.attempt == 1 and not (event.results.classify.intent == 'order.modify')",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, property: 'slots', value: {result: {route: 'inbox', intent: event.results.classify.intent}}}, {op: 'transition', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_retry_classify_attempt_1 on failure: retry classify after attempt 1 → retrying_classify_attempt_2",
                  "_id": "awaiting_retry_classify_attempt_1/failure/1",
                  "c_when": "slice.run.status == 'awaiting_retry_classify_attempt_1' and event.kind == 'failure' and event.runId == slice.run.run_id and event.step == 'classify' and event.attempt == 1 and event.failure._tag == 'UnsupportedLanguage'",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'transition', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_retrying_classify_attempt_2'}]",
                  "o_timers": "[{kind: 'timer', runId: slice.run.run_id, step: 'classify', attempt: 2, timerId: slice.run.run_id + ':classify:attempt:2', afterMillis: 2000}]"
                },
                {
                  "_description": "retrying_classify_attempt_2 on timer: perform norn.classify.whatsapp-intent again → awaiting_retry_classify_attempt_2",
                  "_id": "retrying_classify_attempt_2/timer/1",
                  "c_when": "slice.run.status == 'retrying_classify_attempt_2' and event.kind == 'timer' and event.runId == slice.run.run_id and event.step == 'classify' and event.attempt == 2 and event.timerId == slice.run.run_id + ':classify:attempt:2'",
                  "o_commands": "[{kind: 'perform', runId: slice.run.run_id, step: 'classify', function: 'norn.classify.whatsapp-intent', functionVersion: '1', idempotencyKey: slice.run.run_id + ':classify', attempt: 2, input: {classify: {channel: 'whatsapp', locale: 'en', messageText: 'Hi, can I change my order to 3 boxes instead of 2?'}}}]",
                  "o_facts": "[{op: 'transition', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_awaiting_retry_classify_attempt_2'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_retry_classify_attempt_2 on result: complete → completed",
                  "_id": "awaiting_retry_classify_attempt_2/result/1",
                  "c_when": "slice.run.status == 'awaiting_retry_classify_attempt_2' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'classify' and event.attempt == 2 and (event.results.classify.intent == 'order.modify')",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, property: 'slots', value: {result: {route: 'orders', intent: event.results.classify.intent}}}, {op: 'transition', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_retry_classify_attempt_2 on result: complete → completed",
                  "_id": "awaiting_retry_classify_attempt_2/result/2",
                  "c_when": "slice.run.status == 'awaiting_retry_classify_attempt_2' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'classify' and event.attempt == 2 and not (event.results.classify.intent == 'order.modify')",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, property: 'slots', value: {result: {route: 'inbox', intent: event.results.classify.intent}}}, {op: 'transition', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_retry_classify_attempt_2 on failure: complete → completed",
                  "_id": "awaiting_retry_classify_attempt_2/failure/1",
                  "c_when": "slice.run.status == 'awaiting_retry_classify_attempt_2' and event.kind == 'failure' and event.runId == slice.run.run_id and event.step == 'classify' and event.attempt == 2 and event.failure._tag == 'UnsupportedLanguage'",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, property: 'slots', value: {result: {route: 'human', intent: event.failure.locale}}}, {op: 'transition', objectType: 'crm.RouteMessageRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "any other event (duplicate, stale, or late): no change",
                  "_id": "otherwise",
                  "c_when": "",
                  "o_commands": "[]",
                  "o_facts": "[]",
                  "o_timers": "[]"
                }
              ]
            },
            "id": "route",
