          }
        },
        {
          "label": "retry timer fires",
          "deliverTimer": true,
          "expect": {
            "status": "awaiting_retry_classify_attempt_2",
            "commands": [
              {
                "step": "classify",
                "attempt": 2
              }
            ],
            "timers": 0
          }
        },
        {
          "label": "typed failure on the last attempt: catchTag hands over to a human",
          "event": {
            "kind": "failure",
            "runId": "run-unsupported",
            "step": "classify",
            "attempt": 2,
            "failure": {
              "_tag": "UnsupportedLanguage",
              "locale": "tl"
            }
          },
          "expect": {
