        "nodes": [
          {
            "id": "in",
            "name": "run slice and event",
            "type": "inputNode"
          },
          {
            "content": {
              "hitPolicy": "first",
              "inputs": [
                {
                  "id": "c_when",
                  "name": "when",
                  "type": "expression"
                }
              ],
              "outputs": [
                {
                  "field": "facts",
                  "id": "o_facts",
                  "name": "facts"
                },
                {
                  "field": "commands",
                  "id": "o_commands",
                  "name": "commands"
                },
                {
                  "field": "timers",
                  "id": "o_timers",
                  "name": "timers"
                }
              ],
              "rules": [
                {
                  "_description": "started on start: perform billing.charge_card → awaiting_perform_charge",
                  "_id": "started/start/1",
                  "c_when": "slice.run == null and event.kind == 'start'",
                  "o_commands": "[{kind: 'perform', runId: event.runId, step: 'charge', function: 'billing.charge_card', functionVersion: '1.0.0', idempotencyKey: event.runId + ':charge', attempt: 1, input: {charge: {invoiceId: 'inv-1'}}}]",
                  "o_facts": "[{op: 'create', objectType: 'billing.TypedFailureRun', key: event.runId, values: {run_id: event.runId, status: 'started'}}, {op: 'transition', objectType: 'billing.TypedFailureRun', key: event.runId, lifecycle: 'status', transition: 'to_awaiting_perform_charge'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_charge on result: complete → completed",
                  "_id": "awaiting_perform_charge/result/1",
                  "c_when": "slice.run.status == 'awaiting_perform_charge' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'charge' and event.attempt == 1",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'billing.TypedFailureRun', key: slice.run.run_id, property: 'slots', value: {result: {outcome: 'charged', detail: event.results.charge.receiptId}}}, {op: 'transition', objectType: 'billing.TypedFailureRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_charge on failure: perform billing.notify → awaiting_perform_tell",
                  "_id": "awaiting_perform_charge/failure/1",
                  "c_when": "slice.run.status == 'awaiting_perform_charge' and event.kind == 'failure' and event.runId == slice.run.run_id and event.step == 'charge' and event.attempt == 1 and event.failure._tag == 'PaymentDeclined'",
                  "o_commands": "[{kind: 'perform', runId: slice.run.run_id, step: 'tell', function: 'billing.notify', functionVersion: '1.0.0', idempotencyKey: slice.run.run_id + ':tell', attempt: 1, input: {tell: {invoiceId: 'inv-1', outcome: event.failure.reason}}}]",
                  "o_facts": "[{op: 'set', objectType: 'billing.TypedFailureRun', key: slice.run.run_id, property: 'slots', value: {bindings: {declined: event.failure}}}, {op: 'transition', objectType: 'billing.TypedFailureRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_awaiting_perform_tell'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_charge on failure: fail CardExpired → failed_card_expired",
                  "_id": "awaiting_perform_charge/failure/2",
                  "c_when": "slice.run.status == 'awaiting_perform_charge' and event.kind == 'failure' and event.runId == slice.run.run_id and event.step == 'charge' and event.attempt == 1 and event.failure._tag == 'CardExpired'",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'billing.TypedFailureRun', key: slice.run.run_id, property: 'slots', value: {failure: event.failure}}, {op: 'transition', objectType: 'billing.TypedFailureRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_failed_card_expired'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_tell on result: complete → completed",
                  "_id": "awaiting_perform_tell/result/1",
                  "c_when": "slice.run.status == 'awaiting_perform_tell' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'tell' and event.attempt == 1",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'billing.TypedFailureRun', key: slice.run.run_id, property: 'slots', value: {result: {outcome: 'declined', detail: slice.run.slots.bindings.declined.reason}}}, {op: 'transition', objectType: 'billing.TypedFailureRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "any other event (duplicate, stale, or late): no change",
                  "_id": "otherwise",
                  "c_when": "",
                  "o_commands": "[]",
                  "o_facts": "[]",
                  "o_timers": "[]"
                }
              ]
            },
            "id": "route",
            "name": "durable steps",
            "type": "decisionTableNode"
