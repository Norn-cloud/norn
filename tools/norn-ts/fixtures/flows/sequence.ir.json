    "payload": {
      "contract": "decide",
      "graph": {
        "contentType": "application/vnd.gorules.decision",
        "edges": [
          {
            "id": "e_in",
            "sourceId": "in",
            "targetId": "route",
            "type": "edge"
          },
          {
            "id": "e_out",
            "sourceId": "route",
            "targetId": "out",
            "type": "edge"
          }
        ],
        "nodes": [
          {
            "id": "in",
            "name": "run slice and event",
            "type": "inputNode"
          },
          {
            "content": {
              "hitPolicy": "first",
              "inputs": [
                {
                  "id": "c_when",
                  "name": "when",
                  "type": "expression"
                }
              ],
              "outputs": [
                {
                  "field": "facts",
                  "id": "o_facts",
                  "name": "facts"
                },
                {
                  "field": "commands",
                  "id": "o_commands",
                  "name": "commands"
                },
                {
                  "field": "timers",
                  "id": "o_timers",
                  "name": "timers"
                }
              ],
              "rules": [
                {
                  "_description": "started on start: perform billing.load_invoice → awaiting_perform_load",
                  "_id": "started/start/1",
                  "c_when": "slice.run == null and event.kind == 'start'",
                  "o_commands": "[{kind: 'perform', runId: event.runId, step: 'load', function: 'billing.load_invoice', functionVersion: '1.0.0', idempotencyKey: event.runId + ':load', attempt: 1, input: {load: {invoiceId: 'inv-1'}}}]",
                  "o_facts": "[{op: 'create', objectType: 'billing.SequenceRun', key: event.runId, values: {run_id: event.runId, status: 'started'}}, {op: 'transition', objectType: 'billing.SequenceRun', key: event.runId, lifecycle: 'status', transition: 'to_awaiting_perform_load'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_load on result: perform billing.charge_card → awaiting_perform_charge",
                  "_id": "awaiting_perform_load/result/1",
                  "c_when": "slice.run.status == 'awaiting_perform_load' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'load' and event.attempt == 1",
                  "o_commands": "[{kind: 'perform', runId: slice.run.run_id, step: 'charge', function: 'billing.charge_card', functionVersion: '1.0.0', idempotencyKey: slice.run.run_id + ':charge', attempt: 1, input: {charge: {invoiceId: event.results.load.id}}}]",
                  "o_facts": "[{op: 'set', objectType: 'billing.SequenceRun', key: slice.run.run_id, property: 'slots', value: {bindings: {invoice: event.results.load}}}, {op: 'transition', objectType: 'billing.SequenceRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_awaiting_perform_charge'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_charge on result: complete → completed",
                  "_id": "awaiting_perform_charge/result/1",
                  "c_when": "slice.run.status == 'awaiting_perform_charge' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'charge' and event.attempt == 1",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'billing.SequenceRun', key: slice.run.run_id, property: 'slots', value: {result: {invoice: slice.run.slots.bindings.invoice.id, receipt: event.results.charge.receiptId}}}, {op: 'transition', objectType: 'billing.SequenceRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_charge on failure: fail PaymentDeclined → failed_payment_declined",
                  "_id": "awaiting_perform_charge/failure/1",
                  "c_when": "slice.run.status == 'awaiting_perform_charge' and event.kind == 'failure' and event.runId == slice.run.run_id and event.step == 'charge' and event.attempt == 1 and event.failure._tag == 'PaymentDeclined'",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'billing.SequenceRun', key: slice.run.run_id, property: 'slots', value: {failure: event.failure}}, {op: 'transition', objectType: 'billing.SequenceRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_failed_payment_declined'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_charge on failure: fail CardExpired → failed_card_expired",
                  "_id": "awaiting_perform_charge/failure/2",
                  "c_when": "slice.run.status == 'awaiting_perform_charge' and event.kind == 'failure' and event.runId == slice.run.run_id and event.step == 'charge' and event.attempt == 1 and event.failure._tag == 'CardExpired'",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'billing.SequenceRun', key: slice.run.run_id, property: 'slots', value: {failure: event.failure}}, {op: 'transition', objectType: 'billing.SequenceRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_failed_card_expired'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "any other event (duplicate, stale, or late): no change",
                  "_id": "otherwise",
                  "c_when": "",
                  "o_commands": "[]",
                  "o_facts": "[]",
                  "o_timers": "[]"
                }
              ]
            },
            "id": "route",
            "name": "durable steps",
            "type": "decisionTableNode"
          },
          {
            "id": "out",
            "name": "decision",
            "type": "outputNode"
