              ],
              "rules": [
                {
                  "_description": "started on start: perform billing.load_invoice → awaiting_perform_load",
                  "_id": "started/start/1",
                  "c_when": "slice.run == null and event.kind == 'start'",
                  "o_commands": "[{kind: 'perform', runId: event.runId, step: 'load', function: 'billing.load_invoice', functionVersion: '1.0.0', idempotencyKey: event.runId + ':load', attempt: 1, input: {load: {invoiceId: 'inv-1'}}}]",
                  "o_facts": "[{op: 'create', objectType: 'billing.TerminalFactRun', key: event.runId, values: {run_id: event.runId, status: 'started'}}, {op: 'transition', objectType: 'billing.TerminalFactRun', key: event.runId, lifecycle: 'status', transition: 'to_awaiting_perform_load'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_load on result: complete → completed",
                  "_id": "awaiting_perform_load/result/1",
                  "c_when": "slice.run.status == 'awaiting_perform_load' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'load' and event.attempt == 1 and (event.results.load.status == 'draft')",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'billing.TerminalFactRun', key: slice.run.run_id, property: 'slots', value: {result: {outcome: 'void', invoice: event.results.load.id}}}, {op: 'transition', objectType: 'billing.TerminalFactRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "awaiting_perform_load on result: complete → completed",
                  "_id": "awaiting_perform_load/result/2",
                  "c_when": "slice.run.status == 'awaiting_perform_load' and event.kind == 'result' and event.runId == slice.run.run_id and event.step == 'load' and event.attempt == 1 and not (event.results.load.status == 'draft')",
                  "o_commands": "[]",
                  "o_facts": "[{op: 'set', objectType: 'billing.TerminalFactRun', key: slice.run.run_id, property: 'slots', value: {result: {outcome: 'issued', invoice: event.results.load.id}}}, {op: 'transition', objectType: 'billing.TerminalFactRun', key: slice.run.run_id, lifecycle: 'status', transition: 'to_completed'}]",
                  "o_timers": "[]"
                },
                {
                  "_description": "any other event (duplicate, stale, or late): no change",
                  "_id": "otherwise",
                  "c_when": "",
                  "o_commands": "[]",
                  "o_facts": "[]",
                  "o_timers": "[]"
                }
              ]
            },
