{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "norn.implementation-receipt.v1",
  "title": "Base-owned implementation-proof receipt",
  "description": "Written by scripts/ci/implementation_receipts.py from the trusted base checkout, one per implementation_proved claim and workflow run. The receipts runner compiles candidate code, so every receipt is candidate-reported; the verifier's verdict ($defs/verdict) says what it re-checked itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trust", "kind", "claim", "wrapper", "wrapperSha256", "repository", "headSha", "treeSha",
               "runId", "runAttempt", "job", "tools", "inputs", "invocations", "outputs", "exitCode"],
  "properties": {
    "schema": {"const": "norn.implementation-receipt.v1"},
    "trust": {"const": "candidate-reported"},
    "kind": {"enum": ["kani", "extraction"]},
    "claim": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$"},
    "wrapper": {"type": "string", "minLength": 1},
    "wrapperSha256": {"$ref": "#/$defs/sha256"},
    "repository": {"type": "string"},
    "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "treeSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runId": {"type": "string"},
    "runAttempt": {"type": "string"},
    "job": {"type": "string"},
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "version"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "version": {"type": "string", "minLength": 1}
        }
      }
    },
    "inputs": {"$ref": "#/$defs/digests"},
    "outputs": {"$ref": "#/$defs/digests"},
    "invocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "argv", "exitCode", "log", "logSha256"],
        "properties": {
          "tool": {"enum": ["kani", "cargo-hax", "fstar.exe"]},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exitCode": {"type": "integer"},
          "log": {"type": "string", "pattern": "^[0-9]+\\.log$"},
          "logSha256": {"$ref": "#/$defs/sha256"},
          "mutation": {"type": ["string", "null"]},
          "sourceSha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "exitCode": {"type": "integer"}
  },
  "$defs": {
    "verdict": {
      "description": "One verifier line per implementation_proved claim. No verdict admits a claim until an isolated producer exists (#969); label says what the verdict establishes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "kind", "verdict", "label", "rechecked", "candidateReported"],
      "properties": {
        "claim": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$"},
        "kind": {"enum": ["kani", "extraction"]},
        "verdict": {"enum": ["candidate-reported", "unchanged"]},
        "label": {"enum": ["candidate-reported Kani result",
                           "F* re-checked theorem about the uploaded model, correspondence candidate-reported",
                           "unchanged from the base, nothing re-checked on this run"]},
        "rechecked": {"type": "array", "items": {"enum": ["fstar-typecheck", "fstar-option-allowlist", "proof-hole-scan"]}},
        "candidateReported": {"type": "array", "items": {"enum": ["hax-extraction", "kani-baseline", "kani-mutations"]}}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
  }
}
